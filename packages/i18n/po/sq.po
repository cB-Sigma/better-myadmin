msgstr "Ka shumë pyetsorë të ngadaltë, në krahasim me sasinë e përgjithshme të Pyetsorëve."

msgid "You might want to increase {long_query_time} or optimize the queries listed in the slow query log"
msgstr "Mund të doni të rrisni {long_query_time} ose optimizoni pyetsorët e renditur në regjistrin (log) e pyetsorit të ngadalshëm"

msgid "The slow query rate should be below 5%%, your value is %s%%."
msgstr "Norma e pyetsorit të ngadalshëm duhet të jetë poshtë 5%%, vlera juaj është %s%%."

msgid "Slow query rate"
