msgid "MediaWiki Table"
msgstr "Tabela MediaWiki"

msgid "Import percentages as proper decimals <i>(ex. 12.00% to .12)</i>"
msgstr "Përqindjet e importit si numra dhjetorë të plotë <i>(psh. 12.00% në .12)</i>"

