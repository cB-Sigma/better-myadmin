msgstr "Διαγραφή γραμμής δεδομένων παρακολούθησης από την αναφορά"

msgid "No data"
msgstr "Δεν υπάρχουν δεδομένα"

msgid "Show %1$s with dates from %2$s to %3$s by user %4$s %5$s"
msgstr "Εμφάνιση %1$s με ημερομηνίες από %2$s έως %3$s από χρήστη %4$s %5$s"

msgid "SQL dump (file download)"
msgstr "Κάδος SQL (λήψη αρχείου)"

msgid "SQL dump"
msgstr "Κάδος SQL"

msgid "This option will replace your table and contained data."
msgstr "Αυτή η επιλογή θα αντικαταστήσει τον πίνακα και τα περιεχόμενά δεδομένα."

msgid "SQL execution"
msgstr "Εκτέλεση SQL"

msgid "Export as %s"
msgstr "Εξαγωγή ως %s"

msgid "Version %s snapshot (SQL code)"
msgstr "Στιγμιότυπο έκδοσης %s (κώδικας SQL)"

msgid "You can execute the dump by creating and using a temporary database. Please ensure that you have the privileges to do so."
msgstr "Μπορείτε να εκτελέσετε τον κάδο δημιουργώντας και χρησιμοποιώντας μι προσωρινή βάση δεδομένων. Σιγουρευτείτε ότι έχετε τα δικαιώματα για αυτό."

msgid "Comment out these two lines if you do not need them."
msgstr "Κάντε σχόλια αυτές τις δύο γραμμές αν δεν τις χρειάζεστε."

msgid "SQL statements exported. Please copy the dump or execute it."
msgstr "Οι δηλώσεις SQL εξήχθησαν. Αντιγράψτε τον κάδο ή εκτελέστε τον."

msgid "Tracking report for table `%s`"
msgstr "Αναφορά παρακολούθησης για τον πίνακα «%s»"

