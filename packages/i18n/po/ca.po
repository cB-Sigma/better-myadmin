msgstr "No s'ha pogut netejar la taula de preferències de la interfície d'usuari (vegeu $cfg['Servers'][$i]['MaxTableUiprefs'] %s)"

msgid "Cannot save UI property \"%s\". The changes made will not be persistent after you refresh this page. Please check if the table structure has been changed."
msgstr "No es pot desar la propietat d'interfície d'usuari \"%s\". Els canvis fets no seran persistents després que refresqueu aquesta pàgina. Comproveu si l'estructura de la taula ha estat canviada."

msgid "Error creating foreign key on %1$s (check data types)"
