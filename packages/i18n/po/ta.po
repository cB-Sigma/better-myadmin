msgstr "நகல் பிரதிபலிப்புப் பயனரைச் சேர்க்கவும்"

msgid "Use text field:"
msgstr "உரைபுலத்தின் மூலமாக:"

msgid "Host"
msgstr "விருந்தோம்பி"

msgid "Generate password:"
msgstr "கடவுச்சொல்லை உருவாக்கு:"

msgid "Generate"
msgstr "இயற்று"

