msgid "Allows connecting, even if maximum number of connections is reached; required for most administrative operations like setting global variables or killing threads of other users."
msgstr "Разрешает установку соединения, даже при достижении максимального количества соединений. (Требуется для большинства административных задач, таких как установка глобальных переменных или завершение процессов других пользователей)."

msgid "Allows viewing processes of all users."
msgstr "Разрешает просмотр процессов всех пользователей."

msgid "Allows reloading server settings and flushing the server's caches."
msgstr "Разрешает перезагрузку настроек сервера и очистку его кешей."

msgid "Allows shutting down the server."
msgstr "Разрешает остановку сервера."

msgid "Gives access to the complete list of databases."
msgstr "Разрешает доступ к полному списку баз данных."

msgid "Allows locking tables for the current thread."
msgstr "Разрешает блокировку таблиц для текущего потока."

msgid "Allows creating foreign key relations."
msgstr "Позволяет создавать реляции внешних ключей."

msgid "Not used on MariaDB."
msgstr "Не используется в MariaDB."

msgid "Not used for this MySQL version."
msgstr "Не используется для этой версии MySQL."

msgid "Allows the user to ask where the replicas / primaries are."
msgstr "Разрешает запрашивать местонахождение головного и подчиненных серверов."

msgid "Needed for the replication replicas."
msgstr "Необходимо для подчиненных серверов при репликации."

msgid "Allows creating, dropping and renaming user accounts."
msgstr "Разрешает создание, удаление и переименование учётных записей пользователей."

msgid "Resource limits"
msgstr "Ограничение на использование ресурсов"

msgid "Note: Setting these options to 0 (zero) removes the limit."
msgstr "Замечание: Установка значения параметров в 0 (ноль), снимает ограничения."

msgid "Limits the number of queries the user may send to the server per hour."
msgstr "Максимальное количество запросов, которые пользователь может отправить в течение часа."

msgid "Limits the number of commands that change any table or database the user may execute per hour."
msgstr "Максимальное количество команд изменяющих какую-либо таблицу или базу данных, которые пользователь может выполнить в течение часа."

msgid "Limits the number of new connections the user may open per hour."
msgstr "Максимальное количество новых подключений, которые пользователь может установить в течение часа."

msgid "Limits the number of simultaneous connections the user may have."
msgstr "Максимальное количество одновременных подключений одного пользователя."

msgid "Does not require SSL-encrypted connections."
msgstr "Не требует SSL-шифрованного соединения."

msgid "Requires SSL-encrypted connections."
msgstr "Требует SSL-шифрованного соединения."

msgid "Requires a valid X509 certificate."
msgstr "Требуется действительный сертификат X509."

msgid "Requires that a specific cipher method be used for a connection."
msgstr "Требуется, чтобы для соединения использовался специальный метод шифрования."

msgid "Requires that a valid X509 certificate issued by this CA be presented."
msgstr "Требуется, чтобы был представлен действительный сертификат X509, выданный этим ЦС."

msgid "Requires that a valid X509 certificate with this subject be presented."
msgstr "Требуется наличие действительного сертификата X509 с этим предметом."

msgid "Update user privileges"
msgstr "Настроить привилегии пользователя"

msgid "User accounts overview"
msgstr "Обзор учётных записей пользователей"

msgid "User groups"
