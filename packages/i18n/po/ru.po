msgid "Without PHP code"
msgstr "Без кода PHP"

msgctxt "Inline edit query"
msgid "Edit inline"
msgstr "Построчная правка"

msgid "Static analysis:"
msgstr "Статический анализ:"

msgid "%d errors were found during analysis."
msgstr "Найдено %d ошибок при анализе."

