msgstr "Необходимо обновить %s до версии %s или выше."

msgid "See %sour documentation%s for more information."
msgstr "Смотрите %sour documentation%s для дополнительной информации."

msgid "GLOBALS overwrite attempt"
msgstr "попытка перезаписи GLOBALS"

msgid "possible exploit"
msgstr "возможная уязвимость"

msgid "The ini_get and/or ini_set functions are disabled in php.ini. phpMyAdmin requires these functions!"
msgstr "Функции ini_get и/или ini_set отключены в php.ini. В phpMyAdmin требуются эти функции!"

msgid "Error: Token mismatch"
msgstr "Ошибка: несоответствие токена"

msgid "Failed to set session cookie. Maybe you are using HTTP instead of HTTPS to access phpMyAdmin."
msgstr "Не удалось установить сессионные куки. Возможно вы подключаетесь через HTTP вместо HTTPS."

msgid "Ignoring unsupported language code."
msgstr "Игнорировать неподдерживаемые коды языков."

msgid "The database name must be a non-empty string."
msgstr "Не указано имя базы данных."

msgid "The database name cannot be longer than %d characters."
msgstr "Имя базы данных не может быть длиннее %d символов."

msgid "The database name cannot end with a space character."
msgstr "Имя базы данных не может заканчиваться символом пробела."

msgid "The table name must be a non-empty string."
msgstr "Имя таблицы должно быть непустой строкой."

msgid "The table name cannot be longer than %d characters."
msgstr "Имя таблицы не может быть длиннее %d символов."

msgid "The table name cannot end with a space character."
msgstr "Имя таблицы не может заканчиваться символом пробела."

msgid "The trigger name must not be empty."
msgstr "Имя триггера не должно быть пустым."

msgid "The trigger name cannot be longer than %d characters."
msgstr "Длина имени триггера не может превышать %d символов."

msgid "The trigger name cannot end with a space character."
msgstr "Имя триггера не может заканчиваться символом пробела."

msgid "Only INSERT, UPDATE, DELETE, REPLACE and SET (without options like GLOBAL) SQL queries containing transactional engine tables can be rolled back."
msgstr "Только для запросов INSERT, UPDATE, DELETE, REPLACE и SET (без параметров вроде GLOBAL) , содержащих транзакционные таблицы движка, может быть произведён откат."

msgid "Go to table: %s"
msgstr "Перейти к таблице: %s"

