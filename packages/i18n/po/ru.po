msgstr "Невозможно переименовать индекс в PRIMARY!"

msgid "No index parts defined!"
msgstr "Части индекса не определены!"

msgid "Problems with indexes of table `%s`"
msgstr "Проблемы с индексами таблицы `%s`"

msgid "Source database `%s` was not found!"
msgstr "База данных `%s`, являющаяся источником, не найдена!"

msgid "Target database `%s` was not found!"
msgstr "База данных `%s`, являющаяся целевой, не найдена!"

msgid "Invalid database:"
msgstr "Некорректная база данных:"

msgid "Invalid table name:"
msgstr "Некорректное имя таблицы:"

msgid "Table %1$s has been renamed to %2$s."
msgstr "Таблица %1$s была переименована в %2$s."

msgid "Could not save table UI preferences!"
msgstr "Не удалось сохранить настройки пользовательского интерфейса!"

msgid "Failed to cleanup table UI preferences (see $cfg['Servers'][$i]['MaxTableUiprefs'] %s)"
msgstr "Ошибка при очистке таблицы содержащей настройки пользовательского интерфейса (смотрите переменную $cfg['Servers'][$i]['MaxTableUiprefs'] %s)"

msgid "Cannot save UI property \"%s\". The changes made will not be persistent after you refresh this page. Please check if the table structure has been changed."
msgstr "Невозможно сохранить свойства пользовательского интерфейса \"%s\". После перезагрузки страницы, изменения интерфейса будут отменены. Пожалуйста, проверьте изменена ли структура таблицы."

msgid "Error creating foreign key on %1$s (check data types)"
msgstr "Ошибка создания внешнего ключа на %1$s (проверьте типы данных)"

msgid "Default theme %s not found!"
msgstr "Тема по-умолчанию %s не найдена!"

msgid "Theme %s not found!"
msgstr "Тема %s не найдена!"

msgid "No valid image path for theme %s found!"
msgstr "Не найден правильный путь к изображениям для темы %s!"

msgid "Tracking data definition successfully deleted"
msgstr "Данные слежения успешно удалены"

msgid "Tracking data manipulation successfully deleted"
msgstr "Данные слежения успешно удалены"

msgid "Data definition statement"
msgstr "Выражение определяющее структуру"

msgid "Data manipulation statement"
msgstr "Выражение изменяющее данные"

msgid "Tracking statements"
msgstr "Отслеживаемые выражения"

msgid "Delete tracking data row from report"
msgstr "Удалить строку данных слежения за таблицей"

msgid "No data"
msgstr "Нет данных"

msgid "Show %1$s with dates from %2$s to %3$s by user %4$s %5$s"
msgstr "Вывести %1$s с датой от %2$s до %3$s пользователя %4$s %5$s"

msgid "SQL dump (file download)"
msgstr "Выгрузка SQL (файл)"

msgid "SQL dump"
msgstr "Выгрузка SQL"

msgid "This option will replace your table and contained data."
msgstr "Данный параметр заместит таблицу и содержащиеся в ней данные."

msgid "SQL execution"
msgstr "Выполнение SQL запроса"

msgid "Export as %s"
msgstr "Экспортировать как %s"

msgid "Version %s snapshot (SQL code)"
msgstr "Обзор версии %s (SQL код)"

msgid "You can execute the dump by creating and using a temporary database. Please ensure that you have the privileges to do so."
msgstr "Вы можете выполнить выгруженные запросы создав и использовав для этого временную базу данных. Убедитесь, что у вас есть для этого достаточные привилегии."

msgid "Comment out these two lines if you do not need them."
msgstr "Закомментируйте эти две строки, если они вам не нужны."

msgid "SQL statements exported. Please copy the dump or execute it."
msgstr "SQL выражения успешно выгружены; скопируйте, либо выполните их."

msgid "Tracking report for table `%s`"
msgstr "Отчёт слежения для таблицы `%s`"

msgid "Tracking for %1$s was activated at version %2$s."
msgstr "Слежение за %1$s было включено на версии %2$s."

msgid "Tracking for %1$s was deactivated at version %2$s."
msgstr "Слежение за %1$s было отключено на версии %2$s."

msgid "Version %1$s of %2$s was deleted."
msgstr "Версия %1$s из %2$s удалена."

msgid "Version %1$s was created, tracking for %2$s is active."
msgstr "Версия %1$s создана, отслеживание %2$s включено."

msgid "Sorry, we failed to restore the dropped trigger."
msgstr "Невозможно восстановить удаленный триггер."

msgid "Trigger %1$s has been modified."
msgstr "Триггер %1$s был изменен."

msgid "Trigger %1$s has been created."
msgstr "Триггер %1$s был создан."

msgid "You must provide a trigger name!"
msgstr "Необходимо задать имя триггера!"

msgid "You must provide a valid timing for the trigger!"
msgstr "Необходимо задать корректное время выполнения триггера!"

msgid "You must provide a valid event for the trigger!"
msgstr "Необходимо задать корректное событие для триггера!"

msgid "You must provide a valid table name!"
msgstr "Необходимо задать корректное имя таблицы!"

msgid "You must provide a trigger definition."
msgstr "Вы должны задать определение триггера."

msgid "empty"
msgstr "пусто"

msgid "not empty"
msgstr "не пусто"

msgid "A 1-byte integer, signed range is -128 to 127, unsigned range is 0 to 255"
msgstr "Одно-байтовое целое число, диапазон чисел со знаком от -128 до 127, диапазон чисел без знака от 0 до 255"

msgid "A 2-byte integer, signed range is -32,768 to 32,767, unsigned range is 0 to 65,535"
msgstr "Двух-байтовое целое число, диапазон чисел со знаком от -32,768 до 32,767, диапазон чисел без знака от 0 до 65,535"

msgid "A 3-byte integer, signed range is -8,388,608 to 8,388,607, unsigned range is 0 to 16,777,215"
msgstr "Трех-байтовое целое число, диапазон чисел со знаком от -8,388,608 до 8,388,607, диапазон чисел без знака от 0 до 16,777,215"

msgid "A 4-byte integer, signed range is -2,147,483,648 to 2,147,483,647, unsigned range is 0 to 4,294,967,295"
msgstr "Четырех-байтовое целое число, диапазон чисел со знаком от -2,147,483,648 до 2,147,483,647, диапазон чисел без знака от 0 до 4,294,967,295"

msgid "An 8-byte integer, signed range is -9,223,372,036,854,775,808 to 9,223,372,036,854,775,807, unsigned range is 0 to 18,446,744,073,709,551,615"
msgstr "Восьми-байтовое целое число, диапазон чисел со знаком от -9,223,372,036,854,775,808 до 9,223,372,036,854,775,807, диапазон чисел без знака от 0 до 18,446,744,073,709,551,615"

msgid "A fixed-point number (M, D) - the maximum number of digits (M) is 65 (default 10), the maximum number of decimals (D) is 30 (default 0)"
msgstr "Число с фиксированной точкой (M, D) - максимальное количество цифр (M) не должно превышать 65 (по умолчанию 10), максимальное количество десятичных знаков после запятой (D) не должно превышать 30 (по умолчанию 0)"

msgid "A small floating-point number, allowable values are -3.402823466E+38 to -1.175494351E-38, 0, and 1.175494351E-38 to 3.402823466E+38"
msgstr "Малое число с плавающей точкой, допустимые значения от -3.402823466E+38 до -1.175494351E-38, 0, и от 1.175494351E-38 до 3.402823466E+38"

msgid "A double-precision floating-point number, allowable values are -1.7976931348623157E+308 to -2.2250738585072014E-308, 0, and 2.2250738585072014E-308 to 1.7976931348623157E+308"
msgstr "Число с плавающей точкой удвоенной точности, допустимые значения от -1.7976931348623157E+308 до -2.2250738585072014E-308, 0, и от 2.2250738585072014E-308 до 1.7976931348623157E+308"

msgid "Synonym for DOUBLE (exception: in REAL_AS_FLOAT SQL mode it is a synonym for FLOAT)"
msgstr "Синоним для DOUBLE (исключение: в режиме REAL_AS_FLOAT SQL будет синоним для FLOAT)"

msgid "A bit-field type (M), storing M of bits per value (default is 1, maximum is 64)"
msgstr "Тип поля-бит (M), сохранит M бит для значения (по умолчанию 1, максимум 64)"

msgid "A synonym for TINYINT(1), a value of zero is considered false, nonzero values are considered true"
msgstr "Синоним для TINYINT(1), значение нуля предполагает false, ненулевые значения предполагают true"

msgid "An alias for BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE"
msgstr "Псевдоним для BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE"

msgid "A date, supported range is %1$s to %2$s"
msgstr "Дата, поддерживаемый диапазон от %1$s до %2$s"

msgid "A date and time combination, supported range is %1$s to %2$s"
msgstr "Совмещение даты и времени, поддерживаемый диапазон от \"%1$s\" до \"%2$s\""

msgid "A timestamp, range is 1970-01-01 00:00:01 UTC to 2038-01-19 03:14:07 UTC on 32-bit platforms (MariaDB 11.3 and earlier), and up to 2106-02-07 06:28:15 UTC on 64-bit platforms (MariaDB 11.5 and later), stored as the number of seconds since the epoch (1970-01-01 00:00:00 UTC)"
msgstr "Временная метка, диапазон от 1970-01-01 00:00:01 UTC до 2038-01-19 03:14:07 UTC на 32-битных платформах (MariaDB 11.3 и ранее), и до 2106-02-07 06:28:15 UTC на 64-битных платформах (MariaDB 11.5 и поздние версии), содержит количество секунд с начала эпохи (1970-01-01 00:00:00 UTC)"

msgid "A time, range is %1$s to %2$s"
msgstr "Время, диапазон от %1$s до %2$s"

msgid "A year in four-digit (4, default) or two-digit (2) format, the allowable values are 70 (1970) to 69 (2069) or 1901 to 2155 and 0000"
msgstr "Год в четырехзначном (4, по умолчанию) или двухзначном (2) формате, допустимые значения от 70 (1970) до 69 (2069) или от 1901 до 2155 и 0000"

msgid "A fixed-length (0-255, default 1) string that is always right-padded with spaces to the specified length when stored"
msgstr "Строка фиксированной длины (0-255, по-умолчанию 1), при хранении всегда дополняется пробелами в конце строки до заданной длины"

msgid "A variable-length (%s) string, the effective maximum length is subject to the maximum row size"
msgstr "Строка переменной длины (%s), эффективная максимальная длина зависит от максимального размера строки"

msgid "A TEXT column with a maximum length of 255 (2^8 - 1) characters, stored with a one-byte prefix indicating the length of the value in bytes"
msgstr "Столбец типа TEXT с максимальной длиной 255 (2^8 - 1) символов, сохраняется с одно-байтовым префиксом, указывающим длину значения в байтах"

msgid "A TEXT column with a maximum length of 65,535 (2^16 - 1) characters, stored with a two-byte prefix indicating the length of the value in bytes"
msgstr "Столбец типа TEXT с максимальной длиной 65,535 (2^16 - 1) символов, сохраняется с двух-байтовым префиксом, указывающим длину значения в байтах"

msgid "A TEXT column with a maximum length of 16,777,215 (2^24 - 1) characters, stored with a three-byte prefix indicating the length of the value in bytes"
msgstr "Столбец типа TEXT с максимальной длиной 16,777,215 (2^24 - 1) символов, сохраняется с трех-байтовым префиксом, указывающим длину значения в байтах"

msgid "A TEXT column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) characters, stored with a four-byte prefix indicating the length of the value in bytes"
msgstr "Столбец типа TEXT с максимальной длиной 4,294,967,295 или 4ГиБ (2^32 - 1) символов, сохраняется с четырех-байтовым префиксом, указывающим длину значения в байтах"

msgid "Similar to the CHAR type, but stores binary byte strings rather than non-binary character strings"
msgstr "Аналогичен типу CHAR, но предназначен для хранения бинарных байт-строк, вместо не бинарных символьных строк"

msgid "Similar to the VARCHAR type, but stores binary byte strings rather than non-binary character strings"
msgstr "Аналогичен типу VARCHAR, но предназначен для хранения бинарных байт-строк, вместо не бинарных символьных строк"

msgid "A BLOB column with a maximum length of 255 (2^8 - 1) bytes, stored with a one-byte prefix indicating the length of the value"
msgstr "Столбец типа BLOB с максимальной длиной 255 (2^8 - 1) байт, сохраняется с одно-байтовым префиксом, указывающим длину значения"

msgid "A BLOB column with a maximum length of 16,777,215 (2^24 - 1) bytes, stored with a three-byte prefix indicating the length of the value"
msgstr "Столбец типа BLOB с максимальной длиной 16,777,215 (2^24 - 1) байт, сохраняется с трех-байтовым префиксом, указывающим длину значения"

msgid "A BLOB column with a maximum length of 65,535 (2^16 - 1) bytes, stored with a two-byte prefix indicating the length of the value"
msgstr "Столбец типа BLOB с максимальной длиной 65,535 (2^16 - 1) байт, сохраняется с двух-байтовым префиксом, указывающим длину значения"

msgid "A BLOB column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) bytes, stored with a four-byte prefix indicating the length of the value"
msgstr "Столбец типа BLOB с максимальной длиной 4,294,967,295 или 4ГиБ (2^32 - 1) байт, сохраняется с четырех-байтовым префиксом, указывающим длину значения"

msgid "An enumeration, chosen from the list of up to 65,535 values or the special '' error value"
msgstr "Перечисляемый тип данных, который может содержать максимум 65,535 различных величин или специальную величину ошибки ''"

msgid "A single value chosen from a set of up to 64 members"
msgstr "Единственное значение выбираемое из набора не более 64 членов"

msgid "A type that can store a geometry of any type"
msgstr "Тип для хранения любого вида геометрических данных"

msgid "A point in 2-dimensional space"
msgstr "Точка в двухмерном пространстве"

msgid "A curve with linear interpolation between points"
msgstr "Кривая с линейной интерполяцией между точек"

msgid "A polygon"
msgstr "Многоугольник"

msgid "A collection of points"
msgstr "Набор точек"

msgid "A collection of curves with linear interpolation between points"
msgstr "Набор кривых с линейной интерполяцией между точками"

msgid "A collection of polygons"
msgstr "Набор многоугольников"

msgid "A collection of geometry objects of any type"
msgstr "Набор геометрических объектов любого типа"

msgid "Stores and enables efficient access to data in JSON (JavaScript Object Notation) documents"
msgstr "Тип данных для эффективного хранения и использования данных в JSON (JavaScript Object Notation)"

msgid "Intended for storage of IPv4 addresses"
msgstr "Предназначен для хранения адресов IPv4"

msgid "Intended for storage of IPv6 addresses, as well as IPv4 addresses assuming conventional mapping of IPv4 addresses into IPv6 addresses"
msgstr "Предназначен для хранения адресов IPv6, а также адресов IPv4, предполагающих обычное отображение адресов IPv4 в адреса IPv6"

msgid "128-bit UUID (Universally Unique Identifier)"
msgstr "128-битный UUID (универсальный уникальный идентификатор)"

msgid "Stores vector data optimized for operations such as similarity search and machine learning applications"
msgstr "Хранит векторные данные, оптимизированные для таких операций, как поиск по схожести и приложения машинного обучения"

msgid "Intended for storage of XML data"
msgstr "Предназначено для хранения данных XML"

