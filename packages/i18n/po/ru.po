msgstr "password_hash() PHP-функции с настройками по умолчанию."

msgid "password_hash() PHP function"
msgstr "password_hash() PHP-функции"

msgid "Skip Explain SQL"
msgstr "Убрать анализ SQL"

msgid "Skip Analyze SQL"
