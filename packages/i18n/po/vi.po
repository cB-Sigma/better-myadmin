msgstr "Đã xóa thành công phần thao tác dữ liệu theo dõi"

msgid "Data definition statement"
msgstr "Chỉ lệnh định nghĩa dữ liệu"

msgid "Data manipulation statement"
msgstr "Chỉ lệnh thao tác dữ liệu"

msgid "Tracking statements"
msgstr "Theo dõi trạng thái"

msgid "Delete tracking data row from report"
msgstr "Xóa dòng dữ liệu theo dõi từ báo cáo"

msgid "No data"
msgstr "Không có dữ liệu"

msgid "Show %1$s with dates from %2$s to %3$s by user %4$s %5$s"
msgstr "Hiển thị %1$s với ngày tháng từ %2$s đến %3$s theo người dùng %4$s %5$s"

msgid "SQL dump (file download)"
msgstr "Đổ SQL (tải về tập tin)"

msgid "SQL dump"
msgstr "Đổ SQL"

msgid "This option will replace your table and contained data."
msgstr "Tùy chọn này sẽ thay thế bảng và dữ liệu đã chứa."

msgid "SQL execution"
msgstr "Thực thi SQL"

msgid "Export as %s"
msgstr "Xuất ra thành %s"

msgid "Version %s snapshot (SQL code)"
msgstr "Phiên bản chụp %s (mã SQL)"

msgid "You can execute the dump by creating and using a temporary database. Please ensure that you have the privileges to do so."
msgstr "Bạn có thể thực thi đổ bằng cách tạo và dùng một cơ sở dữ liệu tạm. Vui lòng chắc chắn rằng bạn có đủ thẩm quyền để làm điều đó."

msgid "Comment out these two lines if you do not need them."
msgstr "Sửa hai dòng này thành ghi chú nếu bạn không cần chúng."

msgid "SQL statements exported. Please copy the dump or execute it."
msgstr "Câu lệnh SQL đã được xuất ra. Vui lòng chép phần đổ hoặc thực thi nó."

msgid "Tracking report for table `%s`"
msgstr "Báo cáo theo dõi cho bảng “%s“"

msgid "Tracking for %1$s was activated at version %2$s."
msgstr "Theo dõi cho %1$s được kích hoạt tại phiên bản %2$s."

msgid "Tracking for %1$s was deactivated at version %2$s."
msgstr "Theo dõi cho %1$s bị dừng hoạt động tại phiên bản %2$s."

msgid "Version %1$s of %2$s was deleted."
msgstr "Phiên bản %1$s trên %2$s đã được tạo."

msgid "Version %1$s was created, tracking for %2$s is active."
msgstr "Phiên bản %1$s đã được tạo, việc theo dõi %2$s đang hoạt động."

msgid "Sorry, we failed to restore the dropped trigger."
msgstr "Rất tiếc, chúng tôi gặp lỗi khi phục hồi lại bẫy đã xóa."

msgid "Trigger %1$s has been modified."
msgstr "Bẫy %1$s đã bị sửa đổi."

msgid "Trigger %1$s has been created."
msgstr "Bẫy %1$s đã được tạo ra."

msgid "You must provide a trigger name!"
msgstr "Phải ghi rõ tên bẫy!"

msgid "You must provide a valid timing for the trigger!"
msgstr "Phải ghi rõ thời điểm hợp lệ cho bẫy!"

msgid "You must provide a valid event for the trigger!"
msgstr "Phải ghi rõ sự kiện hợp lệ cho bẫy!"

msgid "You must provide a valid table name!"
msgstr "Phải ghi rõ tên bảng hợp lệ!"

msgid "You must provide a trigger definition."
msgstr "Phải cung cấp định nghĩa bẫy."

msgid "not empty"
msgstr "không trống"

msgid "A 1-byte integer, signed range is -128 to 127, unsigned range is 0 to 255"
msgstr "Một số nguyên 1 byte, phạm vi có dấu là từ -128 đến 127, phạm vi không dấu là từ 0 đến 255"

msgid "A 2-byte integer, signed range is -32,768 to 32,767, unsigned range is 0 to 65,535"
msgstr "Số nguyên 2 byte, phạm vi có dấu là -32,768 đến 32,767, phạm vi không dấu là 0 đến 65,535"

msgid "A 3-byte integer, signed range is -8,388,608 to 8,388,607, unsigned range is 0 to 16,777,215"
msgstr "Số nguyên 3 byte, phạm vi có dấu là -8,388,608 đến 8,388,607, phạm vi không dấu là 0 đến 16,777,215"

msgid "A 4-byte integer, signed range is -2,147,483,648 to 2,147,483,647, unsigned range is 0 to 4,294,967,295"
msgstr "Một số nguyên 4 byte, phạm vi có dấu là -2,147,483,648 đến 2,147,483,647, phạm vi không có dấu là 0 đến 4,294,967,295"

msgid "Synonym for DOUBLE (exception: in REAL_AS_FLOAT SQL mode it is a synonym for FLOAT)"
msgstr "Từ đồng nghĩa với DOUBLE (ngoại trừ: trong chế độ SQL REAL_AS_FLOAT, nó là từ đồng nghĩa với FLOAT)"

msgid "An alias for BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE"
msgstr "Bí danh cho BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE"

msgid "A date, supported range is %1$s to %2$s"
msgstr "Kiểu ngày, vùng được hỗ trợ là từ %1$s đến %2$s"

msgid "A date and time combination, supported range is %1$s to %2$s"
msgstr "Một sự kết hợp ngày và giờ, phạm vi hỗ trợ là %1$s đến %2$s"

msgid "A time, range is %1$s to %2$s"
msgstr "Giờ giấc, vùng là từ %1$s đến %2$s"

msgid "A year in four-digit (4, default) or two-digit (2) format, the allowable values are 70 (1970) to 69 (2069) or 1901 to 2155 and 0000"
msgstr "Một năm với định dạng 4 chữ số (4, mặc định) hoặc 2 chữ số (2), giá trị cho phép là 70 (1970) đến 69 (2069) hoặc 1901 đến 2555 và 0000"

msgid "A fixed-length (0-255, default 1) string that is always right-padded with spaces to the specified length when stored"
msgstr "Một chuỗi có độ dài cố định (0-255, mặc định là 1) luôn được thêm khoảng trắng vào bên phải để đạt độ dài đã chỉ định khi được lưu trữ."

msgid "A variable-length (%s) string, the effective maximum length is subject to the maximum row size"
msgstr "Chuỗi có độ dài thay đổi (%s), độ dài tối đa hiệu quả phụ thuộc vào kích thước hàng tối đa."

msgid "Similar to the CHAR type, but stores binary byte strings rather than non-binary character strings"
msgstr "Tương tự như loại CHAR, nhưng lưu trữ chuỗi byte nhị phân hơn là chuỗi ký tự không nhị phân"

msgid "Similar to the VARCHAR type, but stores binary byte strings rather than non-binary character strings"
msgstr "Tương tự như loại VARCHAR, nhưng lưu chuỗi byte nhị phân chứ không phải chuỗi ký tự không nhị phân"

msgid "An enumeration, chosen from the list of up to 65,535 values or the special '' error value"
msgstr "Một bảng liệt kê, được chọn từ danh sách lên tới 65,535 giá trị hoặc giá trị lỗi '' đặc biệt"

msgid "A single value chosen from a set of up to 64 members"
msgstr "Một giá trị duy nhất được chọn từ một bộ lên tới 64 thành viên"

msgid "A type that can store a geometry of any type"
msgstr "Một loại có thể lưu trữ một hình học thuộc bất kỳ loại nào"

msgid "A point in 2-dimensional space"
msgstr "Một điểm trong không gian 2 chiều"

msgid "A curve with linear interpolation between points"
msgstr "Một đường cong với phép nội suy tuyến tính giữa các điểm"

msgid "A polygon"
msgstr "Một đa giác"

msgid "A collection of points"
msgstr "Một tập hợp tọa độ"

msgid "A collection of curves with linear interpolation between points"
msgstr "Một tập hợp các đường cong với phép nội suy tuyến tính giữa các điểm"

msgid "A collection of polygons"
msgstr "Một tập hợp của đa giác"

msgid "A collection of geometry objects of any type"
msgstr "Một tập hợp của các đối tượng hình dạng của bất kỳ kiểu nào"

msgid "Stores and enables efficient access to data in JSON (JavaScript Object Notation) documents"
msgstr "Lưu trữ và bật truy cập hiệu quả đến dữ liệu trong tài liệu JSON (JavaScript Object Notation)"

msgid "Intended for storage of IPv6 addresses, as well as IPv4 addresses assuming conventional mapping of IPv4 addresses into IPv6 addresses"
msgstr "Dự định lưu trữ địa chỉ IPv6, cũng như địa chỉ IPv4 giả sử ánh xạ thông thường của địa chỉ IPv4 vào địa chỉ IPv6"

msgid "128-bit UUID (Universally Unique Identifier)"
msgstr "128-bit UUID (Định danh duy nhất toàn cầu)"

