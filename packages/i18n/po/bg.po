msgid "A 1-byte integer, signed range is -128 to 127, unsigned range is 0 to 255"
msgstr "1-байт цяло число, подписано обхват е -128 до 127, неподписан обхват е от 0 до 255"

msgid "A 2-byte integer, signed range is -32,768 to 32,767, unsigned range is 0 to 65,535"
msgstr "2-байт цяло число, подписано обхват е -32,768 до 32,767, неподписан обхват от 0 до 65,535"

msgid "A 3-byte integer, signed range is -8,388,608 to 8,388,607, unsigned range is 0 to 16,777,215"
msgstr "3-байт цяло число, подписано обхват е -8,388,608 до 8,388,607, неподписан обхват е от 0 до 16,777,215"

msgid "A 4-byte integer, signed range is -2,147,483,648 to 2,147,483,647, unsigned range is 0 to 4,294,967,295"
msgstr "Едно цяло число от 4 байта, подписано в обхвата, е -2,147,483,648 до 2,147,483,647, неподписан обхват е от 0 до 4,294,967,295"

msgid "A date, supported range is %1$s to %2$s"
msgstr "Дата, поддържан диапазон е %1$s до %2$s"

msgid "A date and time combination, supported range is %1$s to %2$s"
msgstr "Комбинация от дата и час, поддържаният диапазон е %1$s до %2$s"

msgid "A time, range is %1$s to %2$s"
msgstr "Време, диапазонът е %1$s до %2$s"

msgid "An enumeration, chosen from the list of up to 65,535 values or the special '' error value"
msgstr "Изброяване, избор от списък с до 65535 стойности или специалната стойност за грешка ''"

msgid "A single value chosen from a set of up to 64 members"
msgstr "Единична стойност, избрана от списък с до 64 възможни"

msgid "A type that can store a geometry of any type"
msgstr "Тип, който може да съхранява геометрия от всякакъв вид"

msgid "A point in 2-dimensional space"
msgstr "Точка в 2-мерното пространство"

msgid "A curve with linear interpolation between points"
msgstr "Крива с линейна интерполация между точки"

msgid "A polygon"
msgstr "Многоъгълник"

msgid "A collection of points"
msgstr "Набор от точки"

msgid "A collection of curves with linear interpolation between points"
msgstr "Колекция от криви с линейна интерполация между точки"

msgid "A collection of polygons"
msgstr "Набор от многоъгълници"

msgid "A collection of geometry objects of any type"
msgstr "Набор от геометрични обекти от всякакъв вид"

