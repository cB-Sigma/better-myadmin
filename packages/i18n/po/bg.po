msgid "Minor Version"
msgstr "Малка версия"

msgid "You should upgrade, to a stable version of MySQL 5.5."
msgstr "Трябва да обновите до стабилна версия на MySQL 5.5."

msgid "Distribution"
msgstr "Разпространение"

msgid "MySQL Architecture"
msgstr "Архитектура на MySQL"

msgid "Available memory on this host: %s"
msgstr "Достъпна памет на този хост: %s"

msgid "Query caching method"
msgstr "Метод за буфериране на заявки"

msgid "Suboptimal caching method."
msgstr "Неоптимален метод за буфериране."

msgid "Percentage of sorts that cause temporary tables"
msgstr "Процент сортировки, използващи временни таблици"

msgid "Too many sorts are causing temporary tables."
msgstr "Твърде много сортировки, изискващи временни таблици."

msgid "%s%% of all sorts cause temporary tables, this value should be lower than 10%%."
msgstr "%s%% от всички сортировки се изпълняват с временни таблици, тази стойност трябва да бъде под 10%%."

msgid "Rate of sorts that cause temporary tables"
msgstr "Стойност на сортировките, изискващи временни таблици"

msgid "Temporary tables average: %s, this value should be less than 1 per hour."
msgstr "Средната стойност на временни таблици е %s, тази стойност трябва да бъде под 1 за час."

msgid "Sort rows"
msgstr "Сортиране на редове"

msgid "Rate of joins without indexes"
msgstr "Стойност на JOIN без индекси"

msgid "There are too many joins without indexes."
msgstr "Има твърде много JOIN без индекси."

msgid "Table joins average: %s, this value should be less than 1 per hour"
msgstr "Средната стойност за JOIN на таблици e %s, тази стойност трябва да бъде под 1 за час"

msgid "Rate of reading first index entry"
msgstr "Стойност на прочитане на първия индекс"

msgid "The rate of reading the first index entry is high."
msgstr "Стойността на прочитане на първия индекс е висока."

msgid "Index scans average: %s, this value should be less than 1 per hour"
msgstr "Стойността на отказаните клиенти е %s, тази стойност трябва да бъде под 1 за час"

msgid "Rate of reading fixed position"
msgstr "Стойност на прочитане на фиксирана позиция"

msgid "The rate of reading data from a fixed position is high."
msgstr "Стойността на прочитане на фиксирана позиция е висока."

msgid "Rate of reading fixed position average: %s, this value should be less than 1 per hour"
msgstr "Стойността на прекъснатите клиенти е %s, тази стойност трябва да бъде под 1 за час"

msgid "Rate of reading next table row"
msgstr "Стойност на четене на следващ ред от таблица"

msgid "The rate of reading the next table row is high."
msgstr "Стойността на прочитане на следващ ред от таблица е висока."

msgid "Rate of reading next table row: %s, this value should be less than 1 per hour"
msgstr "Стойността на отказаните клиенти е %s, тази стойност трябва да бъде под 1 за час"

msgid "Percentage of temp tables on disk"
msgstr "Процент на временни таблици на диска"

msgid "%s%% of all temporary tables are being written to disk, this value should be below 25%%"
msgstr "%s%% от всички временни таблици биват записвани на диска, тази стойност трябва да бъде под 25%%"

msgid "Rate of temporary tables being written to disk: %s, this value should be less than 1 per hour"
msgstr "Стойността на временните таблици записвани на диска е %s, тази стойност трябва да бъде под 1 за час"

msgid "MyISAM key buffer size"
msgstr "Размер на буфера за ключове на MyISAM"

msgid "key_buffer_size is 0"
msgstr "key_buffer_size е 0"

msgid "max %% MyISAM key buffer ever used: %s%%, this value should be above 95%%"
msgstr "Максималният %% от буфера за ключове на MyISAM ползван някога е %s%%, тази стойност трябва да е над 95%%"

msgid "Percentage of MyISAM key buffer used"
msgstr "Процент използван буфер за ключове на MyISAM"

msgid "%% MyISAM key buffer used: %s%%, this value should be above 95%%"
msgstr "Използваният %% от буфера за ключове на MyISAM е %s%%, тази стойност трябва да е над 95%%"

msgid "Percentage of index reads from memory"
msgstr "Процент на прочитане на индекс от паметта"

msgid "Index reads from memory: %s%%, this value should be above 95%%"
msgstr "Прочетени от паметта индекси: %s%%, стойността трябва да е над 95%%"

msgid "Rate of table open"
msgstr "Стойност на отваряне на таблици"

msgid "The rate of opening tables is high."
msgstr "Стойността на отваряне на таблици е висока."

msgid "Opened table rate: %s, this value should be less than 10 per hour"
msgstr "Стойността на отваряните таблици е %s, тази стойност трябва да бъде под 10 за час"

msgid "Percentage of used open files limit"
msgstr "Процент от лимита на отворени файлове"

msgid "The number of opened files is at %s%% of the limit. It should be below 85%%"
msgstr "Броят отворени файлове е на %s%% от ограничението, тази стойност трябва да бъде под 85%%"

msgid "Rate of open files"
msgstr "Стойност на отворени файлове"

msgid "The rate of opening files is high."
msgstr "Стойността на отворени файлове е висока."

msgid "Opened files rate: %s, this value should be less than 5 per hour"
msgstr "Стойността на отваряните файлове е %s, тази стойност трябва да бъде под 5 за час"

msgid "Immediate table locks: %s%%, this value should be above 95%%"
msgstr "Незабавното заключване на таблици е %s%%, тази стойност трябва да бъде над 95%%"

msgid "Table lock wait rate: %s, this value should be less than 1 per hour"
msgstr "Стойността на изчакване за заключване на таблица е %s, тази стойност трябва да бъде под 1 за час"

msgid "Thread cache"
msgstr "Буфер за нишки"

msgid "The thread cache is set to 0"
msgstr "Буферът за нишки е зададен на 0"

msgid "Thread cache is not efficient."
msgstr "Буферът за нишки е неефективен."

msgid "Thread cache hitrate: %s%%, this value should be above 80%%"
msgstr "Честота на обръщане към кеша: %s%%, тази стойност трябва да бъде над 80%%"

msgid "Threads that are slow to launch"
msgstr "Пускащи се бавно нишки"

msgid "There are too many threads that are slow to launch."
msgstr "Има много пускащи се бавно нишки."

msgid "%s thread(s) took longer than %s seconds to start, it should be 0"
msgstr "%s нишки(а) отнеха повече от %s секунди да стартират, трябва да бъдат 0"

msgid "Slow launch time"
msgstr "Показване времето за пускане"

msgid "Slow_launch_time is above 2s."
msgstr "Slow_launch_time е над 2s."

msgid "Set {slow_launch_time} to 1s or 2s to correctly count threads that are slow to launch."
msgstr "Задайте на {slow_launch_time} 1s или 2s, за да бъдат правилно отчетени бавно стартиращите нишки."

msgid "slow_launch_time is set to %s"
msgstr "slow_launch_time е зададено на %s"

msgid "Percentage of used connections"
msgstr "Процент използвни връзки"

msgid "Max_used_connections is at %s%% of max_connections, it should be below 80%%"
msgstr "Max_used_connections е на %s%% от max_connections, трябва да бъде под 80%%"

msgid "Percentage of aborted connections"
msgstr "Процент прекъснати връзки"

msgid "Too many connections are aborted."
msgstr "Твърде много прекъснати връзки."

msgid "Connections are usually aborted when they cannot be authorized. <a href=\"https://www.percona.com/blog/2008/08/23/how-to-track-down-the-source-of-aborted_connects/\">This article</a> might help you track down the source."
msgstr "Връзките обикновено се прекратяват, когато няма възможност да бъдат оторизирани. <a href=\"https://www.percona.com/blog/2008/08/23/how-to-track-down-the-source-of-aborted_connects/\"> Тази статия</a> може да ви помогне да проследите източника на проблеми."

msgid "%s%% of all connections are aborted. This value should be below 1%%"
msgstr "%s%% от всички връзки са прекъсвани, тази стойност трябва да бъде под 1%%"

msgid "Rate of aborted connections"
msgstr "Стойност прекъснати връзки"

msgid "Aborted connections rate is at %s, this value should be less than 1 per hour"
msgstr "Стойността на прекъснатите връзки е %s, тази стойност трябва да бъде под 1 за час"

msgid "Percentage of aborted clients"
msgstr "Процент прекъснати клиенти"

msgid "Too many clients are aborted."
msgstr "Твърде много прекъснати клиенти."

msgid "Clients are usually aborted when they did not close their connection to MySQL properly. This can be due to network issues or code not closing a database handler properly. Check your network and code."
msgstr "Клиенти обикновено са прекъсвани, когато не затварят правилно връзката си към MySQL. Това може да се дължи на мрежови проблеми или код, не затварящ правилно манипулатора към БД. Проверете вашата мрежа и код."

msgid "%s%% of all clients are aborted. This value should be below 2%%"
msgstr "%s%% от всички клиенти са прекъсвани, тази стойност трябва да бъде под 2%%"

msgid "Rate of aborted clients"
msgstr "Стойност прекъснати клиенти"

msgid "Aborted client rate is at %s, this value should be less than 1 per hour"
msgstr "Стойността на прекъсваните клиенти е %s, тази стойност трябва да бъде под 1 за час"

msgid "Is InnoDB disabled?"
msgstr "Забранен ли е InnoDB?"

msgid "You do not have InnoDB enabled."
msgstr "InnoDB е забранен."

msgid "InnoDB is usually the better choice for table engines."
msgstr "Обикновено InnoDB е по-добър избор на хранилище."

msgid "have_innodb is set to 'value'"
msgstr "have_innodb е 'value'"

msgid "InnoDB log size"
msgstr "Размер на дневника на InnoDB"

msgid "The InnoDB log file size is not an appropriate size, in relation to the InnoDB buffer pool."
msgstr "Размерът на лог-файла на InnoDB не съответства на буфера на InnoDB."

msgid "Your InnoDB log size is at %s%% in relation to the InnoDB buffer pool size, it should not be below 20%%"
msgstr "Размерът на вашият лог-файл на InnoDB е %s%% от размера на буфера на InnoDB, това съотношение не трябва да е по-малко от 20%%"

msgid "Max InnoDB log size"
msgstr "Максимален размер на дневника на InnoDB"

msgid "The InnoDB log file size is inadequately large."
msgstr "Лог-файла на InnoDB е неоправдано голям."

msgid "Your absolute InnoDB log size is %s MiB"
msgstr "Абсолютният размер на InnoDB журналa е %s MiB"

msgid "InnoDB buffer pool size"
msgstr "Размер на InnoDB буфер"

msgid "Your InnoDB buffer pool is fairly small."
msgstr "Вашият InnoDB буфер е доста малък."

msgid "You are currently using %s%% of your memory for the InnoDB buffer pool. This rule fires if you are assigning less than 60%%, however this might be perfectly adequate for your system if you don't have much InnoDB tables or other services running on the same machine."
msgstr "В момента използвате %s%% от Вашата памет за буферен резерв за InnoDB. Това правило се задейства ако бъдат зададени по-малко от 60%%, въпреки че това би могло да е напълно достатъчно за Вашата система, ако нямате много InnoDB таблици или други услуги работещи на същата машина."

msgid "MyISAM concurrent inserts"
msgstr "MyISAM едновременни вмъквания"

msgid "Enable {concurrent_insert} by setting it to 1"
msgstr "Включване на {concurrent_insert} и установяването му на 1"

msgid "concurrent_insert is set to 0"
msgstr "concurrent_insert e 0"

msgid "Query cache disabled"
msgstr "Изключен буфер за заявки"

msgid "The query cache is not enabled."
msgstr "Буферът за заявки не е включен."

msgid "query_cache_size is set to 0 or query_cache_type is set to 'OFF'"
msgstr "query_cache_size е зададено на 0 или query_cache_type е зададено на 'Изключено'"

msgid "Query Cache usage"
msgstr "Използвано от буфера за заявки"

msgid "Query cache fragmentation"
msgstr "Фрагментиране на буфера за заявки"

msgid "The query cache is considerably fragmented."
msgstr "Буферът за заявки е значително фрагментиран."

msgid "Cached queries are removed due to low query cache memory from the query cache."
msgstr "Буферирани заявки са махани заради малко свободна памет в буфера за заявки."

msgid "Query cache max size"
msgstr "Максимален размер на буфера за заявки"

msgid "Current query cache size: %s"
msgstr "Текущ размер на буфера за заявки: %s"

msgid "Query cache min result size"
msgstr "Минимален размер на резултат за буфериране"

msgid "query_cache_limit is set to 1 MiB"
msgstr "query_cache_limit е установен на 1 MiB"

