msgstr "Unha columna tipo BLOB cunha lonxitude máxima de 65,535 (2^16 - 1) bytes, almacenada nun prefixo de dous bytes que indica a lonxitude do valor"

msgid "A BLOB column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) bytes, stored with a four-byte prefix indicating the length of the value"
msgstr "Unha columna tipo BLOB cunha lonxitude máxima de  4,294,967,295 or 4GiB (2^32 - 1)  bytes, almacenada nun prefixo de catro bytes que indica a lonxitude do valor"

