msgstr "Unha columna tipo TEXTO cunha lonxitude máxima de 16,777,215 (2^24 - 1) caracteres, almacenada nun prefixo de un byte que indica a lonxitude do valor en bytes"

msgid "A TEXT column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) characters, stored with a four-byte prefix indicating the length of the value in bytes"
msgstr "Unha columna tipo TEXTO cunha lonxitude máxima de 4,294,967,295 ou 4GiB (2^32 - 1) caracteres, almacenada nun prefixo de un byte que indica a lonxitude do valor en bytes"

