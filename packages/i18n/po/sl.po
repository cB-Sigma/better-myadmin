msgstr "Stolpec BLOB, dolg največ 255 (2^8 - 1) znakov, shranjen z enobajtno predpono, ki nakazuje dolžino vrednosti v bajtih"

msgid "A BLOB column with a maximum length of 16,777,215 (2^24 - 1) bytes, stored with a three-byte prefix indicating the length of the value"
msgstr "Stolpec BLOB, dolg največ 16.777.215 (2^24 - 1) znakov, shranjen s tribajtno predpono, ki nakazuje dolžino vrednosti v bajtih"

