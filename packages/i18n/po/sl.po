msgstr "Stolpec BLOB, dolg največ 65.535 (2^16 - 1) znakov, shranjen z dvobajtno predpono, ki nakazuje dolžino vrednosti v bajtih"

msgid "A BLOB column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) bytes, stored with a four-byte prefix indicating the length of the value"
msgstr "Stolpec BLOB, dolg največ 4.294.967.295 ali 4 GiB (2^32 - 1) znakov, shranjen s štiribajtno predpono, ki nakazuje dolžino vrednosti v bajtih"

