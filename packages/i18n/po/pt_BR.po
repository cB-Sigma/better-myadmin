msgstr "Por favor, digite um valor entre {0} and {1}"

msgid "Please enter a value less than or equal to {0}"
msgstr "Por favor, digite um valor menor ou igual a {0}"

msgid "Please enter a value greater than or equal to {0}"
msgstr "Por favor, digite um valor maior ou igual a {0}"

msgid "Please enter a valid date or time"
msgstr "Por favor, digite um data válida ou um tempo"

msgid "Please enter a valid HEX input"
msgstr "Por favor, digite um número hexadecimal válido"

msgid "This column can not contain a 32 chars value"
msgstr "Esta coluna não pode conter um valor de 32 caracteres"

msgid "These functions are meant to return a binary result; to avoid inconsistent results you should store it in a BINARY, VARBINARY, or BLOB column."
msgstr "Essas funções retornam um resultado binário; para evitar resultados inconsistentes você deve armazená-lo em uma coluna BINARY, VARBINARY ou BLOB."

msgid "The file being uploaded is probably larger than the maximum allowed size."
msgstr "O arquivo que está sendo carregado provavelmente é maior do que o tamanho máximo permitido."

msgid "%s of %s"
msgstr "%s de %s"

msgid "%s/sec."
msgstr "%s/s."

msgid "About %MIN min. %SEC sec. remaining."
msgstr "Cerca de %MIN minuto(s) e %SEC segundo(s) restante(s)."

msgid "About %SEC sec. remaining."
msgstr "Cerca de %SEC segundo(s) restante(s)."

msgid "The file is being processed, please be patient."
msgstr "Este arquivo está sendo processado, por favor seja paciente."

msgid "Uploading your import file…"
msgstr "Subindo seu arquivo de importação…"

msgid "Please be patient, the file is being uploaded. Details about the upload are not available."
msgstr "Por favor aguarde, o arquivo está sendo subido. Detalhes sobre o upload não estão disponíveis."

msgid "Fatal error: The navigation can only be accessed via AJAX"
msgstr "Erro fatal: A navegação somente pode ser acessada via AJAX"

msgid "Select one…"
msgstr "Selecionar uma…"

