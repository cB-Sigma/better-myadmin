msgid "Quick - display only the minimal options to configure"
msgstr "দ্রুত - কনফিগারের স্বল্প অপশন শুধু দেখাও"

msgid "Custom - display all possible options to configure"
msgstr "কাষ্টম - কনফিগারের সাম্ভাব্য সব অপশন দেখাও"

msgid "Custom - like above, but without the quick/custom choice"
msgstr "কাষ্টম - উপরের মতই, দ্রুত এবং কাষ্টম বাদ দিয়ে"

msgid "complete inserts"
msgstr "সম্পুর্ন ইনর্সাট"

msgid "extended inserts"
msgstr "বর্ধিত ইনসার্ট"

msgid "both of the above"
msgstr "উপরের দুটিই"

msgid "neither of the above"
msgstr "উপরের কোনটি নয়"

msgid "Users cannot set a higher value"
msgstr "ব্যবহারকারী উচ্চতর মান নির্ধারন করতে পারবে না"

msgid "If enabled, user can enter any MySQL server in login form for cookie auth."
msgstr "কার্যকর করা হলে ব্যবহারকারীরা লগইন র্ফমে যে কোন MySQL server দিতে পারবে কুকি প্রমাণীকরণের জন্য।"

msgid "Secret passphrase used for encrypting cookies in [kbd]cookie[/kbd] authentication."
msgstr "[kbd]cookie[/kbd] প্রমাণীকরণে গোপন passphrase এর মাধ্যমে কুকি এনক্রীপট করা হয়।"

msgid "Defines which type of editing controls should be used for CHAR and VARCHAR columns; [kbd]input[/kbd] - allows limiting of input length, [kbd]textarea[/kbd] - allows newlines in columns."
msgstr "CHAR and VARCHAR স্তম্ভের জন্য কি ধরনের সম্পাদন ক্ষেত্র ব্যবহৃত হবে তা নির্ধারন করুন;[kbd]input[/kbd] ইনপুটের দৈর্ঘ সীমিত করবে, [kbd]textarea[/kbd] স্তম্ভের নতুন লাইন যোগ করবে।"

msgid "Defines the minimum size for input fields generated for CHAR and VARCHAR columns."
msgstr "প্রস্তুতকৃত CHAR and VARCHAR স্তম্ভের ইনপুট ক্ষেত্রের সর্বনিন্ম আকার নির্ধারন করুন।"

msgid "Defines the maximum size for input fields generated for CHAR and VARCHAR columns."
msgstr "প্রস্তুতকৃত CHAR এবং VARCHAR ইনপুট ক্ষেত্রের সর্বোচ্চ আকার নির্ধারণ করুন।"

msgid "Compress gzip exports on the fly without the need for much memory; if you encounter problems with created gzip files disable this feature."
msgstr "কাজের মধ্যই gzip সংকুচিত ফাইল রফতানী যা বেশী মেমোরী ব্যবহার করে না; যদি প্রস্তুতকৃত gzip ফাইল ঠিকমত কাজ না করে তবে ইহা অকার্যকর করুন।"

msgid "Whether a warning (\"Are your really sure…\") should be displayed when you're about to lose data."
msgstr "আপনি যখন তথ্য নষ্ট করতে বা হারাতে যাচ্ছেন তখন একটি সর্তক বার্তা (\"আপনি কি সম্পূর্ন নিশ্চিত…\")দেখাবে।"

msgid "Disable the table maintenance mass operations, like optimizing or repairing the selected tables of a database."
msgstr "টেবল রক্ষণাবেক্ষনের কাজগুলো অকার্যকর কর, যেমন ডাটাবেইজের নির্বাচিত টেবলগুলো অপটিমাইজ বা মেরামত করা।"

msgid "Set the number of seconds a script is allowed to run ([kbd]0[/kbd] for no limit)."
msgstr "একটি স্ক্রীপট চলার সময় (সেকেন্ডে)নির্ধারন করুন ([kbd]০[/kbd] সীমাহীন)।"

msgid "Sort order for items in a foreign-key dropdown box; [kbd]content[/kbd] is the referenced data, [kbd]id[/kbd] is the key value."
msgstr "ফরেন কী ড্রপডাউনের বিষয়গুলো গুছানোর পদ্ধতি [kbd]content[/kbd] হলো তথ্য এবং [kbd]id[/kbd] কী মান।"

msgid "Please note that phpMyAdmin is just a user interface and its features do not limit MySQL."
msgstr "মনে রাখবেন phpMyAdmin শুধুই একটি ব্যবহারকারীর সঙ্গে সংযোগ উপায় এবং এটি কোনভাবেই MySQL এর বিষয়াদি নির্দিষ্ট করে না।"

msgid "Advanced server configuration, do not change these options unless you know what they are for."
msgstr "উন্নত সার্ভার কনফিগারেশন, এগুলো কি তা না জেনে পরিবর্তন করবেন না।"

msgid "Configure phpMyAdmin configuration storage to gain access to additional features, see [doc@linked-tables]phpMyAdmin configuration storage[/doc] in documentation."
msgstr "অন্যান্য অতিরিক্ত সুবিধাদির জন্য phpMyAdmin কনফিগারেশন মজুদ ব্যবস্থা কনফিগার করন, সহায়িকার [doc@linked-tables]phpMyAdmin configuration storage[/doc]দেখুন।"

msgid "Tracking of changes made in database. Requires the phpMyAdmin configuration storage."
msgstr "ডাটাবেইজের পরিবর্তন ট্রেকিং করার জন্য phpMyAdmin কনফিগারেশন মজুদ ব্যবস্থা প্রয়োজন।"

msgid "Customize browse mode."
msgstr "ব্রাউজ পদ্ধতি পরিবর্তন।"

msgid "Customize default options."
msgstr "স্বাভাবিক অপশনগুলো পরিবর্তন।"

msgid "Settings for phpMyAdmin developers."
msgstr "phpMyAdmin উন্নয়নকারীদের জন্য সেটিংস।"

msgid "Customize edit mode."
msgstr "সম্পাদনা পদ্ধতি পরিবর্তন।"

msgid "Customize default export options."
msgstr "স্বাভাবিক রফতানী অপশনগুলো পরিবর্তন।"

msgid "Set some commonly used options."
msgstr "কিছু সাধারনভাবে ব্যবহৃত অপশন নির্ধারন করুন।"

msgid "Customize default common import options."
msgstr "স্বাভাবিক প্রচলিত আমদানি অপশন পরিবর্তন।"

msgid "Set import and export directories and compression options."
msgstr "আমদানি এবং রফতানী ডিরেক্টরি এবং সংকোচন নির্ধারন করুন।"

msgid "Databases display options."
msgstr "ডাটাবেইজ দেখার অপশন।"

msgid "Customize appearance of the navigation panel."
msgstr "চলাচলের ফ্রেম দেখার বিষয়গুলো পরিবর্তন।"

msgid "Servers display options."
msgstr "সার্ভারের প্রর্দশন অপশনগুলো।"

msgid "Tables display options."
msgstr "টেবল প্রর্দশনের অপশনগুলো।"

msgid "Settings that didn't fit anywhere else."
msgstr "যে সেটিংগুলো অন্য কোথাও খাপ খায় না।"

msgid "Authentication settings."
msgstr "প্রমানীকরণ সেটিংস।"

msgid "Enter server connection parameters."
msgstr "সার্ভার সংযোগের তথ্যগুলো দিন।"

msgid "Customize links shown in SQL Query boxes."
msgstr "পরিবর্তিত সংযোগগুলো SQL অনুসন্ধান বক্সে দেখাচ্ছে।"

msgid "SQL queries settings."
msgstr "SQL অনুসন্ধান সেটিংস।"

msgid "Customize startup page."
msgstr "প্রথম পাতাটি পরিবর্তন কর।"

msgid "Choose which details to show in the database structure (list of tables)."
msgstr "ডাটাবেইজ গঠনের সাথে বিশদ কি দেখাবে তা পছন্দ করুন (টেবলের তালিকা)।"

msgid "Settings for the table structure (list of columns)."
msgstr "টেবল গঠনের সেটিংস (স্তম্ভের তালিকা)।"

msgid "Choose how you want tabs to work."
msgstr "ট্যাবগুলো কিভাবে কাজ করবে পছন্দ করুন।"

msgid "Customize text input fields."
msgstr "অক্ষর দেওয়ার ক্ষেত্রটি পরিবর্তন করুন।"

msgid "Customize default options"
msgstr "স্বাভাবিক অপশনগুলো পরিবর্তন"

msgid "Disable some of the warnings shown by phpMyAdmin."
msgstr "phpMyAdmin এর দেখানো কিছু সতর্কবার্তা অকার্যকর কর।"

msgid "If enabled, phpMyAdmin continues computing multiple-statement queries even if one of the queries failed."
msgstr "যদি কার্যকর করা হয় phpMyAdmin multiple-statement অনুসন্ধানগুলো গননা করবে যদি কোন একটি অনুসন্ধান ব্যার্থও হয়।"

msgid "Allow interrupt of import in case script detects it is close to time limit. This might be a good way to import large files, however it can break transactions."
msgstr "নিধারিত শেষ হয়ে এলে আমদানি বন্ধ করার অনুমোদন। এটা বড় ফাইল আমদানির একটি ভাল উপায়, যদিও এটি কাজ বন্ধ রাখতে পারে।"

msgid "Default format; be aware that this list depends on location (database, table) and only SQL is always available."
msgstr "স্বাভাবিক গঠন: মনে রাখবেন এই তালিকাটি স্থানের উপর নির্ভরশীল (ডাটাবেইজ,টেবল)) এবং শুধু SQL কার্যকর।"

msgid "Number of queries to skip from start."
msgstr "আরম্ভ থেকে এড়িয়ে যাওয়ার অনুসন্ধানের সংখ্যা।"

msgid "If TRUE, logout deletes cookies for all servers; when set to FALSE, logout only occurs for the current server. Setting this to FALSE makes it easy to forget to log out from other servers when connected to multiple servers."
msgstr "যদি সত্য হয় (TRUE), লগআউট সব সার্ভারের কুকু মুছে ফেলবে; যখন মিথ্যায় (FALSE) সেট করা থাকে, শুধু বর্তমান সার্ভার থেকে লগাউট করবে। এটা FALSE সেট করলে যখন একই সাথে অনেকগুলো সার্ভারে সংযুক্ত থাকে তখন অন্যান্য সার্ভার থেকে লগাউট হতে ভুলে যাওয়া সহজ হতে পারে।"

msgid "Defines how long (in seconds) a login cookie should be stored in browser. The default of 0 means that it will be kept for the existing session only, and will be deleted as soon as you close the browser window. This is recommended for non-trusted environments."
msgstr "একটি কুকি কতটুকু সময়ের জন্য(সেকেন্ডে) ব্রাউজারে মজুদ করা হবে তা নির্ধারন করুন। স্বাভাবিকভাবে ০ যার মানে হলো এটা শুধুমাত্র বর্তমান সেশসনের জন্য, এবং ব্রাউজার বন্ধ করা হলে এটা মুছে ফেলা হবে। অবিশ্বস্ত পরিবেশের জন্য এটা উপযোগী।"

msgid "Maximum number of characters used when a SQL query is displayed."
msgstr "SQL অনুসন্ধান দেখানোর জন্য সর্বোচ্চ সংখ্যক বর্ণের সংখ্যা।"

msgid "The number of items that can be displayed on each page of the navigation tree."
msgstr "চলাচলের ট্রির প্রতি পাতায় কতগুলো জিনিস দেখাবে।"

msgid "Number of rows displayed when browsing a result set. If the result set contains more rows, \"Previous\" and \"Next\" links will be shown."
msgstr "ব্রাউজিংয়ের সময় প্রর্দশিত ফলাফলে রো'র সংখ্যা। এতে যদি অনেক বেশী রো থাকে \"পূর্ববর্তী \" এবং \"পরবর্তী\" দেখাবে।"

msgid "Open the linked page in the main window ([code]main[/code]) or in a new one ([code]new[/code])."
msgstr "সংযুক্ত পাতাটি একটি নতুন উইন্ডোতে ([code]new[/code]) খোল বা প্রধান উইন্ডোটিতে ([code]main[/code]) খোল।"

msgid "Defines the minimum number of items (tables, views, routines and events) to display a filter box."
msgstr "টেবল ফিল্টার বক্সে প্রদর্শনের জন্য নুন্যতম সংখ্যা।"

msgid "Show logo in navigation panel."
msgstr "চলাচল ফ্রেইমে লোগো দেখাও।"

msgid "URL where logo in the navigation panel will point to."
msgstr "চলাচলের ফ্রেইমে যেখানে লোগোটি থাকবে তার URL।"

msgid "Display server choice at the top of the navigation panel."
msgstr "পছন্দের সার্ভারটি উপরের বামদিকের কোণার ফ্রেইমে দেখাও।"

msgid "String that separates databases into different tree levels."
msgstr "বিভিন্ন পর্যায়ে ডাটাবেইজ ট্রি পৃথককারী ট্রিং।"

msgid "String that separates tables into different tree levels."
msgstr "বর্ণ যার দ্বারা টেবলগুলো ট্রি'র বিভিন্ন ক্ষেত্রে পৃথক হবে।"

msgid "Highlight server under the mouse cursor."
msgstr "মাউস কার্সরের নীচে সার্ভার চিহ্নিত কর।"

msgid "[kbd]SMART[/kbd] - i.e. descending order for columns of type TIME, DATE, DATETIME and TIMESTAMP, ascending order otherwise."
msgstr "[kbd]দক্ষ[/kbd]- যেমন স্তম্ভ যদি সময়,দিন, দিনসময়্ এবং সময়কাল হয় তবে অধমূখী অন্যথায় উর্দ্ধ মুখী।"

msgid "Disable the default warning that is displayed on the database details Structure page if any of the required tables for the phpMyAdmin configuration storage could not be found."
msgstr "phpMyAdmin কনফিগারেশনের কোন একটি storage table পাওয়া না গেলে ডাটাবেইজের বিশদ গঠন যেখানে দেখানো হয় সেখানে প্রদর্শিত সর্তকতা অকার্যকর কর।"

msgid "Disable the default warning that is displayed on the Structure page if column names in a table are reserved MySQL words."
msgstr "যদি কোন টেবলের স্তম্ভের নামে MySQL এর রির্জাভড ওর্য়াড ব্যবহার করা হয় তবে গঠন পাতায় যে সর্তকবার্তা প্রদর্শন করা হয় তা অকার্যকর কর।"

msgid "Enable if you want DB-based query history (requires phpMyAdmin configuration storage). If disabled, this utilizes JS-routines to display query history (lost by window close)."
msgstr "যদি DB-based অনুসন্ধান হিস্টোরী চান তবে কার্যকর করেন (phpMyAdmin কনফিগারেশনের storage)লাগবে, অন্যথায় অনুসন্ধান হিস্টোরী দেখানোর জন্য JS-routines ব্যবহৃত হবে। ( উইন্ডো বন্ধ করলে যা নষ্ট হয়ে যাবে)।"

msgid "An alternate host to hold the configuration storage; leave blank to use the already defined host."
msgstr "কনফিগারেশন মজুদ (configuration storage) করার জন্য অন্য একটি হোস্ট; না থাকলে খালি রাখুন।"

msgid "An alternate port to connect to the host that holds the configuration storage; leave blank to use the default port, or the already defined port, if the controlhost equals host."
msgstr "কনফিগারেশন মজুদ (configuration storage) করার জন্য অন্য একটি হোস্ট; না থাকলে খালি রাখুন।"

msgid "Leave blank for no SQL query history support, suggested: [kbd]pma__history[/kbd]."
msgstr "SQL অনুসন্ধানের হিস্টোরী সুবিধা দিতে না চাইলে খালি রাখুন, দেখুন: [kbd]pma_history[/kbd]।"

msgid "Limits number of table preferences which are stored in database, the oldest records are automatically removed."
msgstr "ডাটাবেইজে রক্ষিত টেবলের তথ্যের সংখ্যা সীমিত করন, পুরাতন তথ্য স্বয়ংক্রীয়ভাবে মুছে যাবে।"

msgid "You can use MySQL wildcard characters (% and _), escape them if you want to use their literal instances, i.e. use [kbd]'my\\_db'[/kbd] and not [kbd]'my_db'[/kbd]."
msgstr "আপনি MySQL wildcard অক্ষর (% and _)ব্যবহার করতে পারেন, ওগুলো escape করেন যদি এগুলো আক্ষরিকভাবে ব্যবহার করতে চান, যেমন [kbd]'my\\_db'[/kbd] এবং [kbd]'my_db'[/kbd]'টি নয়। এই অপশন ব্যবহার করে ডাটাবেইজের তালিকা গুছানো যাবে, শুধু ওগুলোর নাম দেন এবং শেষে[kbd]*[/kbd] ব্যবহার করুন alphabetical ভাবে সাজানোর জন্য।"

msgid "Leave blank for no PDF schema support, suggested: [kbd]pma__pdf_pages[/kbd]."
msgstr "পিডিএফ গঠনের সমর্থন না দেওয়ার জন্য খালি রাখুন, দেখুন:[kbd]pma_pdf_pages[/kbd]।"

msgid "Leave blank for no \"persistent\" recently used tables across sessions, suggested: [kbd]pma__recent[/kbd]."
msgstr "যদি টেবলের পছন্দগুলো বি্ভিন্ন সেশনে \"persistent\" স্থায়ীভাবে রাখতে না চান খালি রাখুন, দেখুন: [kbd]pma_table_uiprefs[/kbd]।"

msgid "Leave blank for no PDF schema support, suggested: [kbd]pma__table_coords[/kbd]."
msgstr "পিডিএফ গঠন সমর্থনের জন্য খালি রাখুন, দেখুন: [kbd]pma_table_coords[/kbd]।"

msgid "Table to describe the display columns, leave blank for no support; suggested: [kbd]pma__table_info[/kbd]."
msgstr "স্তম্ভ বর্ণনার টেবল, সমর্থন দিতে না চাইলে খালি রাখুন; দেখুন: [kbd]pma_table_info[/kbd]।"

msgid "Leave blank for no \"persistent\" tables' UI preferences across sessions, suggested: [kbd]pma__table_uiprefs[/kbd]."
msgstr "যদি টেবলের পছন্দগুলো বি্ভিন্ন সেশনে \"persistent\" স্থায়ীভাবে রাখতে না চান খালি রাখুন, দেখুন: [kbd]pma_table_uiprefs[/kbd]।"

msgid "Whether a DROP DATABASE IF EXISTS statement will be added as first line to the log when creating a database."
msgstr "যখন একটি ডাটাবেইজ তৈরী হবে তখন একটি DROP DATABASE IF EXISTS লেখা লগের প্রথম লাইনে যুক্ত হবে।"

msgid "Whether a DROP TABLE IF EXISTS statement will be added as first line to the log when creating a table."
msgstr "যখন লগ একটি টেবল তৈরী হবে তখন একটি DROP TABLE IF EXISTS লেখা লগের প্রথম লাইনে যুক্ত হবে।"

msgid "Whether a DROP VIEW IF EXISTS statement will be added as first line to the log when creating a view."
msgstr "যখন একটি ভিউ তৈরী হবে তখন একটি DROP VIEW IF EXISTS লেখা লগের প্রথম লাইনে যুক্ত হবে।"

msgid "Defines the list of statements the auto-creation uses for new versions."
msgstr "একটি statements এর তালিকা তৈরী করুন যা সংস্করন তৈরীর জন্য স্বয়ংক্রীয় ভাবে ব্যবহৃত হবে।"

msgid "Leave blank for no SQL query tracking support, suggested: [kbd]pma__tracking[/kbd]."
msgstr "SQL অনুসন্ধান ট্রেকিং সমর্থন না দেওয়ার জন্য খালি রাখুন, দেখুন: [kbd]pma_tracking[/kbd]।"

msgid "Whether the tracking mechanism creates versions for tables and views automatically."
msgstr "ট্রেকিং ব্যবস্থা টেবল এবং ভিউ এর সংস্করন স্বয়ংক্রীয় ভাবে তৈরী করবে।"

msgid "Leave blank for no user preferences storage in database, suggested: [kbd]pma__userconfig[/kbd]."
msgstr "ব্যবহারকারীর নির্ধারন (preferences) ডাটাবেইজে মজুদ করতে না চাইলে খালি রাখুন, দেখুন:[kbd]pma_userconfig[/kbd]।"

msgid "Leave blank to disable the feature to hide and show navigation items, suggested: [kbd]pma__navigationhiding[/kbd]."
msgstr "ব্যবহারকারীর নির্ধারন (preferences) ডাটাবেইজে মজুদ করতে না চাইলে খালি রাখুন, দেখুন:[kbd]pma_userconfig[/kbd]।"

msgid "A user-friendly description of this server. Leave blank to display the hostname instead."
msgstr "ব্যবহারকারীর জন্য সার্ভারের সহজবোধ্য বিবরণ। হোস্ট নামটি দেখাবার জন্য খালি রাখতে পারেন।"

msgid "Leave blank if not used."
msgstr "ব্যবহৃত না হলে থালি রাখ।"

msgid "Leave blank for defaults."
msgstr "স্বাভাবিকভাবে থাকার জন্য খালি রাখুন।"

msgid "HTTP Basic Auth Realm name to display when doing HTTP Auth."
msgstr "যথন এইছটিটিপি প্রমানীকরণ ব্যবহার হবে তখন প্রদর্শনের জন্য প্রাথমিক এইছটিটিপি প্রমানীকরণ নাম।"

msgid "Authentication method to use."
msgstr "ব্যবহারের জন্য প্রমাণীকরনের পদ্ধতী।"

msgid "Compress connection to MySQL server."
msgstr "সংকুচিত MySQL সার্ভারের সংযোগ।"

msgid "Hide databases matching regular expression (PCRE)."
msgstr "ডাটাবেইজের regular expression (PCRE) মিলকরন লুকাও।"

msgid "Hostname where MySQL server is running."
msgstr "MySQL সার্ভারের হোস্ট নাম।"

msgid "Leave empty if not using config auth."
msgstr "খালি রাখুন যদি কনফিগ প্রমাণীকরণ ব্যবহার না করেন।"

msgid "Port on which MySQL server is listening, leave empty for default."
msgstr "যে পোর্টে MySQL সার্ভার শুনছে, স্বাভাবিকটির জন্য খালি রাখুন।"

msgid "Socket on which MySQL server is listening, leave empty for default."
msgstr "কোন সকেটে MySQL সার্ভার শুনছে, স্বাভাবিকটির জন্য।"

msgid "Enable SSL for connection to MySQL server."
msgstr "MySQL সার্ভারে সংযোগের জন্য SSL কার্যকর কর।"

msgid "Please note that enabling this has no effect with [kbd]config[/kbd] authentication mode because the password is hard coded in the configuration file; this does not limit the ability to execute the same command directly."
msgstr "মনে রাখবেন [kbd]config[/kbd] প্রমাণীকরণ এর সাথে এটা কার্যকর করলে কাজ করবে না কারন পাসওয়ার্ডটি কনফিগারেশন ফাইলে লেখা আছে; এটা একই কমান্ড সরাসরি কার্যকর করার ক্ষমতা খর্ব করে না।"

msgid "Show or hide a column displaying the Creation timestamp for all tables."
msgstr "সব টেবলের প্রস্তুত সময় প্রর্দশনের স্তম্ভ দেখাবে বা লুকাবে।"

msgid "Show or hide a column displaying the Last update timestamp for all tables."
msgstr "সব টেবলের আপডেট সময় প্রর্দশনের স্তম্ভ দেখাবে বা লুকাবে।"

msgid "Show or hide a column displaying the Last check timestamp for all tables."
msgstr "সব টেবলের সর্বশেষ পরীক্ষার সময় প্রর্দশনের স্তম্ভ দেখাবে বা লুকাবে।"

msgid "Defines whether or not type fields should be initially displayed in edit/insert mode."
msgstr "সম্পাদনা/ইনর্সাটের সময় টাইপ ফিল্ড দেখাবে কিনা তা নির্ধারন করুন।"

msgid "Display the function fields in edit/insert mode."
msgstr "ফাংশন ক্ষেত্রটি সম্পাদনা/ইনর্সাট অবস্থায় দেখাবে।"

msgid "Whether to show hint or not."
msgstr "আভাস দেখাবে অথবা না।"

msgid "Defines whether SQL queries generated by phpMyAdmin should be displayed."
msgstr "নিধার্রণ করুন phpMyAdmin দ্বারা প্রস্তুতকৃত SQL অনুসন্ধান প্রদর্শন করবে কিনা।"

msgid "Mark used tables and make it possible to show databases with locked tables."
msgstr "ব্যবহৃত টেবল চিহ্নিত কর এবং লক্ড টেবল সহ ডাটাবেইজগুলো দেখাবার ব্যবস্থা কর।"

msgid "Textarea size (columns) in edit mode, this value will be emphasized for SQL query textareas (*2)."
msgstr "সম্পাদনার সময়, টেক্সটএরিয়া (স্তম্ভ) আকৃতি এই মানটি SQL অনুসন্ধানের টেক্সটএরিয়া (*২) এবং অনুসন্ধান উইন্ডো (*১.২৫) প্রভাব ফেলবে।"

msgid "Input proxies as [kbd]IP: trusted HTTP header[/kbd]. The following example specifies that phpMyAdmin should trust a HTTP_X_FORWARDED_FOR (X-Forwarded-For) header coming from the proxy 1.2.3.4:[br][kbd]1.2.3.4: HTTP_X_FORWARDED_FOR[/kbd]."
msgstr "প্রক্সি দিন [kbd]IP: trusted HTTP header[/kbd]। উদাহরণটি দেখাচ্ছে যে phpMyAdmin 1.2.3.4:[br][kbd]1.2.3.4:HTTP_X_FORWARDED_FOR[/kbd] থেকে আসা শিরোনামে HTTP_X_FORWARDED_FOR (X-Forwarded-For) বিশ্বাস করবে।"

msgid "When disabled, users cannot set any of the options below, regardless of the checkbox on the right."
msgstr "যদি অকার্যকর থাবে, ব্যবহারকারী নীচের কোন অপশন সেট করতে পারেব না, ডান দিকের চেকবক্স পর্যন্ত।"

msgid "Highlight selected rows."
msgstr "নির্বাচিত রোগুলো উজ্জ্বল কর।"

msgid "Highlight row pointed by the mouse cursor."
msgstr "মাউস দ্বার পয়েন্টড রো উজ্জ্বল কর।"

msgid "Number of columns for CHAR/VARCHAR textareas."
msgstr "CHAR/VARCHAR textarea'র জন্য স্তম্ভের সংখ্যা।"

msgid "Number of rows for CHAR/VARCHAR textareas."
msgstr "CHAR/VARCHAR textarea'র রো সংখ্যা।"

msgid "Tab that is displayed when entering a database."
msgstr "কোন ডাটাবেইজে প্রবেশ কালে প্রদর্শনের ট্যাব।"

msgid "Tab that is displayed when entering a server."
msgstr "কোন সার্ভারে প্রবেশ কালে প্রদর্শনের ট্যাব।"

msgid "Tab that is displayed when entering a table."
msgstr "কোন টেবলে প্রবেশকালে প্রর্দশনের ট্যাব।"

msgid "Whether the table structure actions should be hidden."
msgstr "টেবল গঠনের কার্যাবলী লুকানো থাকবে।"

msgid "Show server listing as a list instead of a drop down."
msgstr "সার্ভারের তালিকা ড্রপ ডাউনের পরিবর্তে একটি তালিকা হিসাবে দেখাবে।"

msgid "A dropdown will be used if fewer items are present."
msgstr "যদি অল্প সংখ্যক বিষয় থাকে তবে ড্রপডাউন ব্যবহৃত হবে।"

msgid "How many rows can be inserted at one time."
msgstr "এক সংগে কতগুলো রো ইনসার্ট করবে।"

msgid "Maximum number of characters shown in any non-numeric column on browse view."
msgstr "সংখ্যা নয় এমন স্তম্ভে প্রদর্শনের জন্য সবোর্চ্চ অক্ষরের সংখ্যা।"

msgid "Define how long (in seconds) a login cookie is valid."
msgstr "একটি লগইন কুকি কতক্ষন (সেকেন্ডে) কার্যকর থাকবে তা নির্ধারণ করুন।"

msgid "Double size of textarea for LONGTEXT columns."
msgstr "LONGTEXT স্তম্ভের জন্য টেক্সটএরিয়া দ্বিগুন কর।"

msgid "Maximum number of databases displayed in database list."
msgstr "টেবল তালিকায় প্রদর্শনের জন্য টেবলের সর্বোচ্চ সংখ্যা।"

msgid "Maximum number of tables displayed in table list."
msgstr "টেবল তালিকায় প্রদর্শনের জন্য টেবলের সর্বোচ্চ সংখ্যা।"

msgid "Maximum number of recently used tables; set 0 to disable."
msgstr "সম্প্রতি ব্যবহৃত টেবলের সর্বো্চ্চ সংখ্যা; অকার্যকর করার জন্য ০ নির্ধারন করুন।"

msgid "These are Edit, Copy and Delete links."
msgstr "এগুলো সম্পাদনা, প্রতিলিপি এবং মুছা সংযোগ।"

msgid "Use natural order for sorting table and database names."
msgstr "টেবল এবং ডাটাবেইজের নাম সাজানোর জন্য স্বাভাবিক বিন্যাস ব্যবহার কর।"

msgid "Use only icons, only text or both."
msgstr "শুধু আইকন, শুধু মাত্র টেক্সট বা উভয়ই ব্যবহার কর।"

msgid "Use GZip output buffering for increased speed in HTTP transfers."
msgstr "HTTP স্থানান্তরের গতি বাড়ানোর জন্য জিজিপ আউটপুট বাফারিং ব্যবহার কর।"

msgid "Use persistent connections to MySQL databases."
msgstr "MySQL ডাটাবেইজে স্থীর সংযোগ ব্যবহার কর।"

msgid "Disallow BLOB and BINARY columns from editing."
msgstr "BLOB এবং BINARY টেবল সম্পাদনা অ-অনুমোদিত।"

msgid "How many queries are kept in history."
msgstr "হিস্টোরীতে কতগুলো অনুসন্ধান থাকবে।"

msgid "Select which functions will be used for character set conversion."
msgstr "বর্ণরাশি পরিবর্তনে কোন ফাংশন ব্যবহৃত হবে তা নির্বাচন করুন।"

msgid "When browsing tables, the sorting of each table is remembered."
msgstr "যখন টেবল ব্রাউজ করা হবে, টেবলের সজ্জা মনে রাখবে।"

msgid "Repeat the headers every X cells, [kbd]0[/kbd] deactivates this feature."
msgstr "প্রতি X cells শিরোনাম পুনরায় দেখাবে, [kbd]০[/kbd] এটি অকার্যকর করবে।"

msgid "Directory where exports can be saved on server."
msgstr "সার্ভারে রফতানী সংরক্ষনের ডিরেক্টরী।"

msgid "Defines whether the query box should stay on-screen after its submission."
msgstr "পেশ করার পর অনুসন্ধান বক্সটি পর্দায় থাকবে কিনা।"

msgid "Title of browser window when a database is selected."
msgstr "একটি ডাটাবেইজ নিবার্চন করা হলে ব্রাউজার উইন্ডোর শিরোনাম।"

msgid "Title of browser window when nothing is selected."
msgstr "কিছু নির্বাচিত না থাকলে ব্রাউজার উইন্ডোর শিরোনাম।"

msgid "Title of browser window when a server is selected."
msgstr "একটি সার্ভার নিবার্চন করা হলে ব্রাউজারের শিরোনাম।"

msgid "Title of browser window when a table is selected."
msgstr "একটি টেবল নির্বাচন করা হবে ব্রাউজার উইন্ডোর শিরোনাম।"

msgid "Directory on server where you can upload files for import."
msgstr "সার্ভরের আপলোড ডিরেক্টরি যেখানে আমদানির ফাইল রাখা যাবে।"

msgid "Allow for searching inside the entire database."
msgstr "সমস্ত ডাটাবেইজের ভিতর খোঁজার অনুমতি।"

msgid "Enables check for latest version on main phpMyAdmin page."
msgstr "নতুন কোন সংস্করন আছে কিনা তা phpMyAdmin page এ পরীক্ষা করে দেখবে।"

msgid "Allow login to any MySQL server"
msgstr "যে কোন MySQL server এ লগইন এর অনুমোদন"

msgid "Show \"Drop database\" link to normal users"
msgstr "সাধারন ব্যবহারকারীকে \"Drop database\" সংযোগ দেখাও"

msgid "Blowfish secret"
