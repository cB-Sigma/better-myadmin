msgstr "ตาราง MediaWiki"

msgid "Import percentages as proper decimals <i>(ex. 12.00% to .12)</i>"
msgstr "นำเข้าค่าเปอร์เซ็นต์โดยแปลงเป็นทศนิยมให้ถูกต้อง <i>(เช่น 12.00% เป็น .12)</i>"

msgid "Import currencies <i>(ex. $5.00 to 5.00)</i>"
msgstr "นำเข้าสกุลเงิน <i>(เช่น $5.00 เป็น 5.00)</i>"

msgid "The XML file specified was either malformed or incomplete. Please correct the issue and try again."
msgstr "ไฟล์ XML ที่ระบุมีรูปแบบไม่ถูกต้องหรือไม่สมบูรณ์ โปรดแก้ไขปัญหาแล้วลองใหม่อีกครั้ง"

msgid "Could not parse OpenDocument Spreadsheet!"
msgstr "ไม่สามารถแยกวิเคราะห์สเปรดชีต OpenDocument ได้!"

msgid "ESRI Shape File"
msgstr "ไฟล์รูปทรง ESRI"

msgid "There was an error importing the ESRI shape file: \"%s\"."
msgstr "เกิดข้อผิดพลาดในการนำเข้าไฟล์รูปทรง ESRI: \"%s\""

msgid "MySQL Spatial Extension does not support ESRI type \"%s\"."
msgstr "ส่วนขยาย MySQL Spatial ไม่รองรับชนิดข้อมูล ESRI \"%s\""

