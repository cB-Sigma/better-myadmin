msgstr "คุณกำลังพยายามตั้งค่าบัญชีนี้ให้เข้าสู่ระบบโดยไม่ต้องใช้รหัสผ่าน แต่คำสั่งการกำหนดค่า <code>AllowNoPassword</code> เป็น false หากคุณดำเนินการต่อ บัญชีจะไม่สามารถเข้าสู่ระบบผ่าน phpMyAdmin ได้"

msgid "Removing Selected Users"
msgstr "กำลังลบผู้ใช้ที่เลือกออก"

msgid "Template was created."
msgstr "แม่แบบถูกสร้างขึ้นแล้ว"

msgid "Template was loaded."
msgstr "โหลดแม่แบบแล้ว"

msgid "Template was updated."
msgstr "อัปเดตแม่แบบแล้ว"

msgid "Template was deleted."
msgstr "แม่แบบถูกลบออกแล้ว"

msgid "Other"
msgstr "อื่นๆ"

msgid ","
msgstr ","

msgid "."
msgstr "."

msgid "Connections / Processes"
msgstr "การเชื่อมต่อ / กระบวนการ"

msgid "Number of statements"
msgstr "จำนวนข้อความ"

msgid "Query cache efficiency"
msgstr "ประสิทธิภาพของแคชคำสั่งเรียกดู"

msgid "Query cache usage"
