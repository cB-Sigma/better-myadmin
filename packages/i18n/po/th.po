msgstr "ปลดล็อกบัญชี้นี้"

msgid "Lock this account."
msgstr "ล็อกบัญชีนี้"

msgctxt "Unlock the account."
msgid "Unlock"
msgstr "ปลดล็อก"

msgctxt "Lock the account."
msgid "Lock"
msgstr "ล็อก"

msgid "Remove selected user accounts"
msgstr "ลบบัญชีผู้ใช้ที่เลือก"

