msgid "Tracking for %1$s was deactivated at version %2$s."
msgstr "การติดตามสำหรับ %1$s ถูกปิดใช้งานในเวอร์ชัน %2$s"

msgid "Version %1$s of %2$s was deleted."
msgstr "เวอร์ชัน %1$s ของ %2$s ถูกลบแล้ว"

msgid "Version %1$s was created, tracking for %2$s is active."
msgstr "เวอร์ชัน %1$s ถูกสร้างขึ้นแล้ว การติดตามสำหรับ %2$s เปิดใช้งานอยู่"

msgid "Sorry, we failed to restore the dropped trigger."
msgstr "ขออภัย เราไม่สามารถกู้คืนทริกเกอร์ที่โยนทิ้งไปแล้วได้"

msgid "Trigger %1$s has been modified."
msgstr "ทริกเกอร์ %1$s ได้รับการแก้ไขแล้ว"

msgid "Trigger %1$s has been created."
msgstr "ทริกเกอร์ %1$s ได้ถูกสร้างขึ้นแล้ว"

msgid "You must provide a trigger name!"
msgstr "คุณต้องระบุชื่อทริกเกอร์!"

msgid "You must provide a valid timing for the trigger!"
msgstr "คุณต้องระบุช่วงเวลาที่ถูกต้องสำหรับการทำงานของทริกเกอร์!"

msgid "You must provide a valid event for the trigger!"
msgstr "คุณต้องระบุเหตุการณ์ที่ถูกต้องเพื่อใช้เป็นทริกเกอร์!"

msgid "You must provide a valid table name!"
msgstr "คุณต้องระบุชื่อตารางที่ถูกต้อง!"

msgid "You must provide a trigger definition."
msgstr "คุณต้องระบุคำจำกัดความของทริกเกอร์"

msgid "empty"
msgstr "ว่างเปล่า"

msgid "not empty"
msgstr "ไม่ว่างเปล่า"

msgid "A 1-byte integer, signed range is -128 to 127, unsigned range is 0 to 255"
msgstr "จำนวนเต็ม 1 ไบต์ ช่วงค่าแบบมีเครื่องหมาย คือ -128 ถึง 127 ช่วงค่าแบบไม่มีเครื่องหมาย คือ 0 ถึง 255"

msgid "A 2-byte integer, signed range is -32,768 to 32,767, unsigned range is 0 to 65,535"
msgstr "จำนวนเต็ม 2 ไบต์ ช่วงค่าแบบมีเครื่องหมาย คือ -32,768 ถึง 32,767 ช่วงค่าแบบไม่มีเครื่องหมาย คือ 0 ถึง 65,535"

msgid "A 3-byte integer, signed range is -8,388,608 to 8,388,607, unsigned range is 0 to 16,777,215"
msgstr "จำนวนเต็ม 3 ไบต์ ช่วงค่าแบบมีเครื่องหมาย คือ -8,388,608 ถึง 8,388,607 ช่วงค่าแบบไม่มีเครื่องหมาย คือ 0 ถึง 16,777,215"

msgid "A 4-byte integer, signed range is -2,147,483,648 to 2,147,483,647, unsigned range is 0 to 4,294,967,295"
msgstr "จำนวนเต็ม 4 ไบต์ ช่วงค่าแบบมีเครื่องหมาย คือ -2,147,483,648 ถึง 2,147,483,647 ช่วงค่าแบบไม่มีเครื่องหมาย คือ 0 ถึง 4,294,967,295"

msgid "An 8-byte integer, signed range is -9,223,372,036,854,775,808 to 9,223,372,036,854,775,807, unsigned range is 0 to 18,446,744,073,709,551,615"
msgstr "จำนวนเต็ม 8 ไบต์ ช่วงค่าแบบมีเครื่องหมาย คือ -9,223,372,036,854,775,808 ถึง 9,223,372,036,854,775,807 ช่วงค่าแบบไม่มีเครื่องหมาย คือ 0 ถึง 18,446,744,073,709,551,615"

msgid "A fixed-point number (M, D) - the maximum number of digits (M) is 65 (default 10), the maximum number of decimals (D) is 30 (default 0)"
msgstr "ตัวเลขแบบจุดคงที่ (M, D) - จำนวนหลักสูงสุด (M) คือ 65 (ค่าเริ่มต้นคือ 10) จำนวนจุดทศนิยมสูงสุด (D) คือ 30 (ค่าเริ่มต้นคือ 0)"

msgid "A small floating-point number, allowable values are -3.402823466E+38 to -1.175494351E-38, 0, and 1.175494351E-38 to 3.402823466E+38"
msgstr "จำนวนทศนิยมขนาดเล็ก ค่าที่อนุญาตคือ -3.402823466E+38 ถึง -1.175494351E-38, 0 และ 1.175494351E-38 ถึง 3.402823466E+38"

msgid "A double-precision floating-point number, allowable values are -1.7976931348623157E+308 to -2.2250738585072014E-308, 0, and 2.2250738585072014E-308 to 1.7976931348623157E+308"
msgstr "เลขทศนิยมความแม่นยำสูง ค่าที่อนุญาตคือ ตั้งแต่ -1.7976931348623157E+308 ถึง -2.2250738585072014E-308, 0 และ 2.2250738585072014E-308 ถึง 1.7976931348623157E+308"

msgid "Synonym for DOUBLE (exception: in REAL_AS_FLOAT SQL mode it is a synonym for FLOAT)"
msgstr "คำพ้องความหมายของ DOUBLE (ยกเว้น: ในโหมด SQL REAL_AS_FLOAT คำพ้องความหมายของ FLOAT)"

msgid "A bit-field type (M), storing M of bits per value (default is 1, maximum is 64)"
msgstr "ชนิดข้อมูลบิตฟิลด์ (M) สำหรับจัดเก็บค่าแต่ละค่าด้วยบิตจำนวน M บิต (ค่าเริ่มต้นคือ 1 ค่าสูงสุดคือ 64)"

msgid "A synonym for TINYINT(1), a value of zero is considered false, nonzero values are considered true"
msgstr "คำพ้องความหมายของ TINYINT(1) ค่าศูนย์ถือว่าเป็นเท็จ ค่าที่ไม่ใช่ศูนย์ถือว่าเป็นจริง"

msgid "An alias for BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE"
msgstr "นามแฝงของ BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE"

msgid "A date, supported range is %1$s to %2$s"
msgstr "วันที่ ช่วงวันที่ที่รองรับคือ %1$s ถึง %2$s"

msgid "A date and time combination, supported range is %1$s to %2$s"
msgstr "รูปแบบวันที่พร้อมเวลาที่รองรับคือช่วง %1$s ถึง %2$s"

msgid "A timestamp, range is 1970-01-01 00:00:01 UTC to 2038-01-19 03:14:07 UTC on 32-bit platforms (MariaDB 11.3 and earlier), and up to 2106-02-07 06:28:15 UTC on 64-bit platforms (MariaDB 11.5 and later), stored as the number of seconds since the epoch (1970-01-01 00:00:00 UTC)"
msgstr "ข้อมูลเวลาจะถูกบันทึกในช่วงเวลา 1970-01-01 00:00:01 UTC ถึง 2038-01-19 03:14:07 UTC บนแพลตฟอร์ม 32 บิต (MariaDB 11.3 และรุ่นก่อนหน้า) และถึง 2106-02-07 06:28:15 UTC บนแพลตฟอร์ม 64 บิต (MariaDB 11.5 และรุ่นที่ใหม่กว่า) โดยจะบันทึกเป็นจำนวนวินาทีตั้งแต่ยุคเริ่มต้น (1970-01-01 00:00:00 UTC)"

msgid "A time, range is %1$s to %2$s"
msgstr "เวลา ช่วงเวลาคือ %1$s ถึง %2$s"

msgid "A year in four-digit (4, default) or two-digit (2) format, the allowable values are 70 (1970) to 69 (2069) or 1901 to 2155 and 0000"
msgstr "ปีในรูปแบบสี่หลัก (4, ค่าเริ่มต้น) หรือสองหลัก (2) ค่าที่อนุญาตคือ 70 (1970) ถึง 69 (2069) หรือ 1901 ถึง 2155 และ 0000"

msgid "A fixed-length (0-255, default 1) string that is always right-padded with spaces to the specified length when stored"
msgstr "สตริงความยาวคงที่ (0-255 ค่าเริ่มต้นคือ 1) ที่จะถูกเติมช่องว่างด้านขวาให้ครบตามความยาวที่ระบุเสมอเมื่อจัดเก็บ"

msgid "A variable-length (%s) string, the effective maximum length is subject to the maximum row size"
msgstr "สตริงที่มีความยาวแปรผัน (%s) ความยาวสูงสุดที่ใช้งานได้จริงนั้นขึ้นอยู่กับขนาดแถวสูงสุด"

msgid "A TEXT column with a maximum length of 255 (2^8 - 1) characters, stored with a one-byte prefix indicating the length of the value in bytes"
msgstr "คอลัมน์ข้อความ (TEXT) ที่มีความยาวตัวอักษรสูงสุด 255 (2^8 - 1) โดยจัดเก็บพร้อมคำนำหน้าหนึ่งไบต์ที่ระบุความยาวของค่าเป็นไบต์"

msgid "A TEXT column with a maximum length of 65,535 (2^16 - 1) characters, stored with a two-byte prefix indicating the length of the value in bytes"
msgstr "คอลัมน์ข้อความ (TEXT) ที่มีความยาวตัวอักษรสูงสุด 65,535 (2^16 - 1) โดยจัดเก็บพร้อมคำนำหน้าสองไบต์ที่ระบุความยาวของค่าเป็นไบต์"

msgid "A TEXT column with a maximum length of 16,777,215 (2^24 - 1) characters, stored with a three-byte prefix indicating the length of the value in bytes"
msgstr "คอลัมน์ข้อความ (TEXT) ที่มีความยาวตัวอักษรสูงสุด 16,777,215 (2^24 - 1) โดยจัดเก็บพร้อมคำนำหน้าสามไบต์ที่ระบุความยาวของค่าเป็นไบต์"

msgid "A TEXT column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) characters, stored with a four-byte prefix indicating the length of the value in bytes"
msgstr "คอลัมน์ข้อความ (TEXT) ที่มีความยาวตัวอักษรสูงสุด 4,294,967,295 หรือ 4 กิกะไบต์ (2^32 - 1) โดยจัดเก็บพร้อมคำนำหน้าสี่ไบต์ที่ระบุความยาวของค่าในหน่วยไบต์"

msgid "Similar to the CHAR type, but stores binary byte strings rather than non-binary character strings"
msgstr "คล้ายกับชนิดข้อมูล CHAR แต่เก็บตัวอักษรเป็นไบต์แบบไบนารีแทนที่จะเป็นอักขระที่ไม่ใช่แบบไบนารี"

msgid "Similar to the VARCHAR type, but stores binary byte strings rather than non-binary character strings"
msgstr "คล้ายกับชนิดข้อมูล VARCHAR แต่เก็บตัวอักษรเป็นไบต์แบบไบนารีแทนที่จะเป็นอักขระที่ไม่ใช่แบบไบนารี"

msgid "A BLOB column with a maximum length of 255 (2^8 - 1) bytes, stored with a one-byte prefix indicating the length of the value"
msgstr "คอลัมน์ BLOB ที่มีความยาวสูงสุด 255 (2^8 - 1) ไบต์ จัดเก็บโดยมีคำนำหน้าหนึ่งไบต์ที่ระบุความยาวของค่า"

msgid "A BLOB column with a maximum length of 16,777,215 (2^24 - 1) bytes, stored with a three-byte prefix indicating the length of the value"
msgstr "คอลัมน์ BLOB ที่มีความยาวสูงสุด 16,777,215 (2^24 - 1) ไบต์ จัดเก็บโดยมีคำนำหน้าสามไบต์ที่ระบุความยาวของค่า"

msgid "A BLOB column with a maximum length of 65,535 (2^16 - 1) bytes, stored with a two-byte prefix indicating the length of the value"
msgstr "คอลัมน์ BLOB ที่มีความยาวสูงสุด 65,535 (2^16 - 1) ไบต์ จัดเก็บโดยมีคำนำหน้าสองไบต์ที่ระบุความยาวของค่า"

msgid "A BLOB column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) bytes, stored with a four-byte prefix indicating the length of the value"
msgstr "คอลัมน์ BLOB ที่มีความยาวสูงสุด 4,294,967,295 or 4GiB (2^32 - 1) ไบต์ จัดเก็บโดยมีคำนำหน้าสี่ไบต์ที่ระบุความยาวของค่า"

msgid "An enumeration, chosen from the list of up to 65,535 values or the special '' error value"
msgstr "การนับค่า ค่าที่เลือกจากรายการค่าสูงสุด 65,535 ค่า หรือค่าพิเศษ '' ที่ผิดพลาด"

msgid "A single value chosen from a set of up to 64 members"
msgstr "ค่าเดี่ยวที่ถูกเลือกจากชุดค่าที่มีสมาชิกได้มากถึง 64 ค่า"

msgid "A type that can store a geometry of any type"
msgstr "ประเภทที่สามารถจัดเก็บรูปทรงเรขาคณิตได้ทุกประเภท"

msgid "A point in 2-dimensional space"
msgstr "จุดในพื้นที่ 2 มิติ"

msgid "A curve with linear interpolation between points"
msgstr "เส้นโค้งที่มีการประมาณค่าเชิงเส้นระหว่างจุดต่าง ๆ"

msgid "A polygon"
msgstr "รูปหลายเหลี่ยม"

msgid "A collection of points"
msgstr "คอลเลคชั่นของพอยต์"

msgid "A collection of curves with linear interpolation between points"
msgstr "คอลเลคชั่นของเส้นโค้งที่มีการประมาณค่าเชิงเส้นระหว่างจุดต่าง ๆ"

msgid "A collection of polygons"
msgstr "คอลเลคชั่นของรูปหลายเหลี่ยม"

msgid "A collection of geometry objects of any type"
msgstr "คอลเลคชั่นของวัตถุรูปทรงเรขาคณิตประเภทใด ๆ"

msgid "Stores and enables efficient access to data in JSON (JavaScript Object Notation) documents"
msgstr "จัดเก็บและช่วยให้เข้าถึงข้อมูลในเอกสาร JSON (JavaScript Object Notation) ได้อย่างมีประสิทธิภาพ"

msgid "Intended for storage of IPv6 addresses, as well as IPv4 addresses assuming conventional mapping of IPv4 addresses into IPv6 addresses"
msgstr "จงใจจัดเก็บที่อยู่ IPv6 รวมถึงที่อยู่ IPv4 โดยสมมติว่ามีการแปลงที่อยู่ IPv4 เป็นที่อยู่ IPv6 ตามปกติ"

msgid "128-bit UUID (Universally Unique Identifier)"
msgstr "UUID (Universally Unique Identifier) ขนาด 128 บิต"

msgctxt "numeric types"
msgid "Numeric"
msgstr "ตัวเลข"

msgctxt "date and time types"
msgid "Date and time"
msgstr "วันและเวลา"

msgctxt "spatial types"
msgid "Spatial"
msgstr "เชิงพื้นที่"

msgid "Password is too long!"
msgstr "รหัสผ่านยาวเกินไป!"

msgid "The profile has been updated."
msgstr "ปรับปรุงโปรไฟล์เรียบร้อยแล้ว"

msgid "Max: %s%s"
msgstr "มากสุด: %s%s"

msgctxt "AM/PM indication in time"
msgid "PM"
msgstr "บ่าย"

msgctxt "AM/PM indication in time"
msgid "AM"
msgstr "เช้า"

msgid "%s days, %s hours, %s minutes and %s seconds"
msgstr "%s วัน, %s ชั่วโมง, %s นาที และ %s วินาที"

msgid "Users"
msgstr "ผู้ใช้"

msgid "Error in ZIP archive:"
msgstr "เกิดข้อผิดพลาดในไฟล์ ZIP:"

msgid "No files found inside ZIP archive!"
msgstr "ไม่พบไฟล์ใด ๆ ภายในไฟล์ ZIP!"
