msgid "Rate of sorts that cause temporary tables"
msgstr "Tilapäisiä taulukoita aiheuttavien lajittelujen osuus"

msgid "Temporary tables average: %s, this value should be less than 1 per hour."
msgstr "Väliaikaisten taulukoiden keskiarvo: %s, tämän arvon tulisi olla alle yksi tunnissa."

msgid "There are too many joins without indexes."
msgstr "Liian monta liitosta ilman indeksejä."

msgid "Table joins average: %s, this value should be less than 1 per hour"
msgstr "Taulukkoihin liittymisten keskiarvo: %s, tämän arvon tulisi olla alle yksi tunnissa"

msgid "Index scans average: %s, this value should be less than 1 per hour"
msgstr "Indeksiskannausten keskiarvo: %s, tämän arvon tulisi olla alle yksi tunnissa"

msgid "Rate of reading next table row: %s, this value should be less than 1 per hour"
msgstr "Seuraavan taulukkorivin lukunopeus: %s, tämän arvon tulisi olla alle yksi tunnissa"

msgid "%s%% of all temporary tables are being written to disk, this value should be below 25%%"
msgstr "%s %% kaikista väliaikaisista taulukoista kirjoitetaan levylle, tämän arvon tulee olla alle 25 %%"

msgid "MyISAM key buffer (index cache) % used is low."
msgstr "MyISAM-avainpuskurin (indeksivälimuistin) käyttöprosentti on alhainen."

msgid "%% MyISAM key buffer used: %s%%, this value should be above 95%%"
msgstr "%% MyISAM-avainpuskuri käytetty: %s %%, tämän arvon tulee olla yli 95 %%"

msgid "Index reads from memory: %s%%, this value should be above 95%%"
msgstr "Indeksi lukee muistista: %s %%, tämän arvon tulee olla yli 95 %%"

msgid "Opened table rate: %s, this value should be less than 10 per hour"
msgstr "Avattujen pöytien määrä: %s, tämän arvon tulisi olla alle kymmenen tunnissa"

msgid "The number of opened files is at %s%% of the limit. It should be below 85%%"
msgstr "Avattujen tiedostojen määrä on %s %% rajasta. Sen pitäisi olla alle 85 %%"

msgid "Opened files rate: %s, this value should be less than 5 per hour"
msgstr "Avattujen tiedostojen määrä: %s, tämän arvon tulisi olla alle viisi tunnissa"

msgid "Immediate table locks: %s%%, this value should be above 95%%"
msgstr "Välittömät pöydän lukitukset: %s %%, tämän arvon tulee olla yli 95 %%"

msgid "Table lock wait rate: %s, this value should be less than 1 per hour"
msgstr "Pöydän lukituksen odotusmäärä: %s, tämän arvon tulisi olla alle yksi tunnissa"

msgid "The thread cache is set to 0"
msgstr "Säikeen välimuisti on asetettu 0:ksi"

msgid "Thread cache hit rate %"
msgstr "Säikeiden välimuistin osumisprosentti"

msgid "Thread cache hitrate: %s%%, this value should be above 80%%"
msgstr "Säikeen välimuistin osumanopeus: %s %%, tämän arvon tulee olla yli 80 %%"

msgid "Threads that are slow to launch"
msgstr "Hitaasti käynnistyvät säikeet"

msgid "slow_launch_time is set to %s"
msgstr "slow_launch_time on asetettu %s:ksi"

msgid "Max_used_connections is at %s%% of max_connections, it should be below 80%%"
msgstr "Max_used_connections on %s %% max_connectionsista, sen pitäisi olla alle 80 %%"

msgid "Too many connections are aborted."
msgstr "Liian monta yhtettä keskeytetty."

msgid "%s%% of all connections are aborted. This value should be below 1%%"
msgstr "%s %% kaikista yhteyksistä on keskeytetty. Tämän arvon tulee olla alle 1 %%"

msgid "%s%% of all clients are aborted. This value should be below 2%%"
msgstr "%s %% kaikista asiakkaista on keskeytetty. Tämän arvon tulee olla alle 2 %%"

msgid "Aborted client rate is at %s, this value should be less than 1 per hour"
msgstr "Keskeytettyjen asiakkaiden määrä on %s, tämän arvon tulisi olla alle yksi tunnissa"

msgid "Is InnoDB disabled?"
msgstr "Onko InnoDB poistettu käytöstä?"

msgid "You do not have InnoDB enabled."
msgstr "InnoDB ei ole käytössä."

msgid "Your InnoDB log size is at %s%% in relation to the InnoDB buffer pool size, it should not be below 20%%"
msgstr "InnoDB-lokikokosi on %s %% suhteessa InnoDB-puskurivarannon kokoon, sen ei pitäisi olla alle 20 %%"

msgid "Your InnoDB buffer pool is fairly small."
msgstr "InnoDB-puskurivarastosi on melko pieni."

msgid "You are currently using %s%% of your memory for the InnoDB buffer pool. This rule fires if you are assigning less than 60%%, however this might be perfectly adequate for your system if you don't have much InnoDB tables or other services running on the same machine."
msgstr "Käytät tällä hetkellä %s %% muististasi InnoDB-puskurivarannossa. Tämä sääntö käynnistyy, jos määrität alle 60 %%, mutta tämä saattaa olla täysin riittävä järjestelmällesi, jos sinulla ei ole paljon InnoDB-taulukoita tai muita palveluita käynnissä samassa koneessa."

msgid "concurrent_insert is set to 0"
msgstr "concurrent_insert on asetettu arvoon 0"

msgid "The query cache is not enabled."
msgstr "Kyselyvälimuistia ei ole otettu käyttöön."

msgid "The current query cache hit rate of %s%% is below 20%%"
msgstr "Nykyinen kyselyn välimuistin osumasuhde %s %% on alle 20 %%"

msgid "The current ratio of free query cache memory to total query cache size is %s%%. It should be above 80%%"
msgstr "Vapaan kyselyvälimuistin nykyinen suhde kyselyn välimuistin kokonaiskokoon on %s %%. Sen pitäisi olla yli 80 %%"

msgid "The query cache is considerably fragmented."
msgstr "Kyselyvälimuisti on huomattavasti pirstaloitunut."

msgid "The cache is currently fragmented by %s%% , with 100%% fragmentation meaning that the query cache is an alternating pattern of free and used blocks. This value should be below 20%%."
msgstr "Välimuisti on tällä hetkellä pirstoutunut %s %%:lla, 100 %%:n pirstoutuneisuus tarkoittaa, että kyselyvälimuisti on vuorotellen ilmaisia ja käytettyjä lohkoja. Tämän arvon tulisi olla alle 20 %%."

msgid "The ratio of removed queries to inserted queries is %s%%. The lower this value is, the better (This rules firing limit: 0.1%%)"
msgstr "Poistettujen kyselyjen suhde lisättyihin kyselyihin on %s %%. Mitä pienempi tämä arvo on, sitä parempi (Tämä säätelee laukaisurajaa: 0,1 %%)"

msgid "Current query cache size: %s"
msgstr "Nykyinen kyselyvälimuistin koko: %s"

msgid "Search:"
msgstr "Haku:"

msgid "Unknown"
msgstr "Tuntematon"

