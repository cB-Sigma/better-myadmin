msgid "Quick - display only the minimal options to configure"
msgstr "Rýchly - zobrazí len minimum volieb pre nastavenie"

msgid "Custom - display all possible options to configure"
msgstr "Vlastný - zobrazí všetky voľby nastavenia"

msgid "Custom - like above, but without the quick/custom choice"
msgstr "Vlastný - ako vyššie, ale bez voľby rýchly/vlastný"

msgid "complete inserts"
msgstr "úplné vloženia"

msgid "extended inserts"
msgstr "rozšírené vkladania"

msgid "both of the above"
msgstr "obidve vyššie uvedené"

msgid "neither of the above"
msgstr "žiadny z vyššie uvedených"

msgid "Users cannot set a higher value"
msgstr "Uživatelia nemôžu nastaviť vyššiu hodnotu"

msgid "If enabled, user can enter any MySQL server in login form for cookie auth."
msgstr "Pokiaľ je povolené, užívateľ može zadať ľuvolný MySQL server pre prihlásenie cez cookie autentifikáciu."

msgid "Enabling this allows a page located on a different domain to call phpMyAdmin inside a frame, and is a potential [strong]security hole[/strong] allowing cross-frame scripting (XSS) attacks."
msgstr "Povolením tejto možnosti umožníte stránke umiestnenej na inej doméne zavolať phpMyAdmina vo vnútri rámca a je potenciálnou [strong]bezpečnostnou dierou[/strong] dovoľujúcou XSS (cross-frame scripting) útoky."

msgid "Secret passphrase used for encrypting cookies in [kbd]cookie[/kbd] authentication."
msgstr "Tajné heslo používané pre šifrovanie cookies pri prihlasovaní pomocou [kbd]cookie[/kbd]."

msgid "Enable bzip2 compression for import operations."
msgstr "Povoliť bzip2 kompresiu pre operácie importu."

msgid "Defines which type of editing controls should be used for CHAR and VARCHAR columns; [kbd]input[/kbd] - allows limiting of input length, [kbd]textarea[/kbd] - allows newlines in columns."
msgstr "Nastavte, ktorý typ ovládacích prvkov sa má použiť pri editácii polí typu CHAR a VARCHAR; [kbd]vstup[/kbd] - umožňuje obmedziť dĺžku vstupu, [kbd]textová oblasť[/kbd] - umožňuje použitie nových riadkov v poli."

msgid "Use user-friendly editor for editing SQL queries (CodeMirror) with syntax highlighting and line numbers."
msgstr "Použiť užívateľsky príjemný editor na úpravu SQL dozatazov CodeMirror) s číslovaním riadkov a zvýrazňovaním syntaxe."

msgid "Defines the minimum size for input fields generated for CHAR and VARCHAR columns."
msgstr "Definuje minimálnu veľkosť pre vstupné polia generované pre stĺpce typu CHAR a VARCHAR."

msgid "Defines the maximum size for input fields generated for CHAR and VARCHAR columns."
msgstr "Definuje maximálnu veľkosť pre vstupné polia generované pre stĺpce typu CHAR a VARCHAR."

msgid "Compress gzip exports on the fly without the need for much memory; if you encounter problems with created gzip files disable this feature."
msgstr "Komprimovať exporty za behu pomocou gzip bez veľkých pamäťových nárokov. Pokiaľ zistíte problémy s takto vytvorenými gzip súbormi, vypnite túto funkciu."

msgid "Whether a warning (\"Are your really sure…\") should be displayed when you're about to lose data."
msgstr "Či sa má zobrazovať varovanie (\"Ste si naozaj istí…\") pokiaľ hrozí strata dát."

msgid "Autocomplete of the table and column names in the SQL queries."
msgstr "Automatické dopĺňanie názvov tabuliek a stĺpcov v SQL dopytoch."

msgid "Disable the table maintenance mass operations, like optimizing or repairing the selected tables of a database."
msgstr "Vypnúť hromadné operácie pre údržbu tabuliek, ako je optimalizácia alebo opravy vybraných tabuliek v databáze."

msgid "Set the number of seconds a script is allowed to run ([kbd]0[/kbd] for no limit)."
msgstr "Nastavte dĺžku behu skriptu v sekundách ([kbd]0[/kbd] znamená bez obmedzení)."

msgid "Sort order for items in a foreign-key dropdown box; [kbd]content[/kbd] is the referenced data, [kbd]id[/kbd] is the key value."
msgstr "Poradie radenia položiek v rozbaľovacej ponuke cudzích kľúčov; [kbd]obsah[/kbd] sú referenčné dáta, [kbd]id[/kbd] je hodnota kľúča."

msgid "Specify browser's title bar text. Refer to [doc@faq6-27]documentation[/doc] for magic strings that can be used to get special values."
msgstr "Zadajte titulku, ktorú bude zobrazovať prehliadač. V [doc@faq6-27]documentácii[/doc] nájdete špeciálne reťazce, ktoré môžete použiť na získanie špeciálnych hodnôt."

msgid "Please note that phpMyAdmin is just a user interface and its features do not limit MySQL."
msgstr "Pripomíname, že phpMyAdmin je len užívateľské rozhranie a jeho funkcie neobmedzujú MySQL."

msgid "Advanced server configuration, do not change these options unless you know what they are for."
msgstr "Pokročilá konfigurácia servera, nemeňte tieto nastavenia, pokiaľ neviete čoho sa týkajú."

msgid "Configure phpMyAdmin configuration storage to gain access to additional features, see [doc@linked-tables]phpMyAdmin configuration storage[/doc] in documentation."
msgstr "Nastavenie phpMyAdmin miesta uloženia konfigurácie tak, aby získal prístup k prídavným funkciám, viď [doc@linked-tables]miesto uloženia konfigurácie [/doc] v dokumentácii."

msgid "Tracking of changes made in database. Requires the phpMyAdmin configuration storage."
msgstr "Sledovanie zmien vykonaných v databáze. Vyžaduje nastavenie miesta uloženia zmien phpMyAdmina."

msgid "Customize browse mode."
msgstr "Prispôsobiť režim prezerania."

msgid "Customize default options."
msgstr "Prispôsobenie východzích nastavení."

msgid "Settings for phpMyAdmin developers."
msgstr "Nastavenia pre vývojárov phpMyAdmina."

msgid "Customize edit mode."
msgstr "Prispôsobenie režimu úprav."

msgid "Customize default export options."
msgstr "Prispôsobiť východzie nastavenia exportu."

msgid "Set some commonly used options."
msgstr "Nastaviť často používané nastavenia."

msgid "Customize default common import options."
msgstr "Prispôsobiť východzie nastavenia importu."

msgid "Set import and export directories and compression options."
msgstr "Nastaví adresáre pre import a export a voľby kompresie."

msgid "Databases display options."
msgstr "Nastavenia zobrazenia databáz."

msgid "Customize appearance of the navigation panel."
msgstr "Prizpôsobiť vzhľad navigačného panela."

msgid "Customize the navigation tree."
msgstr "Prispôsobiť navigačný strom."

msgid "Servers display options."
msgstr "Nastavenie zobrazenia serverov."

msgid "Tables display options."
msgstr "Nastavenie zobrazenia tabuliek."

msgid "Settings that didn't fit anywhere else."
msgstr "Nastavenia, ktoré sa nedajú zaradiť inde."

msgid "Authentication settings."
msgstr "Nastavenia prihlasovania."

msgid "Enter server connection parameters."
msgstr "Vložte parametre pripojenia servera."

msgid "Customize links shown in SQL Query boxes."
msgstr "Prispôsobenie odkazov zobrazovaných v poliach pre SQL dopyty."

msgid "SQL queries settings."
msgstr "Nastavenia SQL dopytov."

msgid "Customize startup page."
msgstr "Prispôsobenie úvodnej stránky."

msgid "Choose which details to show in the database structure (list of tables)."
msgstr "Vyberte, ktoré detaily sa majú zobrazovať v štruktúre databázy (zoznam tabuliek)."

msgid "Settings for the table structure (list of columns)."
msgstr "Nastavenia štruktúry tabuliek (zoznam stĺpcov)."

msgid "Choose how you want tabs to work."
msgstr "Zvoľte, ako majú panely fungovať."

msgid "Customize text input fields."
msgstr "Prispôsobenie vstupných textových polí."

msgid "Customize default options"
msgstr "Prispôsobenie východzích nastavení"

msgid "Disable some of the warnings shown by phpMyAdmin."
msgstr "Vypnúť niektoré varovania zobrazované phpMyAdminom."

msgid "Enable gzip compression for import and export operations."
msgstr "Povolí gzip kompresiu pre importovanie a exportovanie."

msgid "If enabled, phpMyAdmin continues computing multiple-statement queries even if one of the queries failed."
msgstr "Pokiaľ je povolené, phpMyAdmin bude pokračovať v spracovaní viacprvkových dopytov, aj keď jeden z nich zlyhal."

msgid "Allow interrupt of import in case script detects it is close to time limit. This might be a good way to import large files, however it can break transactions."
msgstr "Povoliť prerušenie importu v prípade, že sa blíži časový limit behu skriptu. Týmto spôsobom sa môžu importovať aj veľké súbory, ale môže to zároveň spôsobiť problémy s transakciami."

msgid "Default format; be aware that this list depends on location (database, table) and only SQL is always available."
msgstr "Východzí formát: Berte na vedomie, že tento zoznam závisí na umiestnení (databáza, tabuľka) a len SQL je stále dostupné."

msgid "Number of queries to skip from start."
msgstr "Počet dopytov, ktoré sa majú preskočiť od začiatku."

msgid "If TRUE, logout deletes cookies for all servers; when set to FALSE, logout only occurs for the current server. Setting this to FALSE makes it easy to forget to log out from other servers when connected to multiple servers."
msgstr "Pokiaľ je povolené, pri odhlásení budú vymazané cookies pre všetky servery; pokiaľ je zakázané, vymaže sa len pre aktuálny server. Zakázaním tejto voľby sa môže ľahko stať, že sa zabudnete odhlásiť z ostatných serverov, pokiaľ ich používate viac."

msgid "Define whether the previous login should be recalled or not in [kbd]cookie[/kbd] authentication mode."
msgstr "Určuje, či sa má obnoviť predchádzajúce prihlásenie alebo nie pri prihlasovaní pomocou [kbd]cookie[/kbd]."

msgid "Defines how long (in seconds) a login cookie should be stored in browser. The default of 0 means that it will be kept for the existing session only, and will be deleted as soon as you close the browser window. This is recommended for non-trusted environments."
msgstr "Určuje, ako dlho (v sekundách) si má prehliadač pamätať prihlasovaciu cookie. Východzia hodnota 0 znamená, že cookie bude pamätaná, len po dobu sedenia a bude vymazaná pri zatvorení okna. Toto je odporúčané v nedôveryhodných prostrediach."

msgid "Maximum number of characters used when a SQL query is displayed."
msgstr "Maximálny počet znakov pri zobrazení SQL dopytu."

msgid "The number of items that can be displayed on each page on the first level of the navigation tree."
msgstr "Počet položiek, ktoré sa zobrazia na každej stránke prvej úrovne navigačného stromu."

msgid "The number of items that can be displayed on each page of the navigation tree."
msgstr "Počet položiek, ktoré sa zobrazia na každej stránke navigačného stromu."

msgid "Number of rows displayed when browsing a result set. If the result set contains more rows, \"Previous\" and \"Next\" links will be shown."
msgstr "Počet zobrazených riadkov pri prechádzaní sady výsledkov. Ak sada výsledkov obsahuje viac riadkov, zobrazia sa odkazy \"Predchádzajúci\" a \"Ďalší\"."

msgid "Defines the minimum number of items (tables, views, routines and events) to display a filter box."
msgstr "Definuje minimálny počet položiek (tabuliek, zobrazení, rutín, udalostí) pre zobrazenie filtra."

msgid "Group items in the navigation tree (determined by the separator defined in the Databases and Tables tabs above)."
msgstr "Zoskupovať položky v navigačnom paneli (určené oddeľovačom nastaveným v záložke Databázy a tabuľky vyššie)."

msgid "Whether to offer the possibility of tree expansion in the navigation panel."
msgstr "Či sa má ponúknuť možnosť rozbaľovania stromu v navigačnom paneli."

msgid "Show logo in navigation panel."
msgstr "Zobraziť logo v navigačnom paneli."

msgid "URL where logo in the navigation panel will point to."
msgstr "URL, na ktoré bude odkazovať logo v navigačnom paneli."

msgid "Display server choice at the top of the navigation panel."
msgstr "Zobraziť voľbu servera v hornej časti navigačného panela."

msgid "String that separates databases into different tree levels."
msgstr "Reťazec, ktorý rozdeľuje databázy do rôznych úrovní stromu."

msgid "String that separates tables into different tree levels."
msgstr "Reťazec, ktorý rozdelí tabuľky do rôznych úrovní stromu."

msgid "Highlight server under the mouse cursor."
msgstr "Zvýrazní server pod kurzorom myši."

msgid "Whether to show tables under database in the navigation tree"
msgstr "Či sa majú zobrazovať tabuľky pod databázou v navigačnom strome"

msgid "Whether to show views under database in the navigation tree"
msgstr "Či sa majú zobrazovať pohľady pod databázou v navigačnom strome"

msgid "Whether to show events under database in the navigation tree"
msgstr "Či sa majú zobrazovať udalosti pod databázou v navigačnom strome"

msgid "[kbd]SMART[/kbd] - i.e. descending order for columns of type TIME, DATE, DATETIME and TIMESTAMP, ascending order otherwise."
msgstr "[kbd]SMART[/kbd] - t.j. zostupné radenie pre polia typu TIME, DATE, DATETIME a TIMESTAMP, ostatné budú radené vzostupne."

msgid "Disable the default warning that is displayed on the database details Structure page if any of the required tables for the phpMyAdmin configuration storage could not be found."
msgstr "Vypne štandardné varovanie na stránke s detailami databázy, ak niektorá z vyžadovaných tabuliek pre miesto uloženia phpMyAdmin konfigurácie nebola nájdená."

msgid "Disable the default warning that is displayed on the Structure page if column names in a table are reserved MySQL words."
msgstr "Vypnúť štandardné varovanie na stránke so štruktúou tabuľky, ak názvy stĺpcov v tabuľke patria k rezervovaným kľúčovým slovám MySQL."

msgid "Enable if you want DB-based query history (requires phpMyAdmin configuration storage). If disabled, this utilizes JS-routines to display query history (lost by window close)."
msgstr "Povoľte, ak chcete históriu dopytov založenú na databáze (vyžaduje miesto uloženia phpMyAdmin konfigurácie). Ak vowbu zakážete, využijú sa k zobrazeniu histórie dopytoj Java Scriptové funkcie (bude stratená pri zavretí okna)."

msgid "Sets the effective timezone; possibly different than the one from your database server"
msgstr "Nastaví efektívnu časovú zónu; pravdepodobne rôznu od nastavenia vášho databázového servera"

msgid "Leave blank for no [doc@bookmarks@]bookmark[/doc] support, suggested: [kbd]pma__bookmark[/kbd]"
msgstr "Nechajte prázdne pre žiadnu podporu [doc@bookmarks@]záložiek[/doc], navrhované: [kbd]pma__bookmark[/kbd]"

msgid "An alternate host to hold the configuration storage; leave blank to use the already defined host."
msgstr "Alternatívny hostiteľ na ukladanie konfigurácie; ponechajte prázdne, aby sa použil už definovaný hostiteľ."

msgid "An alternate port to connect to the host that holds the configuration storage; leave blank to use the default port, or the already defined port, if the controlhost equals host."
msgstr "Alternatívny port na pripojenie k serveru na ukladanie konfigurácie; ponechajte prázdne na použitie štandardného portu alebo už definovaný port, ak je nastavený server rovnaký ako hostiteľ."

msgid "Leave blank for no SQL query history support, suggested: [kbd]pma__history[/kbd]."
msgstr "Nechajte prázdne pre vypnutie histórie SQL dopytov, navrhované: [kbd]pma__history[/kbd]."

msgid "Limits number of table preferences which are stored in database, the oldest records are automatically removed."
msgstr "Obmedzuje počet nastavení tabuľky, ktoré sú uložené v databáze. Najstaršie záznamy sú automaticky odstraňované."

msgid "Leave blank for no export template support, suggested: [kbd]pma__export_templates[/kbd]."
msgstr "Nechajte prázdne pre vypnutie podpory exportných šablón, navrhované: [kbd]pma__export_templates[/kbd]."

msgid "Leave blank for no central columns support, suggested: [kbd]pma__central_columns[/kbd]."
msgstr "Nechajte prázdne pre vypnutie podpory centrálnych stĺpcov. Odporúčaná hodnota: [kbd]pma__central_columns[/kbd]."

msgid "You can use MySQL wildcard characters (% and _), escape them if you want to use their literal instances, i.e. use [kbd]'my\\_db'[/kbd] and not [kbd]'my_db'[/kbd]."
msgstr "Môžete použiť nahradzujúce znaky (% a _). Pokiaľ ich potrebujete použiť v ich pôvodnom význame, vložte spätné lomítko pred, napríklad [kbd]'moja\\_db'[/kbd] namiesto [kbd]'moja_db'[/kbd]."

msgid "Leave blank for no PDF schema support, suggested: [kbd]pma__pdf_pages[/kbd]."
msgstr "Nechajte prázdne pre vypnutie podpory pre PDF schémy, navrhované: [kbd]pma__pdf_pages[/kbd]."

msgid "Leave blank for no \"persistent\" recently used tables across sessions, suggested: [kbd]pma__recent[/kbd]."
msgstr "Nechajte prázdne pre vypnutie možnosti \"trvalého\" ukladania nedávno použitých tabuliek. Odporúčaná hodnota: [kbd]pma__recent[/kbd]."

msgid "Leave blank for no \"persistent\" favorite tables across sessions, suggested: [kbd]pma__favorite[/kbd]."
msgstr "Nechajte prázdne pre vypnutie možnosti \"trvalého\" ukladania obľúbených tabuliek počas sedenia. Odporúčaná hodnota: [kbd]pma__favorite[/kbd]."

msgid "Leave blank for no PDF schema support, suggested: [kbd]pma__table_coords[/kbd]."
msgstr "Nechajte prázdne pre vypnutie podpory pre PDF schému. Odporúčaná hodnota: [kbd]pma__table_coords[/kbd]."

msgid "Table to describe the display columns, leave blank for no support; suggested: [kbd]pma__table_info[/kbd]."
msgstr "Tabuľka obsahujúca popisy polí. Nechajte prázdnu pre vypnutie tejto funkcie. Odporúčaná hodnota: [kbd]pma__table_info[/kbd]."

msgid "Leave blank for no \"persistent\" tables' UI preferences across sessions, suggested: [kbd]pma__table_uiprefs[/kbd]."
msgstr "Nechajte prázdne pre vypnutie podpory \"trvalého\" ukladania nastavení, navrhované: [kbd]pma__table_uiprefs[/kbd]."

msgid "Whether a DROP DATABASE IF EXISTS statement will be added as first line to the log when creating a database."
msgstr "Či chcete pridať príkaz DROP DATABASE IF EXISTS do logu ako prvý riadok pri vytváraní databázy."

msgid "Whether a DROP TABLE IF EXISTS statement will be added as first line to the log when creating a table."
msgstr "Či chcete pridať príkaz DROP TABLE IF EXISTS do logu ako prvý riadok pri vytváraní tabuľky."

msgid "Whether a DROP VIEW IF EXISTS statement will be added as first line to the log when creating a view."
msgstr "Či chcete pridať príkaz DROP VIEW IF EXISTS do logu ako prvý riadok pri vytváraní pohľadu."

msgid "Defines the list of statements the auto-creation uses for new versions."
msgstr "Určuje zoznam príkazov, ktoré sa automaticky použijú pri vytváraní nových verzií."

msgid "Leave blank for no SQL query tracking support, suggested: [kbd]pma__tracking[/kbd]."
msgstr "Nechajte prázdne pre vypnutie podpory pre sledovanie SQL dopytov. Odporúčaná hodnota: [kbd]pma__tracking[/kbd]."

msgid "Whether the tracking mechanism creates versions for tables and views automatically."
msgstr "Či má sledovací mechanizmus automaticky vytvárať verzie tabuliek a pohľadov."

msgid "Leave blank for no user preferences storage in database, suggested: [kbd]pma__userconfig[/kbd]."
msgstr "Nechajte prázdne pre vypnutie možnosti ukladania užívateľských nastavení v databáze. Odporúčaná hodnota: [kbd]pma__userconfig[/kbd]."

msgid "Leave blank to disable the feature to hide and show navigation items, suggested: [kbd]pma__navigationhiding[/kbd]."
msgstr "Nechajte prázdne pre vypnutie možnosti pre schovávanie navigačných položiek. Odporúčané nastavenie: [kbd]pma__navigationhiding[/kbd]."

msgid "A user-friendly description of this server. Leave blank to display the hostname instead."
msgstr "Užívateľsky prívetivý popis tohto servera. Ak necháte prízdne, zobrazí sa namiesto popisu meno servera."

msgid "Leave blank if not used."
msgstr "Nechajte prázdne pokiaľ nepoužívate."

msgid "Leave blank for defaults."
msgstr "Nechajte prázdne, ak chcete použiť východzie nastavenia."

msgid "HTTP Basic Auth Realm name to display when doing HTTP Auth."
msgstr "Názov pre zobrazenie pri použití HTTP prihlasovania."

msgid "Authentication method to use."
msgstr "Výber použitej prihlasovacej metódy."

msgid "Compress connection to MySQL server."
msgstr "Komprimovať spojenie s MySQL serverom."

msgid "Hide databases matching regular expression (PCRE)."
msgstr "Skryť databázy zodpovedajúce regulárnemu výrazu (PCRE)."

msgid "Hostname where MySQL server is running."
msgstr "Meno počítača, kde beží MySQL server."

msgid "Leave empty if not using config auth."
msgstr "Nechajte prázdne ak nepoužívate prihlasovací config."

msgid "Port on which MySQL server is listening, leave empty for default."
msgstr "Port, na ktorom počúva MySQL server, nechajte prázdne pre východziu hodnotu."

msgid "Socket on which MySQL server is listening, leave empty for default."
msgstr "Socket na ktorom počúva MySQL server, nechajte prázdne pre východziu hodnotu."

msgid "Enable SSL for connection to MySQL server."
msgstr "Povoliť SSL pre pripojenie k MySQL serveru."

msgid "Please note that enabling this has no effect with [kbd]config[/kbd] authentication mode because the password is hard coded in the configuration file; this does not limit the ability to execute the same command directly."
msgstr "Berte prosím na vedomie, že povolenie tejto voľby nemá žiadny vplyv na prihlasovaciu metódu [kbd]config[/kbd], pretože heslo je uložené v konfiguračnom súbore; toto nemá vplyv na možnosť vykonať rovnaký príkaz priamo."

msgid "Show or hide a column displaying the Creation timestamp for all tables."
msgstr "Zobraziť/Skryť stĺpec s Časovou značkou vytvorenia vo všetkých tabuľkách."

msgid "Show or hide a column displaying the Last update timestamp for all tables."
msgstr "Zobraziť/Skryť stĺpec s Časovou značkou poslednej aktualizácie vo všetkých tabuľkách."

msgid "Show or hide a column displaying the Last check timestamp for all tables."
msgstr "Zobraziť/Skryť stĺpec s Časovou značkou poslednej kontroly vo všetkých tabuľkách."

msgid "Defines whether or not type fields should be initially displayed in edit/insert mode."
msgstr "Definuje, či sa majú alebo nemajú zobrazovať typové polia v móde úprav/vkladania."

msgid "Whether a user should be displayed a \"show all (rows)\" button."
msgstr "Či sa bude užívateľovi zobrazovať tlačidlo \"zobraziť všetky (riadky)\"."

msgid "Show or hide a column displaying the comments for all tables."
msgstr "Zobraziť/Skryť stĺpec zobrazujúci komentáre pre všetky tabuľky."

msgid "Display the function fields in edit/insert mode."
msgstr "Zobraziť zoznam funkcií v móde úprav."

msgid "Whether to show hint or not."
msgstr "Či sa má zobrazovať nápoveda alebo nie."

msgid "Defines whether SQL queries generated by phpMyAdmin should be displayed."
msgstr "Určuje, či sa budú zobrazovať SQL dopyty generované phpMyAdminom."

msgid "Mark used tables and make it possible to show databases with locked tables."
msgstr "Označiť použité tabuľky a umožniť zobrazovanie databáz s uzamknutými tabuľkami."

msgid "Disable the default warning that is displayed on the main page if the value of the PHP setting session.gc_maxlifetime is less than the value of `LoginCookieValidity`."
msgstr "Vypnúť štandardné varovanie na hlavnej stránke, ak je hodnota PHP nastavenia session.gc_maxlifetime nižšia ako hodnota `LoginCookieValidity`."

msgid "Textarea size (columns) in edit mode, this value will be emphasized for SQL query textareas (*2)."
msgstr "Veľkosť editačného okna (počet stĺpcov). Táto hodnota bude zväčšená pre okná SQL dopytov (*2)."

msgid "Textarea size (rows) in edit mode, this value will be emphasized for SQL query textareas (*2)."
msgstr "Veľkosť editačného okna (počet riadkov). Táto hodnota bude zväčšená pre okná SQL dopytov (*2)."

msgid "Input proxies as [kbd]IP: trusted HTTP header[/kbd]. The following example specifies that phpMyAdmin should trust a HTTP_X_FORWARDED_FOR (X-Forwarded-For) header coming from the proxy 1.2.3.4:[br][kbd]1.2.3.4: HTTP_X_FORWARDED_FOR[/kbd]."
msgstr "Vložte proxy ako [kbd]IP: dôveryhodná hlavička HTTP[/kbd]. Nasledovný príklad hovorí, že phpMyAdmin má veriť hlavičke HTTP_X_FORWARDED_FOR (X-Forwarded-For) prichádzajúcej z proxy 1.2.3.4:[br][kbd]1.2.3.4: HTTP_X_FORWARDED_FOR[/kbd]."

msgid "When disabled, users cannot set any of the options below, regardless of the checkbox on the right."
msgstr "Pokiaľ je vypnuté, užívatelia nemôžu zmeniť žiadne z nižšie uvedených nastavení, bez ohľadu na zaškrtávacie pole vpravo."

msgid "The username for authenticating with the proxy. By default, no authentication is performed. If a username is supplied, Basic Authentication will be performed. No other types of authentication are currently supported."
msgstr "Užívateľské meno pre prihlásenie k proxy serveru. Štandardne nie je použité žiadne prihlásenie. Ak je zadané užívateľské meno, použije sa základné overenie. Žiadny iný spôsob overovania momentálne nie je podporovaný."

msgid "Highlight selected rows."
msgstr "Zvýrazniť zvolené riadky."

msgid "Highlight row pointed by the mouse cursor."
msgstr "Zvýrazniť riadok označený kurzórom myši."

msgid "Number of columns for CHAR/VARCHAR textareas."
msgstr "Počet stĺpcov techtový oblastí typu CHAR/VARCHAR."

msgid "Number of rows for CHAR/VARCHAR textareas."
msgstr "Počet riadkov textových oblastí typu CHAR/VARCHAR."

msgid "Tab that is displayed when entering a database."
msgstr "Panel, ktorý je zobrazený pri prístupe k databáze."

msgid "Tab that is displayed when entering a server."
msgstr "Panel, ktorý je zobrazený pri prístupe na server."

msgid "Tab that is displayed when entering a table."
msgstr "Panel, ktorý je zobrazený pri prístupe k tabuľke."

msgid "Whether the table structure actions should be hidden."
msgstr "Určuje, či akcie štruktúry tabuliek majú byť skryté."

msgid "Show server listing as a list instead of a drop down."
msgstr "Zobraziť prehľad serverov ako zoznam namiesto rozbaľovacieho menu."

msgid "A dropdown will be used if fewer items are present."
msgstr "Pokiaľ je dostupných menej položiek, bude použitá rozbaľovacia ponuka."

msgid "How many rows can be inserted at one time."
msgstr "Koľko riadkov môže byť vložených naraz."

msgid "Maximum number of characters shown in any non-numeric column on browse view."
msgstr "Maximálny počet znakov zobrazovaných v nečíselných poliach pri prechádzaní."

msgid "Define how long (in seconds) a login cookie is valid."
msgstr "Určuje, ako dlho je platná prihlasovacie cookie (v sekundách)."

msgid "Double size of textarea for LONGTEXT columns."
msgstr "Zdvojnásobiť veľkosť editačného poľa pre stĺpec typu LONGTEXT."

msgid "Maximum number of databases displayed in database list."
msgstr "Maximálny počet databáz zobrazených v zozname databáz."

msgid "Maximum number of tables displayed in table list."
msgstr "Maximálny počet tabuliek zobrazených v zozname tabuliek."

msgid "Maximum number of recently used tables; set 0 to disable."
msgstr "Maximálny počet tabuliek v zozname nedávno zobrazených tabuliek; nastavte 0 pre vypnutie."

msgid "Maximum number of favorite tables; set 0 to disable."
msgstr "Maximálny počet tabuliek v zozname obľúbených tabuliek; nastavte 0 pre vypnutie."

msgid "These are Edit, Copy and Delete links."
msgstr "Toto sú odkazy na Upraviť, Kopírovať a Odstrániť."

msgid "Use natural order for sorting table and database names."
msgstr "Použiť prirodzené triedenie pre mená tabuliek a databáz."

msgid "Use only icons, only text or both."
msgstr "Použiť len ikony, len text alebo obidve."

msgid "Use GZip output buffering for increased speed in HTTP transfers."
msgstr "Použiť vyrovnávaciu pamäť GZip výstupu pre zvýšenie rýchlosti HTTP prenosov."

msgid "Use persistent connections to MySQL databases."
msgstr "Použiť trvalé (persistent) spojenia k MySQL databázam."

msgid "Disallow BLOB and BINARY columns from editing."
msgstr "Zakázať úpravu polí typu BLOB a BINARY."

msgid "How many queries are kept in history."
msgstr "Koľko dopytov sa má držať v histórii."

msgid "Select which functions will be used for character set conversion."
msgstr "Zvoľte, ktorí funkcie budú použité pre konverziu znakových sád."

msgid "When browsing tables, the sorting of each table is remembered."
msgstr "Pri prechádzaní tabuliek, sa pre každú uloží nastavenie triedenia."

msgid "Default sort order for tables with a primary key."
msgstr "Prednastavený spôsob triedenia pre tabuľky s primárnym kľúčom."

msgid "Repeat the headers every X cells, [kbd]0[/kbd] deactivates this feature."
msgstr "Opkovať hlavičku každých X buniek, [kbd]0[/kbd] vypne túto možnosť."

msgid "For display Options"
msgstr "Pre zobrazenie nastavení"

msgid "Directory where exports can be saved on server."
msgstr "Adresár na serveri pre ukladanie exportov."

msgid "Defines whether the query box should stay on-screen after its submission."
msgstr "Určuje či má príkazové okno ostať na obrazovke po vykonaní."

msgid "Title of browser window when a database is selected."
msgstr "Názov okna prehliadača pri výbere databázy."

msgid "Title of browser window when nothing is selected."
msgstr "Názov okna prehliadača keď nie je nič vybrané."

msgid "Title of browser window when a server is selected."
msgstr "Názov okna prehliadača keď je vybraný server."

msgid "Title of browser window when a table is selected."
msgstr "Popis okna prehliadača keď je vybraná tabuľka."

msgid "Directory on server where you can upload files for import."
msgstr "Adresár na serveri, kde môžete nahrať súbor pre import."

msgid "Allow for searching inside the entire database."
msgstr "Povoliť prehľadávať celú databázu."

msgid "Enables check for latest version on main phpMyAdmin page."
msgstr "Povoliť kontrolu poslednej verzie na hlavnej stránke phpMyAdmina."

msgid "The password for authenticating with the proxy."
msgstr "Heslo pre prihlásenie sa k proxy serveru."

msgid "Choose the default action when sending error reports."
msgstr "Zvoľte východziu akciu pri odosielaní hlásení o chybe."

msgid "Allow login to any MySQL server"
msgstr "Povoliť prihlásenie k ľubovoľnému MySQL serveru"

msgid "Restrict login to MySQL server"
msgstr "Obmedziť prihlásenie k MySQL serveru"

msgid "Allow third party framing"
msgstr "Povoliť vkladanie do cudzieho rámu"

msgid "Show \"Drop database\" link to normal users"
msgstr "Zobraziť príkaz \"Zrušiť databázu\" bežným užívateľom"

msgid "Blowfish secret"
msgstr "Šifrovacia fráza Blowfish"

msgid "Row marker"
msgstr "Značkovač riadkov"

msgid "Highlight pointer"
msgstr "Zvýrazňovač"

msgid "Bzip2"
msgstr "BZip2"

msgid "CHAR columns editing"
msgstr "Úprava polí typu CHAR"

msgid "Enable CodeMirror"
msgstr "Povoliť CodeMirror"

msgid "Enable linter"
msgstr "Povoliť kontrolovanie SQL"

msgid "Minimum size for input field"
msgstr "Minimálna veľkosť vstupného poľa"

msgid "Maximum size for input field"
msgstr "Maximálna veľkosť vstupného poľa"

msgid "CHAR textarea columns"
msgstr "Stĺpce techtovej oblasti typu CHAR"

msgid "CHAR textarea rows"
msgstr "Riadky pre textové oblasti CHAR"

msgid "Check config file permissions"
msgstr "Skontrolujte prístupové práva konfiguračného súboru"

msgid "Compress on the fly"
msgstr "Komprimovať za behu"

msgid "Confirm DROP queries"
msgstr "Potvrdzovať DROP dopyty"

msgid "Paper size"
msgstr "Veľkosť stránky"

msgid "Default database tab"
msgstr "Prednastavený panel databázy"

msgid "Default server tab"
msgstr "Východzí panel servera"

msgid "Default table tab"
msgstr "Východzí panel tabuľky"

msgid "Enable autocomplete for table and column names"
msgstr "Povoliť automatické dopĺňanie názvov tabuliek a stĺpcov"

msgid "Show column comments"
msgstr "Zobraziť komentáre stĺpca"

msgid "Hide table structure actions"
msgstr "Skryť akcie štruktúry tabuľky"

msgid "Display servers as a list"
msgstr "Zobraziť servery ako zoznam"

msgid "Disable multi table maintenance"
msgstr "Vypnúť hromadné operácie s tabuľkami"

msgid "Maximum execution time"
msgstr "Maximálny čas behu"

msgid "Save as file"
msgstr "Uložiť ako súbor"

msgid "Character set of the file"
msgstr "Znaková sada súboru"

msgid "Compression"
msgstr "Kompresia"

msgid "Put columns names in the first row"
msgstr "Pridať názvy polí na prvý riadok"

msgid "Columns enclosed with"
msgstr "Polia uzatvorené do"

msgid "Columns escaped with"
msgstr "Polia uvedené pomocou"

msgid "Replace NULL with"
msgstr "Nahradiť NULL hodnoty"

msgid "Remove CRLF characters within columns"
msgstr "Odstrániť konce riadkov (CRLF) z polí"

msgid "Columns terminated with"
msgstr "Stĺpce ukončené"

msgid "Lines terminated with"
msgstr "Riadky ukončené"

msgid "Excel edition"
msgstr "Verzia Excelu"

msgid "Database name template"
msgstr "Vzor pre názov databázy"

msgid "Server name template"
msgstr "Vzor pre názov servera"

msgid "Table name template"
msgstr "Vzor pre názov tabuľky"

msgid "Dump table"
msgstr "Vypísať tabuľku"

msgid "Include table caption"
msgstr "Zahrnúť nadpis tabuľky"

msgid "Table caption"
msgstr "Nadpis tabuľky"

msgid "Continued table caption"
msgstr "Nadpis pokračovania tabuľky"

msgid "Label key"
msgstr "Návestie"

msgid "Export method"
msgstr "Metóda exportu"

msgid "Save on server"
msgstr "Uložiť na server"

msgid "Export as separate files"
msgstr "Exportovať ako samostatné súbory"

msgid "Enclose table and column names with backquotes"
msgstr "Použiť opačný apostrof pri názvoch tabuliek a polí"

msgid "SQL compatibility mode"
msgstr "Režim kompatibility SQL"

msgid "Creation/Update/Check dates"
msgstr "Dátum vytvorenia, poslednej zmeny a kontroly"

msgid "Use delayed inserts"
msgstr "Použiť oneskorené vloženia"

