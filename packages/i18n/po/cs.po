msgid "PM"
msgstr "odp."

msgctxt "AM/PM indication in time"
msgid "AM"
msgstr "dop."

msgid "%s days, %s hours, %s minutes and %s seconds"
msgstr "%s dnů, %s hodin, %s minut a %s sekund"

msgid "Users"
msgstr "Uživatelé"

