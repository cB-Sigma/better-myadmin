msgid "Date and time"
msgstr "Datum a čas"

msgctxt "spatial types"
msgid "Spatial"
msgstr "Prostorové"

msgid "Password is too long!"
msgstr "Heslo je příliš dlouhé!"

msgid "The profile has been updated."
msgstr "Přístup byl změněn."

msgid "Max: %s%s"
msgstr "Maximální velikost: %s%s"

