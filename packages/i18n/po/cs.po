msgstr "Položka byla smazána z oblíbených."

msgid "No data was received to import. Either no file name was submitted, or the file size exceeded the maximum size permitted by your PHP configuration. See [doc@faq1-16]FAQ 1.16[/doc]."
msgstr "Nepodařilo se načíst žádná data k importu. Buď nebyl odeslán žádný soubor, nebo jeho velikost překročila maximální velikost povolenou v nastavení PHP. Viz [doc@faq1-16]FAQ 1.16[/doc]."

msgid "Import has been successfully finished, %d query executed."
