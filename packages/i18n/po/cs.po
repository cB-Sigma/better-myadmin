msgstr "Databáze %1$s byla přejmenována na %2$s."

msgid "Database %1$s has been copied to %2$s."
msgstr "Databáze %1$s byla zkopírována do %2$s."

msgid "The phpMyAdmin configuration storage has been deactivated. %sFind out why%s."
msgstr "Některé z rozšířených funkcí phpMyAdmina nelze používat. %sZjistěte proč%s."

