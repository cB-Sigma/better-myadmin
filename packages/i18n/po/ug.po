msgstr "تېما %s تېپىلمىدى!"

msgid "Tracking data definition successfully deleted"
msgstr "ئىز قوغلاش سانلىق مەلۇمات ئېنىقلىمىسى مۇۋەپپەقىيەتلىك ئۆچۈرۈلدى"

msgid "Tracking data manipulation successfully deleted"
msgstr "سانلىق مەلۇماتلارنى كونترول قىلىش مۇۋەپپەقىيەتلىك ئۆچۈرۈلدى"

msgid "Data definition statement"
msgstr "سانلىق مەلۇمات ئېنىقلىمىسى"

msgid "Data manipulation statement"
msgstr "سانلىق مەلۇماتلارنى كونترول قىلىش باياناتى"

msgid "Tracking statements"
msgstr "ئىز قوغلاش بايانلىرى"

msgid "No data"
msgstr "سانلىق مەلۇمات يوق"

