msgid "These functions are meant to return a binary result; to avoid inconsistent results you should store it in a BINARY, VARBINARY, or BLOB column."
msgstr "بۇ ئىقتىدارلار ئىككىلىك نەتىجىنى قايتۇرۇشنى مەقسەت قىلىدۇ. ماس كەلمەيدىغان نەتىجىدىن ساقلىنىش ئۈچۈن ئۇنى ئىككىلىك ، VARBINARY ياكى BLOB ستوندا ساقلىشىڭىز كېرەك."

msgid "About %MIN min. %SEC sec. remaining."
msgstr "تەخمىنەن% MIN min. % SEC سېكۇنت. قالغان."

msgid "About %SEC sec. remaining."
msgstr "تەخمىنەن% SEC سېكۇنت. قالغان."

msgid "The file is being processed, please be patient."
msgstr "بىتەرەپ قىلىنىۋاتىدۇ، ساقلاڭ."

msgid "Please be patient, the file is being uploaded. Details about the upload are not available."
msgstr "يوللىنىۋاتىدۇ،تەپسىلىي ئۇچۇرى يوق،ساقلاڭ."

msgid "Fatal error: The navigation can only be accessed via AJAX"
msgstr "ئەجەللىك خاتالىق: يول باشلاشنى پەقەت AJAX ئارقىلىقلا زىيارەت قىلغىلى بولىدۇ"

msgid "No collation provided."
msgstr "ھېچقانداق يىغىش تەمىنلەنمىگەن."

msgid "Cannot copy database to the same name. Change the name and try again."
msgstr "ئوخشاش ئىسىمغا سانداننى كۆچۈرگىلى بولمايدۇ. ئىسىمنى ئۆزگەرتىپ قايتا سىناڭ."

msgid "Paste it to your config.inc.php"
msgstr "ئۇنى config.inc.php غا چاپلاڭ"

msgid "Database %1$s has been created."
msgstr "%1$s ساندان غەلبىلىك قۇرۇلدى."

msgid "Username and hostname didn't change. If you only want to change the password, 'Change password' tab should be used."
msgstr "ئىشلەتكۈچى ئىسمى ۋە ساھىبجامال ئۆزگەرمىدى. ئەگەر پارولنى ئۆزگەرتمەكچى بولسىڭىز ، «پارولنى ئۆزگەرتىش» بەتكۈچىنى ئىشلىتىش كېرەك."

msgid "Received"
msgstr "قوبۇل قىلىندى"

msgid "Sent"
msgstr "ئەۋەتىلدى"

msgid "Failed attempts"
msgstr "مەغلۇب بولدى"

msgid "The number of connections that were aborted because the client died without closing the connection properly."
msgstr "خېرىدار ئۇلىنىشنى توغرا تاقىمايلا قازا قىلغانلىقى ئۈچۈن ئەمەلدىن قالدۇرۇلغان ئۇلىنىش سانى."

msgid "The number of failed attempts to connect to the MySQL server."
msgstr "MySQL مۇلازىمېتىرىغا ئۇلىنىش مەغلۇب بولغانلارنىڭ سانى."

msgid "The number of transactions that used the temporary binary log cache but that exceeded the value of binlog_cache_size and used a temporary file to store statements from the transaction."
msgstr "ۋاقىتلىق ئىككىلىك خاتىرە ساقلىغۇچنى ئىشلەتكەن ، ئەمما binlog_cache_size نىڭ قىممىتىدىن ئېشىپ كەتكەن ۋە ۋاقىتلىق ھۆججەت ئىشلىتىپ سودىدىكى بايانلارنى ساقلىغان سودا سانى."

msgid "The number of transactions that used the temporary binary log cache."
msgstr "ۋاقىتلىق ئىككىلىك خاتىرە ساقلىغۇچنى ئىشلەتكەن سودا سانى."

msgid "The number of connection attempts (successful or not) to the MySQL server."
msgstr "MySQL مۇلازىمېتىرىغا ئۇلىنىش قېتىم سانى (مۇۋەپپەقىيەتلىك ياكى ئەمەس)."

msgid "The number of temporary tables on disk created automatically by the server while executing statements. If Created_tmp_disk_tables is big, you may want to increase the tmp_table_size  value to cause temporary tables to be memory-based instead of disk-based."
msgstr "دىسكىدىكى ۋاقىتلىق جەدۋەل سانى مۇلازىمېتىر تەرىپىدىن ئاپتوماتىك ئىجرا قىلىنغان. ئەگەر Created_tmp_disk_tables چوڭ بولسا ، tmp_table_size قىممىتىنى ئۆستۈرۈپ ، ۋاقىتلىق جەدۋەلنىڭ دىسكىنى ئاساس قىلماستىن ، ئىچكى ساقلىغۇچنى ئاساس قىلىشىنى كەلتۈرۈپ چىقىرىشىڭىز مۇمكىن."

msgid "How many temporary files mysqld has created."
msgstr "Mysqld قانچە ۋاقىتلىق ھۆججەت قۇردى."

msgid "The number of in-memory temporary tables created automatically by the server while executing statements."
msgstr "باياناتنى ئىجرا قىلغاندا مۇلازىمېتىر ئاپتوماتىك قۇرغان ئىچكى ساقلىغۇچ ۋاقىتلىق جەدۋەل سانى."

msgid "The number of rows written with INSERT DELAYED for which some error occurred (probably duplicate key)."
msgstr "INSERT DELAYED بىلەن يېزىلغان قۇر سانى ، بەزى خاتالىقلار يۈز بەرگەن (كۆپەيتىلگەن ئاچقۇچ بولۇشى مۇمكىن)."

msgid "The number of INSERT DELAYED handler threads in use. Every different table on which one uses INSERT DELAYED gets its own thread."
msgstr "ئىشلىتىلىۋاتقان INSERT DELAYED بىر تەرەپ قىلغۇچنىڭ سانى. INSERT DELAYED ئىشلىتىدىغان ھەر بىر جەدۋەلنىڭ ئۆزىگە خاس تېمىسى بولىدۇ."

msgid "The number of INSERT DELAYED rows written."
msgstr "INSERT DELAYED قۇرلارنىڭ سانى."

msgid "The number of executed FLUSH statements."
msgstr "ئىجرا قىلىنغان FLUSH بايانلىرىنىڭ سانى."

msgid "The number of internal COMMIT statements."
msgstr "ئىچكى COMMIT بايانلىرىنىڭ سانى."

msgid "The number of times a row was deleted from a table."
msgstr "جەدۋەلدىن بىر قانچە قېتىم ئۆچۈرۈلگەن."

msgid "The MySQL server can ask the NDB Cluster storage engine if it knows about a table with a given name. This is called discovery. Handler_discover indicates the number of time tables have been discovered."
msgstr "MySQL مۇلازىمېتىرى NDB Cluster ساقلاش ماتورىدىن مەلۇم ئىسىم قويۇلغان جەدۋەلنى بىلسە سورىسا بولىدۇ. بۇ بايقاش دەپ ئاتىلىدۇ. Handler_discover ۋاقىت جەدۋىلىنىڭ بايقالغانلىقىنى كۆرسىتىدۇ."

msgid "The number of times the first entry was read from an index. If this is high, it suggests that the server is doing a lot of full index scans; for example, SELECT col1 FROM foo, assuming that col1 is indexed."
msgstr "كۆرسەتكۈچتىن تۇنجى قېتىم ئوقۇش قېتىم سانى. ئەگەر بۇ يۇقىرى بولسا ، بۇ مۇلازىمېتىرنىڭ نۇرغۇن كۆرسەتكۈچ سايىلىرىنى قىلىۋاتقانلىقىنى كۆرسىتىپ بېرىدۇ. مەسىلەن ، col1 نى مۇندەرىجە دەپ پەرەز قىلىش."

msgid "The number of requests to read a row based on a key. If this is high, it is a good indication that your queries and tables are properly indexed."
msgstr "بىر كۇنۇپكىنى ئاساس قىلىپ قۇر ئوقۇش تەلىپى. ئەگەر بۇ يۇقىرى بولسا ، سوئاللىرىڭىز ۋە جەدۋەللىرىڭىزنىڭ مۇۋاپىق مۇندەرىجە قىلىنغانلىقىنىڭ ياخشى ئىپادىسى."

msgid "The number of requests to read the next row in key order. This is incremented if you are querying an index column with a range constraint or if you are doing an index scan."
msgstr "كېيىنكى قۇرنى ئاچقۇچلۇق تەرتىپتە ئوقۇش تەلىپى. ئەگەر دائىرە چەكلىمىسى بار كۆرسەتكۈچ ئىستونىنى تەلەپ قىلسىڭىز ياكى كۆرسەتكۈچ سايىلىۋاتقان بولسىڭىز بۇ كۆپىيىدۇ."

msgid "The number of requests to read the previous row in key order. This read method is mainly used to optimize ORDER BY … DESC."
msgstr "ئالدىنقى رەتنى ئاچقۇچلۇق تەرتىپتە ئوقۇش تەلىپى. بۇ ئوقۇش ئۇسۇلى ئاساسلىقى OR DESC ئارقىلىق ORDER نى ئەلالاشتۇرۇشتا ئىشلىتىلىدۇ."

msgid "The number of requests to read a row based on a fixed position. This is high if you are doing a lot of queries that require sorting of the result. You probably have a lot of queries that require MySQL to scan whole tables or you have joins that don't use keys properly."
msgstr "مۇقىم ئورۇنغا ئاساسەن بىر قۇر ئوقۇش تەلىپى. ئەگەر نەتىجىنى رەتلەشنى تەلەپ قىلىدىغان نۇرغۇن سوئاللارنى قىلىۋاتقان بولسىڭىز ، بۇ يۇقىرى. سىزدە MySQL نىڭ بارلىق جەدۋەللەرنى سايىلەشنى تەلەپ قىلىدىغان نۇرغۇن سوئاللىرىڭىز بولۇشى مۇمكىن ياكى ئاچقۇچنى توغرا ئىشلەتمەيدىغان ئۇلىنىشلىرىڭىز بولۇشى مۇمكىن."

msgid "The number of requests to read the next row in the data file. This is high if you are doing a lot of table scans. Generally this suggests that your tables are not properly indexed or that your queries are not written to take advantage of the indexes you have."
msgstr "سانلىق مەلۇمات ھۆججىتىدىكى كېيىنكى قۇرنى ئوقۇش تەلىپى. ئەگەر سىز نۇرغۇن ئۈستەل سايىلىرىنى قىلىۋاتقان بولسىڭىز ، بۇ يۇقىرى. ئادەتتە بۇ جەدۋەللىرىڭىزنىڭ مۇۋاپىق مۇندەرىجە قىلىنمىغانلىقىنى ياكى سوئاللىرىڭىزنىڭ سىزدىكى كۆرسەتكۈچلەردىن پايدىلىنىش ئۈچۈن يېزىلمىغانلىقىنى كۆرسىتىپ بېرىدۇ."

msgid "The number of internal ROLLBACK statements."
msgstr "ئىچكى ROLLBACK بايانلىرىنىڭ سانى."

msgid "The number of requests to update a row in a table."
msgstr "جەدۋەلدە بىر قۇر يېڭىلاش تەلىپى."

msgid "The number of requests to insert a row in a table."
msgstr "جەدۋەلگە بىر قۇر قىستۇرۇش تەلىپى."

msgid "The number of pages containing data (dirty or clean)."
msgstr "سانلىق مەلۇماتلارنى ئۆز ئىچىگە ئالغان بەت سانى (مەينەت ياكى پاكىز)."

msgid "The number of pages currently dirty."
msgstr "نۆۋەتتە بەت سانى."

msgid "The number of buffer pool pages that have been requested to be flushed."
msgstr "يۇيۇشنى تەلەپ قىلغان بۇففېر كۆلچەك بېتىنىڭ سانى."

msgid "The number of free pages."
msgstr "ھەقسىز بەت سانى."

msgid "The number of latched pages in InnoDB buffer pool. These are pages currently being read or written or that can't be flushed or removed for some other reason."
msgstr "InnoDB بۇففېر كۆلچىكىدىكى يېپىق بەتلەرنىڭ سانى. بۇلار ھازىر ئوقۇلىۋاتقان ياكى يېزىلغان ياكى باشقا سەۋەبلەر تۈپەيلىدىن قىزىرىپ ياكى ئۆچۈرگىلى بولمايدىغان بەتلەر."

msgid "The number of pages busy because they have been allocated for administrative overhead such as row locks or the adaptive hash index. This value can also be calculated as Innodb_buffer_pool_pages_total - Innodb_buffer_pool_pages_free - Innodb_buffer_pool_pages_data."
msgstr "بەت قۇلۇپى ئالدىراش ، چۈنكى ئۇلار قۇر قۇلۇپ ياكى ماسلىشىشچان Hash كۆرسەتكۈچى قاتارلىق مەمۇرىي ئۈستۈنكى ئورۇنغا تەقسىم قىلىنغان. بۇ قىممەتنى يەنە Innodb_buffer_pool_pages_total - Innodb_buffer_pool_pages_free - Innodb_buffer_pool_pages_data دەپ ھېسابلاشقا بولىدۇ."

msgid "Total size of buffer pool, in pages."
msgstr "بۇففېر كۆلچىكىنىڭ ئومۇمىي چوڭلۇقى ، بەتلەردە."

msgid "The number of \"random\" read-aheads InnoDB initiated. This happens when a query is to scan a large portion of a table but in random order."
msgstr "InnoDB قوزغىتىلغان «ئىختىيارى» ئوقۇش سانى. بۇ سوئال جەدۋەلنىڭ كۆپ قىسمىنى سىكانېرلاش ، ئەمما ئىختىيارى تەرتىپ بويىچە بولغاندا يۈز بېرىدۇ."

msgid "The number of sequential read-aheads InnoDB initiated. This happens when InnoDB does a sequential full table scan."
msgstr "InnoDB قوزغىتىلغان تەرتىپلىك ئوقۇش سانى. بۇ InnoDB تەرتىپلىك تولۇق جەدۋەلنى تەكشۈرگەندە يۈز بېرىدۇ."

msgid "The number of logical read requests InnoDB has done."
msgstr "InnoDB قىلغان لوگىكىلىق ئوقۇش تەلەپلىرىنىڭ سانى."

msgid "The number of logical reads that InnoDB could not satisfy from buffer pool and had to do a single-page read."
msgstr "InnoDB بۇففېر كۆلچىكىدىن قاندۇرالمايدىغان لوگىكىلىق ئوقۇش سانى ۋە بىر بەتلىك ئوقۇش كېرەك."

msgid "Normally, writes to the InnoDB buffer pool happen in the background. However, if it's necessary to read or create a page and no clean pages are available, it's necessary to wait for pages to be flushed first. This counter counts instances of these waits. If the buffer pool size was set properly, this value should be small."
msgstr "ئادەتتە ، InnoDB بۇففېر كۆلچىكىگە ئارقا سۇپىدا يۈز بېرىدۇ. قانداقلا بولمىسۇن ، بىر بەتنى ئوقۇش ياكى قۇرۇشقا توغرا كەلسە ھەمدە پاكىز بەتلەر بولمىسا ، ئالدى بىلەن بەتلەرنىڭ قىزىرىشىنى ساقلاش كېرەك. بۇ ھېسابلىغۇچ بۇ كۈتۈش ئەھۋاللىرىنى سانايدۇ. ئەگەر بۇففېر كۆلچىكىنىڭ چوڭ-كىچىكلىكى مۇۋاپىق تەڭشەلگەن بولسا ، بۇ قىممەت كىچىك بولۇشى كېرەك."

msgid "The number writes done to the InnoDB buffer pool."
msgstr "بۇ سان InnoDB بۇففېر كۆلچىكىگە يېزىلغان."

msgid "The number of fsync() operations so far."
msgstr "ھازىرغىچە fsync () مەشغۇلات سانى."

msgid "The current number of pending fsync() operations."
msgstr "ساقلىنىۋاتقان fsync () مەشغۇلاتلىرىنىڭ نۆۋەتتىكى سانى."

msgid "The current number of pending reads."
msgstr "ساقلىنىۋاتقان ئوقۇش سانى."

msgid "The current number of pending writes."
msgstr "ساقلىنىۋاتقان يازمىلارنىڭ سانى."

msgid "The amount of data read so far, in bytes."
msgstr "ھازىرغىچە ئوقۇغان سانلىق مەلۇماتلارنىڭ سانى بايت."

msgid "The total number of data reads."
msgstr "ئوقۇلىدىغان سانلىق مەلۇماتلارنىڭ ئومۇمىي سانى."

msgid "The total number of data writes."
msgstr "يازغان سانلىق مەلۇماتلارنىڭ ئومۇمىي سانى."

msgid "The amount of data written so far, in bytes."
msgstr "ھازىرغىچە يېزىلغان سانلىق مەلۇماتلارنىڭ سانى ، بايت."

msgid "The number of pages that have been written for doublewrite operations."
msgstr "قوش يېزىش مەشغۇلاتى ئۈچۈن يېزىلغان بەت سانى."

msgid "The number of doublewrite operations that have been performed."
msgstr "ئېلىپ بېرىلغان قوش يېزىش مەشغۇلاتىنىڭ سانى."

msgid "The number of waits we had because log buffer was too small and we had to wait for it to be flushed before continuing."
msgstr "كۈتۈش قېتىم سانى بەك كۆپ بولغاچقا ، ساقلاش ۋاقتىمىز بەك ئاز بولغاچقا ، داۋاملاشتۇرۇشتىن بۇرۇن ئۇنىڭ قىزىرىپ كېتىشىنى ساقلاشقا مەجبۇر بولدۇق."

msgid "The number of log write requests."
msgstr "خاتىرە يېزىش تەلىپى."

msgid "The number of physical writes to the log file."
msgstr "خاتىرە ھۆججىتىگە فىزىكىلىق يېزىلغانلارنىڭ سانى."

msgid "The number of fsync() writes done to the log file."
msgstr "خاتىرە ھۆججىتىگە قىلىنغان fsync () نىڭ سانى."

msgid "The number of pending log file fsyncs."
msgstr "ساقلىنىۋاتقان خاتىرە ھۆججەت fsyncs نىڭ سانى."

msgid "Pending log file writes."
msgstr "ساقلىنىۋاتقان خاتىرە ھۆججىتى."

msgid "The number of bytes written to the log file."
msgstr "خاتىرە ھۆججىتىگە يېزىلغان بايت سانى."

msgid "The number of pages created."
msgstr "قۇرۇلغان بەت سانى."

msgid "The compiled-in InnoDB page size (default 16KB). Many values are counted in pages; the page size allows them to be easily converted to bytes."
msgstr "تۈزۈلگەن InnoDB بەت چوڭلۇقى (سۈكۈتتىكى 16KB). نۇرغۇن قىممەتلەر بەتلەردە ھېسابلىنىدۇ. بەت چوڭلۇقى ئۇلارنى ئاسانلا بايتقا ئايلاندۇرالايدۇ."

msgid "The number of pages read."
msgstr "ئوقۇغان بەت سانى."

msgid "The number of pages written."
msgstr "يېزىلغان بەت سانى."

msgid "The number of row locks currently being waited for."
msgstr "ھازىر ساقلىنىۋاتقان قۇر قۇلۇپ سانى."

msgid "The average time to acquire a row lock, in milliseconds."
msgstr "بىر قۇر قۇلۇپقا ئېرىشىشنىڭ ئوتتۇرىچە ۋاقتى ، سېكۇنتتا."

msgid "The total time spent in acquiring row locks, in milliseconds."
msgstr "قۇر قۇلۇپ سېتىۋېلىشقا سەرپ قىلىنغان ئومۇمىي ۋاقىت ، سېكۇنتتا."

msgid "The maximum time to acquire a row lock, in milliseconds."
msgstr "بىر قۇر قۇلۇپقا ئېرىشىشنىڭ ئەڭ يۇقىرى ۋاقتى ، سېكۇنتتا."

msgid "The number of times a row lock had to be waited for."
msgstr "بىر قۇر قۇلۇپنى قانچە قېتىم ساقلاشقا توغرا كەلدى."

msgid "The number of rows deleted from InnoDB tables."
msgstr "InnoDB جەدۋىلىدىن ئۆچۈرۈلگەن قۇر سانى."

msgid "The number of rows inserted in InnoDB tables."
msgstr "InnoDB جەدۋىلىگە قىستۇرۇلغان قۇر سانى."

msgid "The number of rows read from InnoDB tables."
msgstr "InnoDB جەدۋىلىدىن ئوقۇلغان قۇر سانى."

msgid "The number of rows updated in InnoDB tables."
msgstr "InnoDB جەدۋىلىدە يېڭىلانغان قۇر سانى."

msgid "The number of key blocks in the key cache that have changed but haven't yet been flushed to disk. It used to be known as Not_flushed_key_blocks."
msgstr "ئۆزگەرتىلگەن ، ئەمما دىسكىغا يۆتكەلمىگەن ئاچقۇچ غەملەكتىكى ئاچقۇچلارنىڭ سانى. ئۇ ئىلگىرى Not_flushed_key_blocks دەپ ئاتالغان."

msgid "The number of unused blocks in the key cache. You can use this value to determine how much of the key cache is in use."
msgstr "ئاچقۇچ غەملەكتە ئىشلىتىلمىگەن بۆلەكلەرنىڭ سانى. بۇ قىممەت ئارقىلىق ئاچقۇچ غەملەكنىڭ قانچىلىك ئىشلىتىلىۋاتقانلىقىنى ئېنىقلىيالايسىز."

msgid "The number of used blocks in the key cache. This value is a high-water mark that indicates the maximum number of blocks that have ever been in use at one time."
msgstr "ئاچقۇچ غەملەكتە ئىشلىتىلگەن بۆلەك سانى. بۇ قىممەت يۇقىرى سۇ بەلگىسى بولۇپ ، بىر قېتىمدا ئىشلىتىلگەن ئەڭ كۆپ چەكلىمىلەرنى كۆرسىتىدۇ."

msgid "The number of requests to read a key block from the cache."
msgstr "غەملەكتىكى ئاچقۇچلۇق بۆلەكنى ئوقۇش تەلىپى."

msgid "The number of physical reads of a key block from disk. If Key_reads is big, then your key_buffer_size value is probably too small. The cache miss rate can be calculated as Key_reads/Key_read_requests."
msgstr "دىسكىدىكى ئاچقۇچلۇق بۆلەكنىڭ فىزىكىلىق ئوقۇش سانى. ئەگەر Key_reads چوڭ بولسا ، سىزنىڭ key_buffer_size قىممىتىڭىز بەك كىچىك بولۇشى مۇمكىن. غەملەكنى يوقىتىش نىسبىتىنى Key_reads / Key_read_requests دەپ ھېسابلىغىلى بولىدۇ."

msgid "Key cache miss calculated as rate of physical reads compared to read requests (calculated value)"
msgstr "ئوقۇش تەلەپلىرى (ھېسابلانغان قىممەت) گە سېلىشتۇرغاندا فىزىكىلىق ئوقۇش نىسبىتى بويىچە ھېسابلىنىدۇ."

msgid "The number of requests to write a key block to the cache."
msgstr "غەملەككە ئاچقۇچلۇق بۆلەك يېزىش تەلىپى."

msgid "The number of physical writes of a key block to disk."
msgstr "دىسكىغا ئاچقۇچلۇق بۆلەكنىڭ فىزىكىلىق يېزىلغان سانى."

msgid "Percentage of physical writes compared to write requests (calculated value)"
msgstr "يېزىش تەلىپىگە سېلىشتۇرغاندا فىزىكىلىق يېزىقنىڭ نىسبىتى (ھېسابلانغان قىممەت)"

msgid "The total cost of the last compiled query as computed by the query optimizer. Useful for comparing the cost of different query plans for the same query. The default value of 0 means that no query has been compiled yet."
msgstr "سوئال ئەلالاشتۇرغۇچى تەرىپىدىن ھېسابلانغان ئاخىرقى تۈزۈلگەن سوئالنىڭ ئومۇمىي خىراجىتى. ئوخشاش بىر سوئالنىڭ ئوخشىمىغان سوئال پىلانىنىڭ تەننەرخىنى سېلىشتۇرۇشقا پايدىلىق. سۈكۈتتىكى قىممىتى 0 ھېچقانداق سوئالنىڭ تېخى تۈزۈلمىگەنلىكىدىن دېرەك بېرىدۇ."

msgid "The maximum number of connections that have been in use simultaneously since the server started."
msgstr "مۇلازىمېتىر باشلانغاندىن بۇيان بىرلا ۋاقىتتا ئىشلىتىلىۋاتقان ئۇلىنىشلارنىڭ ئەڭ كۆپ سانى."

msgid "The number of rows waiting to be written in INSERT DELAYED queues."
msgstr "INSERT كېچىكىپ ئۆچىرەتتە يېزىلىشنى ساقلاۋاتقان قۇر سانى."

msgid "The number of tables that have been opened. If opened tables is big, your table_open_cache value is probably too small."
msgstr "ئېچىلغان جەدۋەل سانى. ئېچىلغان جەدۋەللەر چوڭ بولسا ، جەدۋەل_ ئېچىش_ ساقلىغۇچ قىممىتىڭىز بەك كىچىك بولۇشى مۇمكىن."

msgid "The number of files that are open."
msgstr "ئېچىلغان ھۆججەتلەرنىڭ سانى."

msgid "The number of streams that are open (used mainly for logging)."
msgstr "ئېچىلغان ئېقىنلارنىڭ سانى (ئاساسلىقى دەرەخ كېسىشكە ئىشلىتىلىدۇ)."

msgid "The number of tables that are open."
msgstr "ئېچىلغان جەدۋەل سانى."

msgid "The number of free memory blocks in query cache. High numbers can indicate fragmentation issues, which may be solved by issuing a FLUSH QUERY CACHE statement."
msgstr "سوئال ساقلىغۇچتىكى ھەقسىز ئىچكى ساقلىغۇچنىڭ سانى. يۇقىرى سانلار پارچىلىنىش مەسىلىلىرىنى كۆرسىتىپ بېرەلەيدۇ ، بۇ FLUSH QUERY CACHE باياناتىنى ئېلان قىلىش ئارقىلىق ھەل قىلىنىشى مۇمكىن."

msgid "The amount of free memory for query cache."
msgstr "سوئال ساقلىغۇچ ئۈچۈن ھەقسىز ئىچكى ساقلىغۇچنىڭ مىقدارى."

msgid "The number of cache hits."
msgstr "غەملەك سانى."

msgid "The number of queries added to the cache."
msgstr "غەملەككە قوشۇلغان سوئاللارنىڭ سانى."

msgid "The number of queries that have been removed from the cache to free up memory for caching new queries. This information can help you tune the query cache size. The query cache uses a least recently used (LRU) strategy to decide which queries to remove from the cache."
msgstr "يېڭى سوئاللارنى ساقلاشقا ئىچكى ساقلىغۇچنى بوشاشتۇرۇش ئۈچۈن غەملەكتىن چىقىرىۋېتىلگەن سوئاللارنىڭ سانى. بۇ ئۇچۇرلار سوئال غەملەكنىڭ چوڭ-كىچىكلىكىنى تەڭشەشكە ياردەم بېرىدۇ. بۇ سوئال غەملەك ئەڭ ئاز ئىشلىتىلگەن (LRU) ئىستراتېگىيىسىنى ئىشلىتىپ ، قايسى سوئاللارنى غەملەكتىن چىقىرىۋېتىشنى قارار قىلىدۇ."

msgid "The number of non-cached queries (not cachable, or not cached due to the query_cache_type setting)."
msgstr "غەملەكسىز سوئاللارنىڭ سانى (سۈرۈشتۈرۈشكە بولمايدۇ ياكى query_cache_type تەڭشىكى سەۋەبىدىن غەملەك قىلىنمايدۇ)."

msgid "The number of queries registered in the cache."
msgstr "غەملەكتە تىزىمغا ئېلىنغان سوئاللارنىڭ سانى."

msgid "The total number of blocks in the query cache."
msgstr "سوئال غەملەكتىكى ئومۇمىي چەك سانى."

msgid "The status of failsafe replication (not yet implemented)."
msgstr "بىخەتەر كۆپەيتىش ھالىتى (تېخى يولغا قويۇلمىدى)."

msgid "The number of joins that do not use indexes. If this value is not 0, you should carefully check the indexes of your tables."
msgstr "كۆرسەتكۈچ ئىشلەتمەيدىغان قوشۇلىدىغانلارنىڭ سانى. ئەگەر بۇ قىممەت 0 بولمىسا ، جەدۋەللىرىڭىزنىڭ كۆرسەتكۈچلىرىنى ئەستايىدىل تەكشۈرۈڭ."

msgid "The number of joins that used a range search on a reference table."
msgstr "پايدىلىنىش جەدۋىلىدە دائىرە ئىزدەشكە ئىشلىتىدىغان ئۇلىنىش سانى."

msgid "The number of joins without keys that check for key usage after each row. (If this is not 0, you should carefully check the indexes of your tables.)"
msgstr "ھەر بىر قۇردىن كېيىن ئاچقۇچنىڭ ئىشلىتىلىشىنى تەكشۈرەلەيدىغان ئاچقۇچسىز ئۇلىنىش سانى. (ئەگەر بۇ 0 بولمىسا ، جەدۋەللىرىڭىزنىڭ كۆرسەتكۈچلىرىنى ئەستايىدىل تەكشۈرۈڭ.)"

msgid "The number of joins that used ranges on the first table. (It's normally not critical even if this is big.)"
msgstr "ئىشلىتىلگەن جەدۋەلنىڭ سانى بىرىنچى جەدۋەلدە. (بۇ چوڭ بولسىمۇ ئادەتتە تەنقىد ئەمەس.)"

msgid "The number of joins that did a full scan of the first table."
msgstr "بىرىنچى جەدۋەلنى تولۇق تەكشۈرگەن قوشۇلىدىغانلارنىڭ سانى."

msgid "The number of temporary tables currently open by the replica SQL thread."
msgstr "كۆپەيتىلگەن SQL تېمىسى ئارقىلىق ئېچىلغان ۋاقىتلىق جەدۋەللەرنىڭ سانى."

msgid "Total (since startup) number of times the replication replica SQL thread has retried transactions."
msgstr "ئومۇمىي (قوزغالغاندىن بۇيان) كۆپەيتىلگەن SQL تېمىسىنىڭ قايتا-قايتا سودا قېتىم سانى."

msgid "This is ON if this server is a replica that is connected to a primary."
msgstr "ئەگەر بۇ مۇلازىمېتىر باشلانغۇچقا ئۇلانغان كۆپەيتىلگەن نۇسخىسى بولسا ON."

msgid "The number of threads that have taken more than slow_launch_time seconds to create."
msgstr "قۇرۇشقا ئاستا_ باشلىنىش_ سېكۇنتتىن ئارتۇق ۋاقىت كەتكەن تېما سانى."

msgid "The number of queries that have taken more than long_query_time seconds."
msgstr "ئۇزۇن_ سوئال_ ۋاقىت سېكۇنتتىن ئېشىپ كەتكەن سوئاللارنىڭ سانى."

msgid "The number of merge passes the sort algorithm has had to do. If this value is large, you should consider increasing the value of the sort_buffer_size system variable."
msgstr "بىرلەشتۈرۈش قېتىم سانى ئالگورىزىمنى قىلىشقا توغرا كېلىدۇ. ئەگەر بۇ قىممەت چوڭ بولسا ، sort_buffer_size سىستېما ئۆزگەرگۈچى مىقدارنىڭ قىممىتىنى ئاشۇرۇشنى ئويلىشىشىڭىز كېرەك."

msgid "The number of sorts that were done with ranges."
msgstr "دائىرە بىلەن قىلىنغان تۈرلەرنىڭ سانى."

msgid "The number of sorted rows."
msgstr "رەتلەنگەن قۇرلارنىڭ سانى."

msgid "The number of sorts that were done by scanning the table."
msgstr "جەدۋەلنى سايىلەش ئارقىلىق ئېلىپ بېرىلغان تۈرلەرنىڭ سانى."

msgid "The number of times that a table lock was acquired immediately."
msgstr "ئۈستەل قۇلۇپىنى دەرھال سېتىۋالغان قېتىم سانى."

msgid "The number of times that a table lock could not be acquired immediately and a wait was needed. If this is high, and you have performance problems, you should first optimize your queries, and then either split your table or tables or use replication."
msgstr "ئۈستەل قۇلۇپىنى قانچە قېتىم سېتىۋالغىلى بولمايدىغانلىقىنى ۋە ساقلاشقا توغرا كېلىدىغان قېتىم سانى. ئەگەر بۇ يۇقىرى بولسا ، ھەمدە ئىقتىدار مەسىلىلىرىڭىز بولسا ، ئالدى بىلەن سوئاللىرىڭىزنى ئەلالاشتۇرۇڭ ، ئاندىن ئۈستەل ياكى جەدۋەلنى بۆلۈڭ ياكى كۆپەيتىشنى ئىشلىتىڭ."

msgid "The number of threads in the thread cache. The cache hit rate can be calculated as Threads_created/Connections. If this value is red you should raise your thread_cache_size."
msgstr "تېما ساقلىغۇچتىكى تېما سانى. غەملەكنىڭ سوقۇلۇش نىسبىتىنى Threads_created / ئۇلىنىش دەپ ھېسابلىغىلى بولىدۇ. ئەگەر بۇ قىممەت قىزىل بولسا ، سىز چوقۇم thread_cache_size نى ئۆستۈرۈڭ."

msgid "The number of currently open connections."
msgstr "نۆۋەتتە ئېچىلغان ئۇلىنىش سانى."

msgid "The number of threads created to handle connections. If Threads_created is big, you may want to increase the thread_cache_size value. (Normally this doesn't give a notable performance improvement if you have a good thread implementation.)"
msgstr "ئۇلىنىشنى بىر تەرەپ قىلىش ئۈچۈن قۇرۇلغان تېما سانى. ئەگەر Threads_created چوڭ بولسا ، thread_cache_size قىممىتىنى ئاشۇرۇشنى ئويلىشىڭىز مۇمكىن. (ئادەتتە بۇ تېما ياخشى بولسا ، كۆرۈنەرلىك ئۈنۈمگە ئېرىشەلمەيدۇ.)"

msgid "The number of threads that are not sleeping."
msgstr "ئۇخلىمىغان تېما سانى."

msgid "Setting variable failed"
msgstr "ئۆزگەرگۈچى مىقدارنى تەڭشەش مەغلۇب بولدى"

msgid "Configuration already exists, setup is disabled!"
msgstr "سەپلىمىسى ئاللىبۇرۇن مەۋجۇت ، تەڭشەش چەكلەنگەن!"

msgid "Incorrect form specified!"
msgstr "جەدۋەل ئېنىق ئەمەس!"

msgid "You are not using a secure connection; all data (including potentially sensitive information, like passwords) is transferred unencrypted!"
msgstr "بىخەتەر ئۇلىنىشنى ئىشلەتمەيسىز. بارلىق سانلىق مەلۇماتلار (مەخپىي نومۇرغا ئوخشاش سەزگۈر ئۇچۇرلارنى ئۆز ئىچىگە ئالىدۇ) شىفىرسىز يۆتكىلىدۇ!"

msgid "If your server is also configured to accept HTTPS requests follow this link to use a secure connection."
msgstr "ئەگەر مۇلازىمېتىرىڭىزمۇ HTTPS تەلىپىنى قوبۇل قىلىدىغان قىلىپ تەڭشەلگەن بولسا ، بىخەتەر ئۇلىنىش ئۈچۈن بۇ ئۇلىنىشقا ئەگىشىڭ."

msgid "Insecure connection"
msgstr "بىخەتەر ئۇلىنىش"

msgid "Wrong data"
msgstr "خاتا سانلىق مەلۇمات"

msgid "No SQL query was set to fetch data."
msgstr "سانلىق مەلۇمات ئېلىش ئۈچۈن SQL سۈرۈشتۈرۈلمىدى."

msgid "No numeric columns present in the table to plot."
msgstr "جەدۋەلدە سان سانلىرى يوق."

msgid "No column selected."
msgstr "ستون تاللانمىدى."

msgid "Invalid table name"
msgstr "ئۈنۈمسىز جەدۋەل ئىسمى"

msgid "MySQL returned an empty result set (i.e. zero rows)."
msgstr "MySQL قۇرۇق نەتىجە توپلىمىنى قايتۇردى (يەنى نۆل قۇر)."

msgid "Maintenance operations on multiple tables are disabled."
msgstr "كۆپ جەدۋەلدىكى ئاسراش مەشغۇلاتى چەكلەنگەن."

msgid "Display column was successfully updated."
msgstr "كۆرسىتىش ئىستونى مۇۋەپپەقىيەتلىك يېڭىلاندى."

msgid "SQL statements executed."
msgstr "SQL جۈملىلىرى ئىجرا قىلىندى."

msgid "You don't have sufficient privileges to be here right now!"
msgstr "ھازىر بۇ يەردە بولۇشقا يېتەرلىك ئىمتىيازلىرىڭىز يوق!"

msgid "View name can not be empty!"
msgstr "كۆرۈش ئىسمى قۇرۇق ئەمەس!"

msgid "The %s extension is missing. Please check your PHP configuration."
msgstr "%s كېڭەيتىلمە كەمكەن، PHP تەڭشەك ھۆججىتىنى تەكشۈرۈپ چىقىڭ."

msgid "The configuration storage is not ready for the central list of columns feature."
msgstr "سەپلىمە ساقلاش مەركىزى تۈۋرۈك ئىقتىدار تىزىملىكى ئۈچۈن تەييار ئەمەس."

msgid "Error: Missing index on column(s)."
msgstr "خاتالىق: ئىستون (لار) دىكى كۆرسەتكۈچ يوق."

msgid "One or more errors have occurred while processing your request:"
msgstr "تەلىپىڭىزنى بىر تەرەپ قىلغاندا بىر ياكى بىر قانچە خاتالىق كۆرۈلدى:"

msgid "Sorry, we failed to restore the dropped routine."
msgstr "كەچۈرۈڭ ، بىز تاشلىۋېتىلگەن ئادەتنى ئەسلىگە كەلتۈرەلمىدۇق."

msgid "The backed up query was:"
msgstr "زاپاسلانغان سوئال:"

msgid "MySQL said: "
msgstr "MySQL جاۋابى: "

msgid "You must provide a name and a type for each routine parameter."
msgstr "ھەر بىر ئادەتتىكى پارامېتىرغا چوقۇم ئىسىم ۋە تىپ تەمىنلىشىڭىز كېرەك."

msgid "You must provide length/values for routine parameters of type ENUM, SET, VARCHAR and VARBINARY."
msgstr "ENUM ، SET ، VARCHAR ۋە VARBINARY تىپىدىكى ئادەتتىكى پارامېتىرلار ئۈچۈن چوقۇم ئۇزۇنلۇق / قىممەت بىلەن تەمىنلىشىڭىز كېرەك."

msgid "You must provide a valid return type for the routine."
msgstr "دائىملىق ئۈچۈن چوقۇم ئۈنۈملۈك قايتۇرۇش تىپى بىلەن تەمىنلىشىڭىز كېرەك."

msgid "The definer must be in the \"username@hostname\" format!"
msgstr "ئېنىقلىغۇچى چوقۇم «ئىشلەتكۈچى ئىسمى @ hostname» شەكلىدە بولۇشى كېرەك!"

msgid "You must provide a routine definition."
msgstr "سىز چوقۇم دائىملىق ئېنىقلىما بېرىشىڭىز كېرەك."

msgid "Data home directory"
msgstr "سانلىق مەلۇمات ئائىلە مۇندەرىجىسى"

msgid "The common part of the directory path for all InnoDB data files."
msgstr "بارلىق InnoDB سانلىق مەلۇمات ھۆججەتلىرىنىڭ مۇندەرىجە يولىنىڭ ئورتاق قىسمى."

msgid "Data files"
msgstr "سانلىق مەلۇمات ھۆججەتلىرى"

msgid "Autoextend increment"
msgstr "ئاپتوماتىك كېڭەيتىش"

msgid "The increment size for extending the size of an autoextending tablespace when it becomes full."
msgstr "تولدۇرغاندا ئاپتوماتىك كېڭەيتىلگەن ئۈستەل بوشلۇقىنىڭ چوڭ-كىچىكلىكىنى كېڭەيتىشنىڭ چوڭ-كىچىكلىكى."

msgid "Buffer pool size"
msgstr "بۇففېر كۆلچىكىنىڭ چوڭلۇقى"

msgid "The size of the memory buffer InnoDB uses to cache data and indexes of its tables."
msgstr "ئىچكى ساقلىغۇچنىڭ چوڭلۇقى InnoDB جەدۋەلنىڭ سانلىق مەلۇماتلىرى ۋە كۆرسەتكۈچلىرىنى ساقلايدۇ."

msgid "Buffer Pool"
msgstr "Buffer Pool"

msgid "InnoDB Status"
msgstr "InnoDB ھالىتى"

msgid "Data pointer size"
msgstr "سانلىق مەلۇمات قوللانمىسىنىڭ چوڭ كىچىكلىكى"

msgid "The default pointer size in bytes, to be used by CREATE TABLE for MyISAM tables when no MAX_ROWS option is specified."
msgstr "MAX_ROWS تاللانمىغان ۋاقىتتا MyISAM جەدۋىلى ئۈچۈن CREATE TABLE ئىشلىتىدىغان بايتتىكى سۈكۈتتىكى كۆرسەتكۈچ چوڭلۇقى."

msgid "Automatic recovery mode"
msgstr "ئاپتۇماتىك ئەسلىگە كەلتۈرۈش شەكلى"

msgid "The mode for automatic recovery of crashed MyISAM tables, as set via the --myisam-recover server startup option."
msgstr "--Misam ئەسلىگە كەلتۈرۈش مۇلازىمېتىرنى قوزغىتىش تاللانمىسى ئارقىلىق بېكىتىلگەن MyISAM جەدۋىلىنى ئاپتوماتىك ئەسلىگە كەلتۈرۈش ھالىتى."

msgid "Maximum size for temporary sort files"
msgstr "ۋاقىتلىق تەرتىپ ھۆججەتلىرىنىڭ ئەڭ چوڭ چوڭلۇقى"

msgid "The maximum size of the temporary file MySQL is allowed to use while re-creating a MyISAM index (during REPAIR TABLE, ALTER TABLE, or LOAD DATA INFILE)."
msgstr "MySQL ۋاقىتلىق ھۆججىتىنىڭ ئەڭ چوڭ چوڭلۇقى MyISAM كۆرسەتكۈچىنى قايتا قۇرغاندا ئىشلىتىشكە بولىدۇ (REPAIR TABLE ، ALTER TABLE ياكى LOAD DATA INFILE)."

msgid "Maximum size for temporary files on index creation"
msgstr "كۆرسەتكۈچ قۇرۇشتىكى ۋاقىتلىق ھۆججەتلەرنىڭ ئەڭ چوڭ چوڭلۇقى"

msgid "If the temporary file used for fast MyISAM index creation would be larger than using the key cache by the amount specified here, prefer the key cache method."
msgstr "ئەگەر تېز MyISAM كۆرسەتكۈچ قۇرۇشقا ئىشلىتىلىدىغان ۋاقىتلىق ھۆججەت ئاچقۇچ ساقلىغۇچنى بۇ يەردە كۆرسىتىلگەن مىقداردىن چوڭراق بولسا ، ئاچقۇچ غەملەك ئۇسۇلىنى تاللاڭ."

msgid "Repair threads"
msgstr "ئەسلىگە كەلتۈرۈش يۇلى"

msgid "If this value is greater than 1, MyISAM table indexes are created in parallel (each index in its own thread) during the repair by sorting process."
msgstr "ئەگەر بۇ قىممەت 1 دىن چوڭ بولسا ، MyISAM جەدۋەل كۆرسەتكۈچلىرى تەرتىپلەش جەريانىدا رېمونت قىلىش جەريانىدا پاراللېل (ھەر بىر كۆرسەتكۈچ ئۆز تېمىدىكى) ھاسىل بولىدۇ."

msgid "Sort buffer size"
msgstr "بۇففېرنىڭ چوڭ-كىچىكلىكىنى تەرتىپلەڭ"

msgid "The buffer that is allocated when sorting MyISAM indexes during a REPAIR TABLE or when creating indexes with CREATE INDEX or ALTER TABLE."
msgstr "قايتا تەكشۈرۈش جەدۋىلىدە MyISAM كۆرسەتكۈچلىرىنى رەتلىگەندە ياكى CREATE INDEX ياكى ALTER TABLE بىلەن كۆرسەتكۈچ قۇرغاندا تەقسىملىنىدىغان بۇففېر."

msgid "Index cache size"
msgstr "كۆرسەتكۈچ ساقلىغۇچنىڭ چوڭلۇقى"

msgid "This is the amount of memory allocated to the index cache. Default value is 32MB. The memory allocated here is used only for caching index pages."
msgstr "بۇ كۆرسەتكۈچ ساقلىغۇچقا تەقسىم قىلىنغان ئىچكى ساقلىغۇچنىڭ مىقدارى. سۈكۈتتىكى قىممىتى 32MB. بۇ يەرگە تەقسىملەنگەن ئىچكى ساقلىغۇچ پەقەت كۆرسەتكۈچ بەتلىرىنى ساقلاشقا ئىشلىتىلىدۇ."

msgid "Record cache size"
msgstr "غەملەكنىڭ چوڭ-كىچىكلىكىنى خاتىرىلەڭ"

msgid "This is the amount of memory allocated to the record cache used to cache table data. The default value is 32MB. This memory is used to cache changes to the handle data (.xtd) and row pointer (.xtr) files."
msgstr "بۇ جەدۋەل سانلىق مەلۇماتلىرىنى ساقلاشقا ئىشلىتىلىدىغان خاتىرە ساقلىغۇچقا تەقسىملەنگەن ئىچكى ساقلىغۇچنىڭ مىقدارى. سۈكۈتتىكى قىممىتى 32MB. بۇ ئىچكى ساقلىغۇچ بىر تەرەپ قىلىش سانلىق مەلۇماتلىرى (.xtd) ۋە قۇر كۆرسەتكۈچ (.xtr) ھۆججىتىدىكى ئۆزگىرىشلەرنى ساقلاشقا ئىشلىتىلىدۇ."

msgid "Log cache size"
msgstr "غەملەك چوڭلۇقى"

msgid "The amount of memory allocated to the transaction log cache used to cache on transaction log data. The default is 16MB."
msgstr "سودا خاتىرىسى سانلىق مەلۇماتلىرىنى ساقلاشقا ئىشلىتىلىدىغان سودا خاتىرىسى ساقلىغۇچقا تەقسىملەنگەن ئىچكى ساقلىغۇچنىڭ مىقدارى. سۈكۈتتىكىسى 16MB."

msgid "Log file threshold"
msgstr "ھۆججەت بوسۇغىسى"

msgid "The size of a transaction log before rollover, and a new log is created. The default value is 16MB."
msgstr "دومىلاشتىن ئىلگىرى سودا خاتىرىسىنىڭ چوڭ-كىچىكلىكى ۋە يېڭى خاتىرە قۇرۇلدى. سۈكۈتتىكى قىممىتى 16MB."

msgid "Transaction buffer size"
msgstr "سودا بۇففېرنىڭ چوڭلۇقى"

msgid "The size of the global transaction log buffer (the engine allocates 2 buffers of this size). The default is 1MB."
msgstr "يەرشارىدىكى سودا خاتىرىسىنىڭ چوڭلۇقى (ماتور بۇ چوڭلۇقتىكى 2 بۇففېر تەقسىملەيدۇ). سۈكۈتتىكىسى 1MB."

msgid "Checkpoint frequency"
msgstr "تەكشۈرۈش نۇقتىسىنىڭ چاستوتىسى"

msgid "The amount of data written to the transaction log before a checkpoint is performed. The default value is 24MB."
msgstr "تەكشۈرۈش پونكىتى ئىجرا قىلىنىشتىن بۇرۇن سودا خاتىرىسىگە يېزىلغان سانلىق مەلۇماتلارنىڭ مىقدارى. سۈكۈتتىكى قىممىتى 24MB."

msgid "Data log threshold"
msgstr "سانلىق مەلۇمات خاتىرىسى"

msgid "The maximum size of a data log file. The default value is 64MB. PBXT can create a maximum of 32000 data logs, which are used by all tables. So the value of this variable can be increased to increase the total amount of data that can be stored in the database."
msgstr "سانلىق مەلۇمات خاتىرىسى ھۆججىتىنىڭ ئەڭ چوڭ چوڭلۇقى. سۈكۈتتىكى قىممىتى 64MB. PBXT ئەڭ كۆپ بولغاندا 32000 سانلىق مەلۇمات خاتىرىسىنى قۇرالايدۇ ، بۇلار بارلىق جەدۋەللەردە ئىشلىتىلىدۇ. شۇڭا بۇ ئۆزگەرگۈچى مىقدارنىڭ قىممىتىنى ئۆستۈرۈپ ، سانداندا ساقلىغىلى بولىدىغان سانلىق مەلۇماتنىڭ ئومۇمىي مىقدارىنى ئاشۇرغىلى بولىدۇ."

msgid "Garbage threshold"
msgstr "ئەخلەت ساندۇقى"

msgid "The percentage of garbage in a data log file before it is compacted. This is a value between 1 and 99. The default is 50."
msgstr "ئۇ بىر تەرەپ قىلىنىشتىن بۇرۇن سانلىق مەلۇمات خاتىرىسىدىكى ئەخلەتلەرنىڭ نىسبىتى. بۇ 1 دىن 99 گىچە بولغان قىممەت. سۈكۈتتىكىسى 50."

msgid "Log buffer size"
msgstr "بۇففېرنىڭ چوڭلۇقى"

msgid "The size of the buffer used when writing a data log. The default is 256MB. The engine allocates one buffer per thread, but only if the thread is required to write a data log."
msgstr "سانلىق مەلۇمات خاتىرىسىنى يازغاندا ئىشلىتىلگەن بۇففېرنىڭ چوڭلۇقى. سۈكۈتتىكىسى 256MB. ماتور ھەر بىر تېمىغا بىر بۇففېر تەقسىملەيدۇ ، ئەمما پەقەت تېما سانلىق مەلۇمات خاتىرىسىنى يېزىش تەلەپ قىلىنغاندىلا."

msgid "Data file grow size"
msgstr "سانلىق مەلۇمات ھۆججىتىنىڭ ئېشىش چوڭ-كىچىكلىكى"

msgid "The grow size of the handle data (.xtd) files."
msgstr "تۇتقۇچ سانلىق مەلۇمات (.xtd) ھۆججەتلىرىنىڭ چوڭ-كىچىكلىكى."

msgid "Row file grow size"
msgstr "قۇر ھۆججەت چوڭلۇقى"

msgid "The grow size of the row pointer (.xtr) files."
msgstr "قۇر كۆرسەتكۈچ (.xtr) ھۆججىتىنىڭ چوڭ-كىچىكلىكى."

msgid "Log file count"
msgstr "كۈندىلىك ھۆججەت ئۇمۇمىي سانى"

msgid "This is the number of transaction log files (pbxt/system/xlog*.xt) the system will maintain. If the number of logs exceeds this value then old logs will be deleted, otherwise they are renamed and given the next highest number."
msgstr "بۇ سىستېما ساقلايدىغان سودا خاتىرىسىنىڭ سانى (pbxt / system / xlog * .xt). ئەگەر خاتىرە سانى بۇ قىممەتتىن ئېشىپ كەتسە ، كونا خاتىرىلەر ئۆچۈرۈلىدۇ ، بولمىسا ئۇلارنىڭ نامىغا ئۆزگەرتىلىپ ، كېيىنكى ئەڭ يۇقىرى سان بېرىلىدۇ."

msgid "Too many error messages, some are not displayed."
msgstr "خاتالىق ئۇچۇرى بەك كۆپ ، بەزىلىرى كۆرۈنمەيدۇ."

msgid "Sorry, we failed to restore the dropped event."
msgstr "كەچۈرۈڭ ، بىز چۈشۈپ كەتكەن ۋەقەنى ئەسلىگە كەلتۈرەلمىدۇق."

msgid "You must provide a valid interval value for the event."
msgstr "سىز چوقۇم پائالىيەت ئۈچۈن ئۈنۈملۈك ئارىلىق قىممىتى بىلەن تەمىنلىشىڭىز كېرەك."

msgid "You must provide a valid execution time for the event."
msgstr "سىز چوقۇم پائالىيەت ئۈچۈن ئۈنۈملۈك ئىجرا ۋاقتى بىلەن تەمىنلىشىڭىز كېرەك."

msgid "You must provide a valid type for the event."
msgstr "سىز چوقۇم پائالىيەت ئۈچۈن ئۈنۈملۈك تىپ بىلەن تەمىنلىشىڭىز كېرەك."

msgid "You must provide an event definition."
msgstr "سىز چوقۇم پائالىيەت ئېنىقلىمىسى بىلەن تەمىنلىشىڭىز كېرەك."

msgid "Access denied!"
msgstr "زىيارەت رەت قىلىندى!"

msgid "Insufficient space to save the file %s."
msgstr "ھۆججەتنى ساقلاشقا يىتەرلىك بوشلۇق يوق %s。"

msgid "File %s already exists on server, change filename or check overwrite option."
msgstr "%s بۇ ھۆججەت مۇلازىمىتېردا باركەن، ھۆججەت ئىسمىنى ئۆزگەرتىڭ ياكى قاپلاپ كۆچۈرۈش تۈرىنى تالالڭ."

msgid "The web server does not have permission to save the file %s."
msgstr "بۇ %s ھۆججەتنى  مۇلازىمىتېردا ساقلاش ھوقۇقىڭىز يېتەرسىز."

msgid "Dump has been saved to file %s."
msgstr "%s ھۆججىتىدە ساقلاندى."

msgid "File was not an uploaded file."
msgstr "ھۆججەت يۈكلەنگەن ھۆججەت ئەمەس."

msgid "The uploaded file exceeds the upload_max_filesize directive in php.ini."
msgstr "سىز يۈكلىگەن ھۆججەت php.ini نىڭ ئىچىدىكى upload_max_filesize  چەكلىمىسىدىن ئېشىپ كەتتى."

msgid "The uploaded file exceeds the MAX_FILE_SIZE directive that was specified in the HTML form."
msgstr "سز يۈكلىگەن ھۆججەت HTML نىڭ MAX_FILE_SIZE  چېكىدىن ئېشىپ كەتتى."

msgid "The uploaded file was only partially uploaded."
msgstr "سىز يۈكلىگەن ھۆججەتنىڭ پەقەت بىر قىسىمىلا يۈكلەندى."

msgid "Missing a temporary folder."
msgstr "ۋاقىتلىق ھۆججەت ساقلاش مۇندەرىجىسى تىپىلمىدى."

msgid "Failed to write file to disk."
msgstr "ھۆججەتنى دېسكىغا يىزىشتا خاتالىق كۆرۈلدى."

msgid "File upload stopped by extension."
msgstr "كېڭەيتىلمە ئىسمى بۇنداق ھۆججەتلەرنى يوللاشقا بولمايدۇ."

msgid "Unknown error in file upload."
