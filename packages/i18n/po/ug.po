msgstr "ھەر بىر <code> INSERT </code> جۈملىسىگە بىر نەچچە قۇر قىستۇرۇڭ <br> & nbsp; & nbsp; & nbsp; مىسال: <code> INSERT INTO tbl_name VALUES (1,2,3) ، (4,5,6) ، (7,8,9) </code>"

msgid "both of the above<br> &nbsp; &nbsp; &nbsp; Example: <code>INSERT INTO tbl_name (col_A,col_B,col_C) VALUES (1,2,3), (4,5,6), (7,8,9)</code>"
msgstr "يۇقىرىدىكى ھەر ئىككىسى <br> & nbsp; & nbsp; & nbsp; مىسال: <code> INSERT INTO tbl_name (col_A, col_B, col_C) VALUES (1,2,3) ، (4,5,6) ، (7,8,9) </code>"

msgid "neither of the above<br> &nbsp; &nbsp; &nbsp; Example: <code>INSERT INTO tbl_name VALUES (1,2,3)</code>"
msgstr "يۇقىرىدىكى <br> & nbsp; & nbsp; & nbsp; مىسال: <code> INSERT INTO tbl_name VALUES (1,2,3) </code>"

msgid "Dump binary columns in hexadecimal notation <i>(for example, \"abc\" becomes 0x616263)</i>"
msgstr "ئىككىلىك ئىستوننى ئالتە تەرەپلىك ئىزاھاتقا تاشلاش <i> (مەسىلەن ، «abc» 0x616263 غا ئايلىنىدۇ) </i>"

msgid "Dump TIMESTAMP columns in UTC <i>(enables TIMESTAMP columns to be dumped and reloaded between servers in different time zones)</i>"
msgstr "UTC <i> دىكى TIMESTAMP ستونلىرىنى تاشلاڭ (TIMESTAMP ستونلىرىنى ئوخشىمىغان ۋاقىت رايونىدىكى مۇلازىمېتىرلار ئارىسىدا تاشلىغىلى ۋە قايتا يۈكلىيەلەيدۇ) </i>"

msgid "It appears your database uses routines;"
msgstr "ئۇ سىزنىڭ ساندىنىڭىزنىڭ كۈندىلىك مەشغۇلاتلىرىنى ئىشلىتىدىغاندەك قىلىدۇ."

msgid "alias export may not work reliably in all cases."
msgstr "تاشقى پېرېۋوت ئېكسپورتى ھەممە ئەھۋالدا ئىشەنچلىك ئىشلىمەسلىكى مۇمكىن."

msgid "It appears your database uses views;"
msgstr "ئۇ سىزنىڭ سانداندا كۆرۈنۈشنى ئىشلىتىدىغاندەك قىلىدۇ."

msgid "Constraints for dumped tables"
msgstr "تاشلانغان جەدۋەللەرنىڭ چەكلىمىسى"

msgid "Constraints for table"
msgstr "جەدۋەلنىڭ چەكلىمىسى"

msgid "MEDIA TYPES FOR TABLE"
msgstr "جەدۋەل ئۈچۈن مېدىيا تىپلىرى"

msgid "RELATIONSHIPS FOR TABLE"
msgstr "جەدۋەل ئۈچۈن مۇناسىۋەت"

msgid "It appears your table uses triggers;"
msgstr "جەدۋەلدە قوزغاتقۇچ ئىشلىتىلگەندەك قىلىدۇ."

msgid "(See below for the actual view)"
msgstr "(ئەمەلىي كۆرۈنۈش ئۈچۈن تۆۋەنگە قاراڭ)"

msgid "Database system or older MySQL server to maximize output compatibility with:"
msgstr "ساندان سىستېمىسى ياكى كونا MySQL مۇلازىمېتىرى بىلەن چىقىرىش ماسلىشىشچانلىقىنى ئەڭ يۇقىرى چەككە يەتكۈزىدۇ:"

msgid "Object creation options (all are recommended)"
msgstr "ئوبيېكت قۇرۇش تاللانمىلىرى (ھەممىسى تەۋسىيە قىلىنىدۇ)"

msgid "Export contents"
msgstr "مەزمۇننى چىقىرىش"

msgid "Purpose:"
msgstr "مەقسەت:"

msgid "Update data when duplicate keys found on import (add ON DUPLICATE KEY UPDATE)"
msgstr "ئىمپورتتا تېپىلغان كۆپەيتىلگەن كۇنۇپكىلاردا سانلىق مەلۇماتلارنى يېڭىلاڭ (ON DUPLICATE KEY UPDATE نى قوشۇڭ)"

msgid "Name of the new table (optional):"
msgstr "يېڭى جەدۋەلنىڭ ئىسمى (ئىختىيارى):"

msgid "Name of the new database (optional):"
msgstr "يېڭى سانداننىڭ ئىسمى (ئىختىيارى):"

msgid "Import these many number of rows (optional):"
msgstr "بۇ نۇرغۇن قۇرلارنى ئەكىرىڭ (ئىختىيارىي):"

msgid "The first line of the file contains the table column names <i>(if this is unchecked, the first line will become part of the data)</i>"
msgstr "ھۆججەتنىڭ بىرىنچى قۇردا جەدۋەل ئىستون ئىسمى <i> بار (ئەگەر بۇ تەكشۈرۈلمىسە ، بىرىنچى قۇر سانلىق مەلۇماتنىڭ بىر قىسمى بولۇپ قالىدۇ) </i>"

msgid "If the data in each row of the file is not in the same order as in the database, list the corresponding column names here. Column names must be separated by commas and not enclosed in quotations."
msgstr "ئەگەر ھۆججەتنىڭ ھەر بىر قۇردىكى سانلىق مەلۇماتلار سانداندىكى تەرتىپ بويىچە بولمىسا ، مۇناسىپ ئىستون نامىنى بۇ يەرگە تىزىڭ. ستون ئىسىملىرى پەش بىلەن ئايرىلىشى ھەمدە نەقىل كەلتۈرۈلمەسلىكى كېرەك."

msgid "This plugin does not support compressed imports!"
msgstr "بۇ قىستۇرما پىرىسلانغان ئىمپورتنى قوللىمايدۇ!"

msgid "MediaWiki Table"
msgstr "MediaWikiكۈرۈنىشى"

msgid "Import percentages as proper decimals <i>(ex. 12.00% to .12)</i>"
msgstr "پىرسەنتنى مۇۋاپىق ئونلۇق قىلىپ ئەكىرىڭ <i> (مەسىلەن% 12.00 دىن .12 گىچە) </i>"

msgid "Import currencies <i>(ex. $5.00 to 5.00)</i>"
msgstr "پۇللارنى ئىمپورت قىلىش <i> (مەسىلەن 5.00 دوللاردىن 5.00 دوللارغىچە) </i>"

msgid "The XML file specified was either malformed or incomplete. Please correct the issue and try again."
msgstr "كۆرسىتىلگەن XML ھۆججىتى خاتا ياكى تولۇق ئەمەس. مەسىلىنى تۈزىتىپ قايتا سىناڭ."

msgid "ESRI Shape File"
msgstr "ESRI شەكىل ھۆججىتى"

msgid "Do not use <code>AUTO_INCREMENT</code> for zero values"
msgstr "نۆل قىممەت ئۈچۈن <code> AUTO_INCREMENT </code> نى ئىشلەتمەڭ"

msgid "XML"
msgstr "XML"

msgid "This format has no options"
msgstr "بۇ فورماتنىڭ تاللىشى يوق"

msgid "SCHEMA ERROR: "
msgstr "SCHEMA خاتالىق: "

msgid "Relational schema"
msgstr "مۇناسىۋەتلىك لايىھە"

msgid "Table of contents"
msgstr "مەزمۇن جەدۋىلى"

msgid "Show color"
msgstr "رەڭنى كۆرسىتىش"

msgid "Only show keys"
msgstr "پەقەت كونوپكىنى كورسىتىش"

msgid "Landscape"
msgstr "توغرا يۈنىلىشتە"

msgid "Portrait"
msgstr "بوي يۈنىلىشتە"

msgid "Same width for all tables"
msgstr "بارلىق جەدۋەللەرنىڭ كەڭلىكى ئوخشاش"

msgid "Show grid"
msgstr "كاتەكچە كۆرسەت"

msgid "Converts Boolean values to text (default 'T' and 'F'). First option is for TRUE, second for FALSE. Nonzero=true."
msgstr "Boolean قىممىتىنى تېكىستكە ئايلاندۇرىدۇ (سۈكۈتتىكى 'T' ۋە 'F'). بىرىنچى تاللاش TRUE ، ئىككىنچى يالغان. Nonzero = true."

msgid "Displays a TIME, TIMESTAMP, DATETIME or numeric unix timestamp column as formatted date. The first option is the offset (in hours) which will be added to the timestamp (Default: 0). Use second option to specify a different date/time format string. Third option determines whether you want to see local date or UTC one (use \"local\" or \"utc\" strings) for that. According to that, date format has different value - for \"local\" see the documentation for PHP's strftime() function and for \"utc\" it is done using gmdate() function."
msgstr "ۋاقىت ، TIMESTAMP ، DATETIME ياكى رەقەملىك بىرلەشمە ۋاقىت جەدۋىلىنى فورماتلانغان چېسلا قىلىپ كۆرسىتىدۇ. بىرىنچى تاللاش بولسا ۋاقىت جەدۋىلىگە قوشۇلىدىغان offset (سائەتتە) (سۈكۈت: 0). ئىككىنچى تاللاش ئارقىلىق ئوخشىمىغان چېسلا / ۋاقىت فورماتىنى بەلگىلەڭ. ئۈچىنچى تاللاش بۇنىڭ ئۈچۈن يەرلىك چېسلا ياكى UTC نى كۆرۈشنى خالايدىغانلىقىڭىزنى بەلگىلەيدۇ (بۇنىڭ ئۈچۈن «يەرلىك» ياكى «utc» ھەرپلىرىنى ئىشلىتىڭ). بۇنىڭغا ئاساسەن ، چېسلا فورماتىنىڭ ئوخشىمىغان قىممىتى بار - «يەرلىك» ئۈچۈن PHP نىڭ strftime () ئىقتىدارى ۋە «utc» ئۈچۈن gmdate () ئىقتىدارى ئارقىلىق ئىشلەنگەن ھۆججەتلەرنى كۆرۈڭ."

msgid "%B %d, %Y at %I:%M %p"
msgstr "%يىل %ئاي %كۈن %سائەت:%مىنۇت"

msgid "Displays the contents of the column as-is, without running it through htmlspecialchars(). That is, the column is assumed to contain valid HTML."
msgstr "ستوننىڭ مەزمۇنىنى htmlspecialchars () ئارقىلىق ئىجرا قىلماي تۇرۇپ كۆرسىتىدۇ. يەنى بۇ ئىستوندا ئۈنۈملۈك HTML بار دەپ قارىلىدۇ."

msgid "Displays hexadecimal representation of data. Optional first parameter specifies how often space will be added (defaults to 2 nibbles)."
msgstr "سانلىق مەلۇماتنىڭ ئالتە تەرەپلىك ئىپادىسىنى كۆرسىتىدۇ. ئىختىيارىي بىرىنچى پارامېتىر بوشلۇقنىڭ قانچە قېتىم قوشۇلىدىغانلىقىنى بەلگىلەيدۇ (سۈكۈتتىكى 2 ئىنچىكە)."

msgid "Displays a link to download this image."
msgstr "بۇ رەسىمنى چۈشۈرۈش ئۈچۈن ئۇلىنىش كۆرسىتىدۇ."

msgid "Image upload functionality which also displays a thumbnail. The options are the width and height of the thumbnail in pixels. Defaults to 100 X 100."
msgstr "رەسىم يوللاش ئىقتىدارى كىچىك كۆرۈنۈشنى كۆرسىتىدۇ. تاللانما پىكسېلدىكى كىچىك كۆرۈنۈشنىڭ كەڭلىكى ۋە ئېگىزلىكى. كۆڭۈلدىكى قىممىتى 100 X 100."

msgid "Image preview here"
msgstr "بۇ يەردىكى رەسىم ئالدىن كۆرۈش"

msgid "Displays a clickable thumbnail. The options are the maximum width and height in pixels. The original aspect ratio is preserved."
msgstr "چېكىشكە بولىدىغان كىچىك كۆرۈنۈشنى كۆرسىتىدۇ. تاللاشلار پىكسېلدىكى ئەڭ چوڭ كەڭلىك ۋە ئېگىزلىك. ئەسلىدىكى نىسبەت نىسبىتى ساقلانغان."

msgid "Converts an (IPv4) Internet network address stored as a BIGINT into a string in Internet standard dotted format."
msgstr "BIGINT سۈپىتىدە ساقلانغان (IPv4) ئىنتېرنېت تورى ئادرېسىنى ئىنتېرنېت ئۆلچىمىدىكى چېكىت شەكلىدە تىزىدۇ."

msgid "Prepends and/or Appends text to a string. First option is text to be prepended, second is appended (enclosed in single quotes, default empty string)."
msgstr "تېكىستنى بىر قۇرغا تەييارلايدۇ ۋە / ياكى قوشىدۇ. بىرىنچى تاللاش ئالدىن تەييارلىنىدىغان تېكىست ، ئىككىنچىسى قوشۇلدى (يەككە تىرناق ئىچىگە ئېلىنغان ، سۈكۈتتىكى قۇرۇق تىزما)."

msgid "Validates the string using regular expression and performs insert only if string matches it. The first option is the Regular Expression."
msgstr "مۇنتىزىم ئىپادىلەش ئارقىلىق بۇ تىزمىنى دەلىللەيدۇ ۋە پەقەت ماس كەلگەندىلا قىستۇرما ئىجرا قىلىدۇ. بىرىنچى تاللاش بولسا دائىملىق ئىپادىلەش."

msgid "Formats text as SQL query with syntax highlighting."
msgstr "تېكىستنى گرامماتىكىلىق يورۇتۇش بىلەن SQL سۈرۈشتۈرۈش شەكلىدە فورماتلايدۇ."

msgid "Displays a part of a string. The first option is the number of characters to skip from the beginning of the string (Default 0). The second option is the number of characters to return (Default: until end of string). The third option is the string to append and/or prepend when truncation occurs (Default: \"…\")."
msgstr "بىر قۇرنىڭ بىر قىسمىنى كۆرسىتىدۇ. بىرىنچى تاللاش بولسا قۇرنىڭ بېشىدىن ئاتلىنىدىغان ھەرپلەرنىڭ سانى (سۈكۈتتىكى 0). ئىككىنچى تاللاش بولسا قايتىدىغان ھەرپلەرنىڭ سانى (سۈكۈتتىكىسى: قۇرنىڭ ئاخىرىغىچە). ئۈچىنچى تاللاش بولسا كېسىش يۈز بەرگەندە قوشۇش ۋە ياكى ئالدىن تەييارلاش تىزمىسى (سۈكۈتتىكى: \"…\")."

msgid "File upload functionality for TEXT columns. It does not have a textarea for input."
msgstr "TEXT ستونلىرىغا ھۆججەت يوللاش ئىقتىدارى. ئۇنىڭدا كىرگۈزۈش ئۈچۈن تېكىست يوق."

msgid "Displays an image and a link; the column contains the filename. The first option is a URL prefix like \"https://www.example.com/\". The second and third options are the width and the height in pixels."
msgstr "رەسىم ۋە ئۇلىنىشنى كۆرسىتىدۇ. بۇ ئىستوندا ھۆججەت ئىسمى بار. بىرىنچى تاللاش «https://www.example.com/» غا ئوخشاش URL ئالدى قوشۇلغۇچىسى. ئىككىنچى ۋە ئۈچىنچى تاللاش بولسا كەڭلىكى ۋە ئېگىزلىكى پىكسېل."

msgid "Displays a link; the column contains the filename. The first option is a URL prefix like \"https://www.example.com/\". The second option is a title for the link."
msgstr "ئۇلانمىنى كۆرسىتىدۇ; بۇ ئىستوندا ھۆججەت ئىسمى بار. بىرىنچى تاللاش «https://www.example.com/» غا ئوخشاش URL ئالدى قوشۇلغۇچىسى. ئىككىنچى تاللاش بولسا ئۇلىنىشنىڭ ئىسمى."

msgid "Converts an Internet network address in (IPv4/IPv6) format to binary"
msgstr "(IPv4 / IPv6) فورماتىدىكى ئىنتېرنېت تورى ئادرېسىنى ئىككىلىك سىستېمىغا ئايلاندۇرىدۇ"

msgid "Converts an Internet network address in (IPv4/IPv6) format into a long integer."
msgstr "(IPv4 / IPv6) فورماتىدىكى ئىنتېرنېت تورى ئادرېسىنى ئۇزۇن پۈتۈن سانغا ئايلاندۇرىدۇ."

msgid "Syntax highlighted CodeMirror editor for JSON."
msgstr "گرامماتىكىسى JSON نىڭ CodeMirror تەھرىرىنى گەۋدىلەندۈردى."

msgid "Syntax highlighted CodeMirror editor for SQL."
msgstr "گرامماتىكىسى SQL نىڭ CodeMirror تەھرىرىنى گەۋدىلەندۈردى."

msgid "Syntax highlighted CodeMirror editor for XML (and HTML)."
msgstr "گرامماتىكىسى XML (ۋە HTML) نىڭ CodeMirror تەھرىرىنى گەۋدىلەندۈردى."

msgid "Converts an Internet network address stored as a binary string into a string in Internet standard (IPv4/IPv6) format."
msgstr "ئىككىلىك تىزما سۈپىتىدە ساقلانغان ئىنتېرنېت تورى ئادرېسىنى ئىنتېرنېت ئۆلچىمى (IPv4 / IPv6) فورماتىغا ئايلاندۇرىدۇ."

msgid "Formats text as JSON with syntax highlighting."
msgstr "تېكىستنى JSON قىلىپ فورماتلاش ئارقىلىق فورماتلايدۇ."

msgid "Formats text as XML with syntax highlighting."
msgstr "تېكىستنى گرامماتىكىلىق يورۇتۇش ئارقىلىق XML قىلىپ فورماتلايدۇ."

msgid "Provides authentication using HOTP and TOTP applications such as FreeOTP, Google Authenticator or Authy."
msgstr "FreeOTP ، Google Authenticator ياكى Authy قاتارلىق HOTP ۋە TOTP قوللىنىشچان پروگراممىلىرىنى ئىشلىتىپ دەلىللەش بىلەن تەمىنلەيدۇ."

msgid "Hardware Security Key (FIDO U2F)"
msgstr "قاتتىق دېتال بىخەتەرلىك ئاچقۇچى (FIDO U2F)"

msgid "Provides authentication using hardware security tokens supporting FIDO U2F, such as a YubiKey."
msgstr "YubiKey غا ئوخشاش FIDO U2F نى قوللايدىغان قاتتىق دېتال بىخەتەرلىك بەلگىسى ئارقىلىق دەلىللەش بىلەن تەمىنلەيدۇ."

msgid "Login using password only."
msgstr "پەقەت پارول ئىشلىتىپلا كىرىڭ."

msgid "For testing purposes only!"
msgstr "پەقەت سىناق مەقسىتىدە!"

msgid "Hardware Security Key (WebAuthn/FIDO2)"
msgstr "قاتتىق دېتال بىخەتەرلىك ئاچقۇچى (WebAuthn / FIDO2)"

msgid "Provides authentication using hardware security tokens supporting the WebAuthn/FIDO2 protocol, such as a YubiKey."
msgstr "YubiKey غا ئوخشاش WebAuthn / FIDO2 كېلىشىمىنى قوللايدىغان قاتتىق دېتال بىخەتەرلىك بەلگىسى ئارقىلىق دەلىللەش بىلەن تەمىنلەيدۇ."

msgid "Logout and try as another user."
msgstr "تىزىملىتىپ كىرىپ باشقا ئىشلەتكۈچى سۈپىتىدە سىناپ بېقىڭ."

msgid "Please check privileges of directory containing database."
msgstr "سانداننى ئۆز ئىچىگە ئالغان مۇندەرىجىنىڭ ئىمتىيازلىرىنى تەكشۈرۈڭ."

msgid "Details…"
msgstr "تەپسىلاتلار…"

msgid "Connection to server is disabled, please enable $cfg['AllowArbitraryServer'] in phpMyAdmin configuration."
msgstr "مۇلازىمېتىرغا ئۇلىنىش چەكلەنگەن ، phpMyAdmin سەپلىمىسىدە $ cfg ['AllowArbitraryServer'] نى قوزغىتىڭ."

msgid "Replication started successfully."
msgstr "كۆپەيتىش مۇۋەپپەقىيەتلىك باشلاندى."

msgid "Error starting replication."
msgstr "كۆپەيتىشنى باشلاشتا خاتالىق."

msgid "Replication stopped successfully."
msgstr "كۆپەيتىش مۇۋەپپەقىيەتلىك توختىدى."

msgid "Error stopping replication."
msgstr "كۆپەيتىشنى توختىتىشتا خاتالىق."

msgid "Replication resetting successfully."
msgstr "كۆپەيتىش مۇۋەپپەقىيەتلىك ئەسلىگە كەلتۈرۈلدى."

msgid "Error resetting replication."
msgstr "كۆپەيتىشنى ئەسلىگە كەلتۈرۈشتە خاتالىق."

msgid "Success."
msgstr "مۇۋەپپەقىيەت."

msgid "Unable to read primary log position. Possible privilege problem on primary."
msgstr "دەسلەپكى خاتىرە ئورنىنى ئوقۇيالمىدى. دەسلەپكى ئىمتىياز مەسىلىسى."

msgid "Unable to change primary!"
msgstr "باشلانغۇچنى ئۆزگەرتەلمىدى!"

msgid "Error 405! Request method not allowed."
msgstr "خاتالىق 405! تەلەپ قىلىش ئۇسۇلى رۇخسەت قىلىنمايدۇ."

msgid "Account locking is not supported."
msgstr "ھېسابات قۇلۇپلاشنى قوللىمايدۇ."

msgid "No privileges."
msgstr "ئىمتىياز يوق."

msgid "Includes all privileges except GRANT."
msgstr "GRANT دىن باشقا بارلىق ئىمتىيازلارنى ئۆز ئىچىگە ئالىدۇ."

msgid "Revoke"
msgstr "بىكار قىلىش"

msgid "No users selected for deleting!"
msgstr "ئۆچۈرۈش ئۈچۈن تاللانغان ئىشلەتكۈچى يوق!"

msgid "Reloading the privileges"
msgstr "ئىمتىيازنى قايتا يۈكلەش"

msgid "The selected users have been deleted successfully."
msgstr "تاللانغان ئابونتلار مۇۋەپپەقىيەتلىك ئۆچۈرۈلدى."

msgid "The privileges were reloaded successfully."
msgstr "ئىمتىيازلار مۇۋەپپەقىيەتلىك يۈكلەندى."

msgid "Note: phpMyAdmin gets the users’ privileges directly from MySQL’s privilege tables. The content of these tables may differ from the privileges the server uses, if they have been changed manually. In this case, the privileges have to be reloaded but currently, you don't have the RELOAD privilege."
msgstr "ئەسكەرتىش: phpMyAdmin ئابونتلارنىڭ ئىمتىيازىنى بىۋاسىتە MySQL نىڭ ئىمتىياز جەدۋىلىدىن ئالىدۇ. بۇ جەدۋەللەرنىڭ مەزمۇنى قولدا ئۆزگەرتىلگەن بولسا ، مۇلازىمېتىر ئىشلىتىدىغان ئىمتىيازدىن پەرقلىنىشى مۇمكىن. بۇ خىل ئەھۋالدا ، ئىمتىيازلارنى قايتا يۈكلەشكە توغرا كېلىدۇ ، ئەمما ھازىر ، سىزنىڭ RELOAD ئىمتىيازىڭىز يوق."

msgid "You have added a new user."
msgstr "يېڭى ئىشلەتكۈچى قوشتىڭىز."

msgid "A user account allowing any user from localhost to connect is present. This will prevent other users from connecting if the host part of their account allows a connection from any (%) host."
msgstr "Localhost دىكى ھەر قانداق ئىشلەتكۈچىنىڭ ئۇلىنىشىغا يول قويغان ئىشلەتكۈچى ھېساباتى بار. ئەگەر ھېساباتىنىڭ باش ئاپپاراتلىرى (%) مۇلازىمېتىردىن ئۇلىنىشقا يول قويسا ، باشقا ئىشلەتكۈچىلەرنىڭ ئۇلىنىشىنىڭ ئالدىنى ئالىدۇ."

