msgstr "Flush (ປິດ) ທຸກຕາຕະລາງ"

msgid "Show open tables"
msgstr "ສະແດງຕາຕະລາງທີ່ເປີດຢູ່"

msgid "Show replica hosts"
msgstr "ສະແດງ Replica hosts"

msgid "Show replica status"
msgstr "ສະແດງສະຖານະ Replica"

msgid "Flush query cache"
msgstr "ລ້າງແຄຊ໌ຄຳສັ່ງ"

msgid "ID"
msgstr "ID"

msgid "Command"
msgstr "ຄຳສັ່ງ"

msgid "Progress"
msgstr "ຄວາມຄືບໜ້າ"

msgid "Reading of version failed. Maybe you're offline or the upgrade server does not respond."
msgstr "ອ່ານຂໍ້ມູນເວີຊັນບໍ່ສຳເລັດ. ບາງທີທ່ານອາດຈະບໍ່ໄດ້ເຊື່ອມຕໍ່ອິນເຕີເນັດ ຫຼື ເຊີເວີອັບເກຣດບໍ່ຕອບສະໜອງ."

msgid "You are using Git version, run [kbd]git pull[/kbd] :-)[br]The latest stable version is %s, released on %s."
msgstr "ທ່ານກຳລັງໃຊ້ເວີຊັນຈາກ Git, ກະລຸນາໃຊ້ຄຳສັ່ງ [kbd]git pull[/kbd] :-)[br]ເວີຊັນທີ່ຄົງທີ່ (Stable) ໃໝ່ລ່າສຸດແມ່ນ %s, ເຜີຍແຜ່ເມື່ອ %s."

msgid "No newer stable version is available"
msgstr "ຍັງບໍ່ມີເວີຊັນໃໝ່ທີ່ຄົງທີ່ກວ່າ"

msgid "Using bookmark \"%s\" as default browse query."
msgstr "ໃຊ້ບຸກມາກ \"%s\" ເປັນຄຳສັ່ງເລີ່ມຕົ້ນໃນການເບິ່ງຂໍ້ມູນ."

msgid "Showing as PHP code"
msgstr "ສະແດງເປັນໂຄ້ດ PHP"

msgid "Current selection does not contain a unique column. Grid edit, checkbox, Edit, Copy and Delete features are not available. %s"
msgstr "ສ່ວນທີ່ເລືອກໃນຕອນນີ້ບໍ່ມີຄໍລຳທີ່ບໍ່ຊ້ຳກັນ (unique column). ຟີເຈີການແກ້ໄຂໃນຕາຕະລາງ, ກ່ອງເລືອກ, ການແກ້ໄຂ, ການສຳເນົາ ແລະ ການລຶບ ແມ່ນບໍ່ສາມາດໃຊ້ງານໄດ້. %s"

msgid "Current selection does not contain a unique column. Grid edit, Edit, Copy and Delete features may result in undesired behavior. %s"
msgstr "ສ່ວນທີ່ເລືອກໃນຕອນນີ້ບໍ່ມີຄໍລຳທີ່ບໍ່ຊ້ຳກັນ (unique column). ການແກ້ໄຂໃນຕາຕະລາງ, ການແກ້ໄຂ, ການສຳເນົາ ແລະ ການລຶບ ອາດເຮັດໃຫ້ເກີດຂໍ້ຜິດພາດທີ່ບໍ່ຕ້ອງການໄດ້. %s"

msgid "Run SQL query/queries on server “%s”"
msgstr "ປະມວນຜົນຄຳສັ່ງ SQL ໃນເຊີເວີ “%s”"

msgid "Run SQL query/queries on database %s"
msgstr "ປະມວນຜົນຄຳສັ່ງ SQL ໃນຖານຂໍ້ມູນ %s"

msgid "Run SQL query/queries on table %s"
msgstr "ປະມວນຜົນຄຳສັ່ງ SQL ໃນຕາຕະລາງ %s"

msgid "There is no detailed status information available for this storage engine."
msgstr "ບໍ່ມີຂໍ້ມູນສະຖານະລະອຽດສຳລັບເຄື່ອງຈັກຈັດເກັບຂໍ້ມູນ (Storage engine) ນີ້."

msgid "%s is available on this MySQL server."
msgstr "%s ສາມາດໃຊ້ງານໄດ້ໃນເຊີເວີ MySQL ນີ້."

msgid "%s has been disabled for this MySQL server."
msgstr "%s ຖືກປິດການໃຊ້ງານສຳລັບເຊີເວີ MySQL ນີ້."

msgid "This MySQL server does not support the %s storage engine."
msgstr "ເຊີເວີ MySQL ນີ້ບໍ່ຮອງຮັບເຄື່ອງຈັກຈັດເກັບຂໍ້ມູນ %s."

msgid "The name of the primary key must be \"PRIMARY\"!"
msgstr "ຊື່ຂອງຄີຫຼັກ (Primary key) ຕ້ອງແມ່ນ \"PRIMARY\"!"

msgid "Can't rename index to PRIMARY!"
msgstr "ບໍ່ສາມາດປ່ຽນຊື່ index ເປັນ PRIMARY ໄດ້!"

msgid "No index parts defined!"
msgstr "ບໍ່ມີການກຳນົດສ່ວນຂອງ index!"

msgid "Problems with indexes of table `%s`"
msgstr "ມີບັນຫາກັບອິນເດັກ (Indexes) ຂອງຕາຕະລາງ `%s`"

msgid "Source database `%s` was not found!"
msgstr "ບໍ່ພົບຖານຂໍ້ມູນຕົ້ນທາງ `%s`!"

msgid "Target database `%s` was not found!"
msgstr "ບໍ່ພົບຖານຂໍ້ມູນປາຍທາງ `%s`!"

msgid "Invalid database:"
msgstr "ຖານຂໍ້ມູນບໍ່ຖືກຕ້ອງ:"

msgid "Invalid table name:"
msgstr "ຊື່ຕາຕະລາງບໍ່ຖືກຕ້ອງ:"

msgid "Table %1$s has been renamed to %2$s."
msgstr "ຕາຕະລາງ %1$s ຖືກປ່ຽນຊື່ເປັນ %2$s ແລ້ວ."

msgid "Could not save table UI preferences!"
msgstr "ບໍ່ສາມາດບັນທຶກການຕັ້ງຄ່າ UI ຂອງຕາຕະລາງໄດ້!"

msgid "Failed to cleanup table UI preferences (see $cfg['Servers'][$i]['MaxTableUiprefs'] %s)"
msgstr "ລ້າງຂໍ້ມູນການຕັ້ງຄ່າ UI ຂອງຕາຕະລາງບໍ່ສຳເລັດ (ເບິ່ງ $cfg['Servers'][$i]['MaxTableUiprefs'] %s)"

msgid "Cannot save UI property \"%s\". The changes made will not be persistent after you refresh this page. Please check if the table structure has been changed."
msgstr "ບໍ່ສາມາດບັນທຶກຄຸນສົມບັດ UI \"%s\" ໄດ້. ການປ່ຽນແປງຈະບໍ່ຖືກບັນທຶກຫຼັງຈາກໂຫຼດໜ້ານີ້ໃໝ່. ກະລຸນາກວດສອບວ່າໂຄງສ້າງຕາຕະລາງມີການປ່ຽນແປງຫຼືບໍ່."

msgid "Error creating foreign key on %1$s (check data types)"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການສ້າງຄີນອກ (Foreign key) ໃນ %1$s (ກວດສອບປະເພດຂໍ້ມູນ)"

msgid "Default theme %s not found!"
msgstr "ບໍ່ພົບທີມ (Theme) ເລີ່ມຕົ້ນ %s!"

msgid "Theme %s not found!"
msgstr "ບໍ່ພົບທີມ (Theme) %s!"

msgid "No valid image path for theme %s found!"
msgstr "ບໍ່ພົບເສັ້ນທາງຮູບພາບທີ່ຖືກຕ້ອງສຳລັບທີມ (Theme) %s!"

msgid "Tracking data definition successfully deleted"
msgstr "ລຶບການຕິດຕາມການກຳນົດຂໍ້ມູນສຳເລັດແລ້ວ"

msgid "Tracking data manipulation successfully deleted"
msgstr "ລຶບການຕິດຕາມການຈັດການຂໍ້ມູນສຳເລັດແລ້ວ"

msgid "Data definition statement"
msgstr "ຄຳສັ່ງກຳນົດຂໍ້ມູນ"

msgid "Data manipulation statement"
msgstr "ຄຳສັ່ງຈັດການຂໍ້ມູນ"

msgid "Tracking statements"
msgstr "ຄຳສັ່ງການຕິດຕາມ"

msgid "Delete tracking data row from report"
msgstr "ລຶບແຖວຂໍ້ມູນການຕິດຕາມອອກຈາກລາຍງານ"

msgid "No data"
msgstr "ບໍ່ມີຂໍ້ມູນ"

msgid "Show %1$s with dates from %2$s to %3$s by user %4$s %5$s"
msgstr "ສະແດງ %1$s ດ້ວຍວັນທີຈາກ %2$s ຫາ %3$s ໂດຍຜູ້ໃຊ້ %4$s %5$s"

msgid "SQL dump (file download)"
msgstr "ດຳ SQL (ດາວໂຫຼດໄຟລ໌)"

msgid "SQL dump"
msgstr "ດຳ SQL"

msgid "This option will replace your table and contained data."
msgstr "ຕົວເລືອກນີ້ຈະຂຽນທັບຕາຕະລາງ ແລະ ຂໍ້ມູນຂອງທ່ານ."

msgid "SQL execution"
msgstr "ການປະມວນຜົນ SQL"

msgid "Export as %s"
msgstr "ສົ່ງອອກເປັນ %s"

msgid "Version %s snapshot (SQL code)"
msgstr "ພາບຖ່າຍເວີຊັນ %s (ໂຄ້ດ SQL)"

msgid "You can execute the dump by creating and using a temporary database. Please ensure that you have the privileges to do so."
msgstr "ທ່ານສາມາດປະມວນຜົນໄຟລ໌ດຳໄດ້ໂດຍການສ້າງ ແລະ ໃຊ້ຖານຂໍ້ມູນຊົ່ວຄາວ. ກະລຸນາກວດສອບວ່າທ່ານມີສິດໃນການເຮັດສິ່ງນີ້."

msgid "Comment out these two lines if you do not need them."
msgstr "ໃສ່ເຄື່ອງໝາຍຄອມເມັ້ນ (Comment) ສອງແຖວນີ້ຖ້າທ່ານບໍ່ຕ້ອງການ."

msgid "SQL statements exported. Please copy the dump or execute it."
msgstr "ສົ່ງອອກຄຳສັ່ງ SQL ແລ້ວ. ກະລຸນາສຳເນົາໄຟລ໌ດຳ ຫຼື ປະມວນຜົນມັນ."

msgid "Tracking report for table `%s`"
msgstr "ລາຍງານການຕິດຕາມສຳລັບຕາຕະລາງ `%s`"

msgid "Tracking for %1$s was activated at version %2$s."
msgstr "ການຕິດຕາມສຳລັບ %1$s ຖືກເປີດໃຊ້ງານໃນເວີຊັນ %2$s."

msgid "Tracking for %1$s was deactivated at version %2$s."
msgstr "ການຕິດຕາມສຳລັບ %1$s ຖືກປິດໃຊ້ງານໃນເວີຊັນ %2$s."

msgid "Version %1$s of %2$s was deleted."
msgstr "ເວີຊັນ %1$s ຂອງ %2$s ຖືກລຶບແລ້ວ."

msgid "Version %1$s was created, tracking for %2$s is active."
msgstr "ເວີຊັນ %1$s ຖືກສ້າງແລ້ວ, ການຕິດຕາມສຳລັບ %2$s ກຳລັງເຮັດວຽກ."

msgid "Sorry, we failed to restore the dropped trigger."
msgstr "ຂໍໂທດ, ບໍ່ສາມາດກູ້ຄືນ Trigger ທີ່ຖືກລຶບໄປໄດ້."

msgid "Trigger %1$s has been modified."
msgstr "Trigger %1$s ຖືກແກ້ໄຂແລ້ວ."

msgid "Trigger %1$s has been created."
msgstr "Trigger %1$s ຖືກສ້າງແລ້ວ."

msgid "You must provide a trigger name!"
msgstr "ທ່ານຕ້ອງລະບຸຊື່ Trigger!"

msgid "You must provide a valid timing for the trigger!"
msgstr "ທ່ານຕ້ອງລະບຸເວລາ (Timing) ທີ່ຖືກຕ້ອງໃຫ້ກັບ Trigger!"

msgid "You must provide a valid event for the trigger!"
msgstr "ທ່ານຕ້ອງລະບຸ Event ທີ່ຖືກຕ້ອງໃຫ້ກັບ Trigger!"

msgid "You must provide a valid table name!"
msgstr "ທ່ານຕ້ອງລະບຸຊື່ຕາຕະລາງທີ່ຖືກຕ້ອງ!"

msgid "You must provide a trigger definition."
msgstr "ທ່ານຕ້ອງລະບຸຄຳນິຍາມໃຫ້ກັບ Trigger."

msgid "empty"
msgstr "ຫວ່າງເປົ່າ"

msgid "not empty"
msgstr "ບໍ່ຫວ່າງເປົ່າ"

msgid "A 1-byte integer, signed range is -128 to 127, unsigned range is 0 to 255"
msgstr "ເລກຖ້ວນຂະໜາດ 1 ໄບຕ໌ (Byte), ມີເຄື່ອງໝາຍແຕ່ -128 ຫາ 127, ບໍ່ມີເຄື່ອງໝາຍແຕ່ 0 ຫາ 255"

msgid "A 2-byte integer, signed range is -32,768 to 32,767, unsigned range is 0 to 65,535"
msgstr "ເລກຖ້ວນຂະໜາດ 2 ໄບຕ໌ (Byte), ມີເຄື່ອງໝາຍແຕ່ -32,768 ຫາ 32,767, ບໍ່ມີເຄື່ອງໝາຍແຕ່ 0 ຫາ 65,535"

msgid "A 3-byte integer, signed range is -8,388,608 to 8,388,607, unsigned range is 0 to 16,777,215"
msgstr "ເລກຖ້ວນຂະໜາດ 3 ໄບຕ໌ (Byte), ມີເຄື່ອງໝາຍແຕ່ -8,388,608 ຫາ 8,388,607, ບໍ່ມີເຄື່ອງໝາຍແຕ່ 0 ຫາ 16,777,215"

msgid "A 4-byte integer, signed range is -2,147,483,648 to 2,147,483,647, unsigned range is 0 to 4,294,967,295"
msgstr "ເລກຖ້ວນຂະໜາດ 4 ໄບຕ໌ (Byte), ມີເຄື່ອງໝາຍແຕ່ -2,147,483,648 ຫາ 2,147,483,647, ບໍ່ມີເຄື່ອງໝາຍແຕ່ 0 ຫາ 4,294,967,295"

msgid "An 8-byte integer, signed range is -9,223,372,036,854,775,808 to 9,223,372,036,854,775,807, unsigned range is 0 to 18,446,744,073,709,551,615"
msgstr "ເລກຖ້ວນຂະໜາດ 8 ໄບຕ໌ (Byte), ມີເຄື່ອງໝາຍແຕ່ -9,223,372,036,854,775,808 ຫາ 9,223,372,036,854,775,807, ບໍ່ມີເຄື່ອງໝາຍແຕ່ 0 ຫາ 18,446,744,073,709,551,615"

msgid "A fixed-point number (M, D) - the maximum number of digits (M) is 65 (default 10), the maximum number of decimals (D) is 30 (default 0)"
msgstr "ເລກທົດສະນິຍົມຄົງທີ່ (M, D) - ຈຳນວນຕົວເລກສູງສຸດ (M) ແມ່ນ 65 (ຄ່າເລີ່ມຕົ້ນ 10), ຈຳນວນທົດສະນິຍົມສູງສຸດ (D) ແມ່ນ 30 (ຄ່າເລີ່ມຕົ້ນ 0)"

msgid "A small floating-point number, allowable values are -3.402823466E+38 to -1.175494351E-38, 0, and 1.175494351E-38 to 3.402823466E+38"
msgstr "ເລກທົດສະນິຍົມຂະໜາດນ້ອຍ, ຄ່າທີ່ຍອມຮັບໄດ້ແມ່ນ -3.402823466E+38 ຫາ -1.175494351E-38, 0, ແລະ 1.175494351E-38 ຫາ 3.402823466E+38"

msgid "A double-precision floating-point number, allowable values are -1.7976931348623157E+308 to -2.2250738585072014E-308, 0, and 2.2250738585072014E-308 to 1.7976931348623157E+308"
msgstr "ເລກທົດສະນິຍົມຄວາມລະອຽດສູງ (Double), ຄ່າທີ່ຍອມຮັບໄດ້ແມ່ນ -1.7976931348623157E+308 ຫາ -2.2250738585072014E-308, 0, ແລະ 2.2250738585072014E-308 ຫາ 1.7976931348623157E+308"

msgid "Synonym for DOUBLE (exception: in REAL_AS_FLOAT SQL mode it is a synonym for FLOAT)"
msgstr "ຊື່ເອີ້ນອື່ນຂອງ DOUBLE (ຍົກເວັ້ນ: ໃນໂໝດ REAL_AS_FLOAT ມັນຈະເປັນຊື່ເອີ້ນອື່ນຂອງ FLOAT)"

msgid "A bit-field type (M), storing M of bits per value (default is 1, maximum is 64)"
msgstr "ປະເພດບິດ (M), ເກັບຂໍ້ມູນ M ບິດ ຕໍ່ຄ່າ (ຄ່າເລີ່ມຕົ້ນແມ່ນ 1, ສູງສຸດແມ່ນ 64)"

msgid "A synonym for TINYINT(1), a value of zero is considered false, nonzero values are considered true"
msgstr "ຊື່ເອີ້ນອື່ນຂອງ TINYINT(1), ຄ່າສູນແມ່ນ False, ຄ່າອື່ນໆແມ່ນ True"

msgid "An alias for BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE"
msgstr "ຊື່ແທນສຳລັບ BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE"

msgid "A date, supported range is %1$s to %2$s"
msgstr "ວັນທີ, ຊ່ວງທີ່ຮອງຮັບແມ່ນ %1$s ຫາ %2$s"

msgid "A date and time combination, supported range is %1$s to %2$s"
msgstr "ວັນທີ ແລະ ເວລາ, ຊ່ວງທີ່ຮອງຮັບແມ່ນ %1$s ຫາ %2$s"

msgid "A timestamp, range is 1970-01-01 00:00:01 UTC to 2038-01-19 03:14:07 UTC on 32-bit platforms (MariaDB 11.3 and earlier), and up to 2106-02-07 06:28:15 UTC on 64-bit platforms (MariaDB 11.5 and later), stored as the number of seconds since the epoch (1970-01-01 00:00:00 UTC)"
msgstr "timestamp, ຊ່ວງແມ່ນ 1970-01-01 00:00:01 UTC ຫາ 2038-01-19 03:14:07 UTC ໃນລະບົບ 32 ບິດ (MariaDB 11.3 ແລະ ກ່ອນໜ້ານັ້ນ), ແລະ ຮອດ 2106-02-07 06:28:15 UTC ໃນລະບົບ 64 ບິດ (MariaDB 11.5 ແລະ ຫຼັງຈາກນັ້ນ), ເກັບເປັນຈຳນວນວິນາທີນັບແຕ່ epoch (1970-01-01 00:00:00 UTC)"

msgid "A time, range is %1$s to %2$s"
msgstr "ເວລາ, ຊ່ວງທີ່ຮອງຮັບແມ່ນ %1$s ຫາ %2$s"

msgid "A year in four-digit (4, default) or two-digit (2) format, the allowable values are 70 (1970) to 69 (2069) or 1901 to 2155 and 0000"
msgstr "ປີ ໃນຮູບແບບສີ່ຫຼັກ (4, ເລີ່ມຕົ້ນ) ຫຼື ສອງຫຼັກ (2), ຄ່າທີ່ຍອມຮັບໄດ້ແມ່ນ 1901 ຫາ 2155 (ຫຼື 70 ຫາ 69) ແລະ 0000"

msgid "A fixed-length (0-255, default 1) string that is always right-padded with spaces to the specified length when stored"
msgstr "ຂໍ້ຄວາມຄວາມຍາວຄົງທີ່ (0-255, ເລີ່ມຕົ້ນ 1) ເຊິ່ງຈະຖືກຕື່ມຊ່ອງວ່າງທາງຂວາໃຫ້ຄົບຕາມຄວາມຍາວທີ່ກຳນົດເມື່ອບັນທຶກ"

msgid "A variable-length (%s) string, the effective maximum length is subject to the maximum row size"
msgstr "ຂໍ້ຄວາມຄວາມຍາວບໍ່ຄົງທີ່ (%s), ຄວາມຍາວສູງສຸດແມ່ນຂຶ້ນກັບຂະໜາດສູງສຸດຂອງແຖວ"

msgid "A TEXT column with a maximum length of 255 (2^8 - 1) characters, stored with a one-byte prefix indicating the length of the value in bytes"
msgstr "ຄໍລຳ TEXT ທີ່ມີຄວາມຍາວສູງສຸດ 255 ຕົວອັກສອນ, ເກັບຂໍ້ມູນພ້ອມກັບຄຳນຳໜ້າ 1 ໄບຕ໌ ເພື່ອບອກຄວາມຍາວ"

msgid "A TEXT column with a maximum length of 65,535 (2^16 - 1) characters, stored with a two-byte prefix indicating the length of the value in bytes"
msgstr "ຄໍລຳ TEXT ທີ່ມີຄວາມຍາວສູງສຸດ 65,535 ຕົວອັກສອນ, ເກັບຂໍ້ມູນພ້ອມກັບຄຳນຳໜ້າ 2 ໄບຕ໌ ເພື່ອບອກຄວາມຍາວ"

msgid "A TEXT column with a maximum length of 16,777,215 (2^24 - 1) characters, stored with a three-byte prefix indicating the length of the value in bytes"
msgstr "ຄໍລຳ TEXT ທີ່ມີຄວາມຍາວສູງສຸດ 16,777,215 ຕົວອັກສອນ, ເກັບຂໍ້ມູນພ້ອມກັບຄຳນຳໜ້າ 3 ໄບຕ໌ ເພື່ອບອກຄວາມຍາວ"

msgid "A TEXT column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) characters, stored with a four-byte prefix indicating the length of the value in bytes"
msgstr "ຄໍລຳ TEXT ທີ່ມີຄວາມຍາວສູງສຸດ 4,294,967,295 ຕົວອັກສອນ (4GiB), ເກັບຂໍ້ມູນພ້ອມກັບຄຳນຳໜ້າ 4 ໄບຕ໌ ເພື່ອບອກຄວາມຍາວ"

msgid "Similar to the CHAR type, but stores binary byte strings rather than non-binary character strings"
msgstr "ຄ້າຍຄືກັບປະເພດ CHAR, ແຕ່ເກັບໃນຮູບແບບໄບນະລີ (Binary) ແທນຂໍ້ຄວາມປົກກະຕິ"

msgid "Similar to the VARCHAR type, but stores binary byte strings rather than non-binary character strings"
msgstr "ຄ້າຍຄືກັບປະເພດ VARCHAR, ແຕ່ເກັບໃນຮູບແບບໄບນະລີ (Binary) ແທນຂໍ້ຄວາມປົກກະຕິ"

msgid "A BLOB column with a maximum length of 255 (2^8 - 1) bytes, stored with a one-byte prefix indicating the length of the value"
msgstr "ຄໍລຳ BLOB ທີ່ມີຄວາມຍາວສູງສຸດ 255 ໄບຕ໌, ເກັບຂໍ້ມູນພ້ອມກັບຄຳນຳໜ້າ 1 ໄບຕ໌ ເພື່ອບອກຄວາມຍາວ"

msgid "A BLOB column with a maximum length of 16,777,215 (2^24 - 1) bytes, stored with a three-byte prefix indicating the length of the value"
msgstr "ຄໍລຳ BLOB ທີ່ມີຄວາມຍາວສູງສຸດ 16,777,215 ໄບຕ໌, ເກັບຂໍ້ມູນພ້ອມກັບຄຳນຳໜ້າ 3 ໄບຕ໌ ເພື່ອບອກຄວາມຍາວ"

msgid "A BLOB column with a maximum length of 65,535 (2^16 - 1) bytes, stored with a two-byte prefix indicating the length of the value"
msgstr "ຄໍລຳ BLOB ທີ່ມີຄວາມຍາວສູງສຸດ 65,535 ໄບຕ໌, ເກັບຂໍ້ມູນພ້ອມກັບຄຳນຳໜ້າ 2 ໄບຕ໌ ເພື່ອບອກຄວາມຍາວ"

msgid "A BLOB column with a maximum length of 4,294,967,295 or 4GiB (2^32 - 1) bytes, stored with a four-byte prefix indicating the length of the value"
msgstr "ຄໍລຳ BLOB ທີ່ມີຄວາມຍາວສູງສຸດ 4,294,967,295 ໄບຕ໌ (4GiB), ເກັບຂໍ້ມູນພ້ອມກັບຄຳນຳໜ້າ 4 ໄບຕ໌ ເພື່ອບອກຄວາມຍາວ"

msgid "An enumeration, chosen from the list of up to 65,535 values or the special '' error value"
msgstr "ລາຍການຕົວເລືອກ (Enum), ເລືອກໄດ້ຈາກລາຍການທີ່ມີສູງສຸດ 65,535 ຄ່າ"

msgid "A single value chosen from a set of up to 64 members"
msgstr "ຄ່າດ່ຽວທີ່ເລືອກຈາກກຸ່ມສະມາຊິກທີ່ມີໄດ້ສູງສຸດ 64 ຄ່າ"

msgid "A type that can store a geometry of any type"
msgstr "ປະເພດທີ່ສາມາດເກັບຂໍ້ມູນເລຂາຄະນິດ (Geometry) ໄດ້ທຸກຮູບແບບ"

msgid "A point in 2-dimensional space"
msgstr "ຈຸດ (Point) ໃນພື້ນທີ່ 2 ມິຕິ"

msgid "A curve with linear interpolation between points"
msgstr "ເສັ້ນໂຄ້ງ (Curve) ທີ່ມີການເຊື່ອມຕໍ່ລະຫວ່າງຈຸດ"

msgid "A polygon"
msgstr "ຮູບຫຼາຍແຈ (Polygon)"

msgid "A collection of points"
msgstr "ກຸ່ມຂອງຈຸດ (MultiPoint)"

msgid "A collection of curves with linear interpolation between points"
msgstr "ກຸ່ມຂອງເສັ້ນ (MultiLineString)"

msgid "A collection of polygons"
msgstr "ກຸ່ມຂອງຮູບຫຼາຍແຈ (MultiPolygon)"

msgid "A collection of geometry objects of any type"
msgstr "ກຸ່ມຂອງວັດຖຸເລຂາຄະນິດ (GeometryCollection)"

msgid "Stores and enables efficient access to data in JSON (JavaScript Object Notation) documents"
msgstr "ເກັບ ແລະ ຊ່ວຍໃຫ້ເຂົ້າເຖິງຂໍ້ມູນໃນຮູບແບບ JSON ໄດ້ຢ່າງມີປະສິດທິພາບ"

msgid "Intended for storage of IPv4 addresses"
msgstr "ມີໄວ້ສຳລັບເກັບຮັກສາທີ່ຢູ່ IPv4"

msgid "Intended for storage of IPv6 addresses, as well as IPv4 addresses assuming conventional mapping of IPv4 addresses into IPv6 addresses"
msgstr "ອອກແບບມາເພື່ອເກັບທີ່ຢູ່ IPv6 ແລະ IPv4 ໂດຍການປ່ຽນ IPv4 ໃຫ້ເປັນຮູບແບບ IPv6"

msgid "128-bit UUID (Universally Unique Identifier)"
msgstr "128-ບິດ UUID (Universally Unique Identifier)"

msgid "Stores vector data optimized for operations such as similarity search and machine learning applications"
msgstr "ເກັບຂໍ້ມູນ vector ທີ່ເໝາະສຳລັບການເຮັດ similarity search ແລະ ວຽກ machine learning"

msgid "Intended for storage of XML data"
msgstr "ໃຊ້ສຳລັບເກັບຂໍ້ມູນ XML"

msgctxt "numeric types"
msgid "Numeric"
msgstr "ຕົວເລກ"

msgctxt "date and time types"
msgid "Date and time"
msgstr "ວັນທີ ແລະ ເວລາ"

msgctxt "spatial types"
msgid "Spatial"
msgstr "ຂໍ້ມູນທາງພື້ນທີ່"

msgid "Password is too long!"
msgstr "ລະຫັດຜ່ານຍາວເກີນໄປ!"

msgid "The profile has been updated."
msgstr "ອັບເດດໂປຣໄຟລ໌ສຳເລັດແລ້ວ."

msgid "Max: %s%s"
msgstr "ສູງສຸດ: %s%s"

