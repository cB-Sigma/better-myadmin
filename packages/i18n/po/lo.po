msgstr "ອະນຸຍາດໃຫ້ໃຊ້ຄຳສັ່ງ SHOW CREATE VIEW."

msgid "Allows creating and dropping triggers."
msgstr "ອະນຸຍາດໃຫ້ສ້າງ ແລະ ລຶບ Trigger."

msgid "Allows deleting historical rows."
msgstr "ອະນຸຍາດໃຫ້ລຶບແຖວຂໍ້ມູນປະຫວັດ."

msgid "Global"
msgstr "Global"

msgid "Global privileges"
msgstr "ສິດລະດັບ Global"

msgid "Database-specific privileges"
msgstr "ສິດສະເພາະຖານຂໍ້ມູນ"

msgid "Allows importing data from and exporting data into files."
msgstr "ອະນຸຍາດໃຫ້ນຳເຂົ້າ ແລະ ສົ່ງອອກຂໍ້ມູນຈາກໄຟລ໌."

msgid "Allows creating new databases and tables."
msgstr "ອະນຸຍາດໃຫ້ສ້າງຖານຂໍ້ມູນ ແລະ ຕາຕະລາງໃໝ່."

msgid "Allows dropping databases and tables."
msgstr "ອະນຸຍາດໃຫ້ລຶບ (Drop) ຖານຂໍ້ມູນ ແລະ ຕາຕະລາງ."

msgid "Allows creating temporary tables."
msgstr "ອະນຸຍາດໃຫ້ສ້າງຕາຕະລາງຊົ່ວຄາວ."

msgid "Allows creating stored routines."
msgstr "ອະນຸຍາດໃຫ້ສ້າງ Stored Routines."

msgid "Allows altering and dropping stored routines."
msgstr "ອະນຸຍາດໃຫ້ແກ້ໄຂ ແລະ ລຶບ Stored Routines."

msgid "Allows executing stored routines."
msgstr "ອະນຸຍາດໃຫ້ປະມວນຜົນ Stored Routines."

msgid "Allows to set up events for the event scheduler."
msgstr "ອະນຸຍາດໃຫ້ຕັ້ງຄ່າ Event ສຳລັບ Event Scheduler."

msgid "Administration"
msgstr "ການດູແລລະບົບ"

msgid "Allows adding users and privileges without reloading the privilege tables."
msgstr "ອະນຸຍາດໃຫ້ເພີ່ມຜູ້ໃຊ້ ແລະ ສິດໄດ້ໂດຍບໍ່ຕ້ອງໂຫຼດຕາຕະລາງສິດໃໝ່."

msgid "Allows connecting, even if maximum number of connections is reached; required for most administrative operations like setting global variables or killing threads of other users."
msgstr "ອະນຸຍາດໃຫ້ເຊື່ອມຕໍ່ໄດ້ ເຖິງວ່າຈະມີການເຊື່ອມຕໍ່ເຕັມຈຳນວນແລ້ວກໍຕາມ; ຈຳເປັນສຳລັບການດຳເນີນການຂອງຜູ້ດູແລລະບົບສ່ວນໃຫຍ່ ເຊັ່ນ ການຕັ້ງຄ່າ Global Variable ຫຼື ການຢຸດ Thread ຂອງຜູ້ໃຊ້ອື່ນ."

msgid "Allows viewing processes of all users."
msgstr "ອະນຸຍາດໃຫ້ເບິ່ງ Process ຂອງຜູ້ໃຊ້ທັງໝົດ."

msgid "Allows reloading server settings and flushing the server's caches."
msgstr "ອະນຸຍາດໃຫ້ໂຫຼດການຕັ້ງຄ່າເຊີເວີໃໝ່ ແລະ ເຄລຍແຄຊ໌ (Flush) ຂອງເຊີເວີ."

msgid "Allows shutting down the server."
msgstr "ອະນຸຍາດໃຫ້ປິດ (Shutdown) ເຊີເວີ."

msgid "Gives access to the complete list of databases."
msgstr "ອະນຸຍາດໃຫ້ເຂົ້າເຖິງລາຍຊື່ຖານຂໍ້ມູນທັງໝົດ."

msgid "Allows locking tables for the current thread."
msgstr "ອະນຸຍາດໃຫ້ລັອກຕາຕະລາງສຳລັບ Thread ປັດຈຸບັນ."

msgid "Allows creating foreign key relations."
msgstr "ອະນຸຍາດໃຫ້ສ້າງຄວາມສຳພັນແບບຄີນອກ (Foreign key)."

msgid "Not used on MariaDB."
msgstr "ບໍ່ໄດ້ໃຊ້ໃນ MariaDB."

msgid "Not used for this MySQL version."
msgstr "ບໍ່ໄດ້ໃຊ້ສຳລັບ MySQL ເວີຊັນນີ້."

msgid "Allows the user to ask where the replicas / primaries are."
msgstr "ອະນຸຍາດໃຫ້ຜູ້ໃຊ້ຖາມຫາຕຳແໜ່ງຂອງ replicas / primaries."

msgid "Needed for the replication replicas."
msgstr "ຈຳເປັນສຳລັບ replication replicas."

msgid "Allows creating, dropping and renaming user accounts."
msgstr "ອະນຸຍາດໃຫ້ສ້າງ, ລຶບ ແລະ ປ່ຽນຊື່ບັນຊີຜູ້ໃຊ້."

msgid "Resource limits"
msgstr "ການຈຳກັດຊັບພະຍາກອນ"

msgid "Note: Setting these options to 0 (zero) removes the limit."
msgstr "ໝາຍເຫດ: ການຕັ້ງຄ່າເຫຼົ່ານີ້ເປັນ 0 (ສູນ) ແມ່ນການຍົກເລີກການຈຳກັດ."

msgid "Limits the number of queries the user may send to the server per hour."
msgstr "ຈຳກັດຈຳນວນ Query ທີ່ຜູ້ໃຊ້ສາມາດສົ່ງໄປຍັງເຊີເວີຕໍ່ຊົ່ວໂມງ."

msgid "Limits the number of commands that change any table or database the user may execute per hour."
msgstr "ຈຳກັດຈຳນວນຄຳສັ່ງທີ່ແກ້ໄຂຕາຕະລາງ ຫຼື ຖານຂໍ້ມູນທີ່ຜູ້ໃຊ້ສາມາດປະມວນຜົນໄດ້ຕໍ່ຊົ່ວໂມງ."

msgid "Limits the number of new connections the user may open per hour."
msgstr "ຈຳກັດຈຳນວນການເຊື່ອມຕໍ່ໃໝ່ທີ່ຜູ້ໃຊ້ສາມາດເປີດໄດ້ຕໍ່ຊົ່ວໂມງ."

msgid "Limits the number of simultaneous connections the user may have."
msgstr "ຈຳກັດຈຳນວນການເຊື່ອມຕໍ່ພ້ອມກັນທີ່ຜູ້ໃຊ້ສາມາດມີໄດ້."

msgid "Does not require SSL-encrypted connections."
msgstr "ບໍ່ຕ້ອງໃຊ້ການເຊື່ອມຕໍ່ທີ່ເຂົ້າລະຫັດ SSL."

msgid "Requires SSL-encrypted connections."
msgstr "ຕ້ອງໃຊ້ການເຊື່ອມຕໍ່ທີ່ເຂົ້າລະຫັດ SSL."

msgid "Requires a valid X509 certificate."
msgstr "ຕ້ອງໃຊ້ໃບຢັ້ງຢືນ X509 ທີ່ຖືກຕ້ອງ."

msgid "Requires that a specific cipher method be used for a connection."
msgstr "ຕ້ອງໃຊ້ວິທີການເຂົ້າລະຫັດ (Cipher) ທີ່ກຳນົດສຳລັບການເຊື່ອມຕໍ່."

msgid "Requires that a valid X509 certificate issued by this CA be presented."
msgstr "ຕ້ອງໃຊ້ໃບຢັ້ງຢືນ X509 ທີ່ຖືກຕ້ອງທີ່ອອກໂດຍ CA ນີ້."

msgid "Requires that a valid X509 certificate with this subject be presented."
msgstr "ຕ້ອງໃຊ້ໃບຢັ້ງຢືນ X509 ທີ່ຖືກຕ້ອງທີ່ມີ Subject ນີ້."

msgid "Update user privileges"
msgstr "ອັບເດດສິດທິຜູ້ໃຊ້"

msgid "User accounts overview"
msgstr "ພາບລວມບັນຊີຜູ້ໃຊ້"

msgid "User groups"
msgstr "ກຸ່ມຜູ້ໃຊ້"

msgid "The selected user was not found in the privilege table."
msgstr "ບໍ່ພົບຜູ້ໃຊ້ທີ່ເລືອກໃນຕາຕະລາງສິດການໃຊ້ງານ."

msgid "Change login information / Copy user account"
msgstr "ປ່ຽນຂໍ້ມູນການເຂົ້າສູ່ລະບົບ / ສຳເນົາບັນຊີຜູ້ໃຊ້"

msgid "Create a new user account with the same privileges and …"
msgstr "ສ້າງບັນຊີຜູ້ໃຊ້ໃໝ່ດ້ວຍສິດດຽວກັນ ແລະ …"

msgid "… keep the old one."
msgstr "… ເກັບບັນຊີເກົ່າໄວ້."

msgid "… delete the old one from the user tables."
msgstr "… ລຶບບັນຊີເກົ່າອອກຈາກຕາຕະລາງຜູ້ໃຊ້."

msgid "… revoke all active privileges from the old one and delete it afterwards."
msgstr "… ຖອນສິດທັງໝົດຂອງບັນຊີເກົ່າແລ້ວຈຶ່ງລຶບອອກ."

msgid "… delete the old one from the user tables and reload the privileges afterwards."
msgstr "… ລຶບບັນຊີເກົ່າອອກຈາກຕາຕະລາງຜູ້ໃຊ້ ແລ້ວໂຫຼດສິດໃໝ່ຫຼັງຈາກນັ້ນ."

msgid "User group"
msgstr "ກຸ່ມຜູ້ໃຊ້"

msgid "Unlock this account."
msgstr "ປົດລັອກບັນຊີນີ້."

msgid "Lock this account."
msgstr "ລັອກບັນຊີນີ້."

msgctxt "Unlock the account."
msgid "Unlock"
msgstr "ປົດລັອກ"

msgctxt "Lock the account."
msgid "Lock"
msgstr "ລັອກ"

msgid "Remove selected user accounts"
msgstr "ລຶບບັນຊີຜູ້ໃຊ້ທີ່ເລືອກ"

msgid "Revoke all active privileges from the users and delete them afterwards."
msgstr "ຍົກເລີກສິດທັງໝົດຂອງຜູ້ໃຊ້ ແລະ ລຶບພວກເຂົາອອກພາຍຫຼັງ."

msgid "Drop the databases that have the same names as the users."
msgstr "ລຶບຖານຂໍ້ມູນທີ່ມີຊື່ຄືກັບຊື່ຜູ້ໃຊ້."

msgid "Replica configuration - Change or reconfigure primary server"
msgstr "ການຕັ້ງຄ່າ Replica - ປ່ຽນ ຫຼື ຕັ້ງຄ່າເຊີເວີຫຼັກ (primary) ໃໝ່"

msgid "Make sure you have a unique server-id in your configuration file (my.cnf). If not, please add the following line into [mysqld] section:"
msgstr "ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າທ່ານມີ server-id ທີ່ບໍ່ຊ້ຳກັນໃນໄຟລ໌ກຳນົດຄ່າ (my.cnf). ຖ້າບໍ່ມີ, ໃຫ້ເພີ່ມແຖວຕໍ່ໄປນີ້ໃນພາກສ່ວນ [mysqld]:"

msgid "Host:"
msgstr "ໂຮສ (Host):"

msgid "Port:"
msgstr "ພອດ (Port):"

msgid "This server is not configured as primary in a replication process. Would you like to %sconfigure%s it?"
msgstr "ເຊີເວີນີ້ຍັງບໍ່ໄດ້ຖືກຕັ້ງຄ່າເປັນເຊີເວີຫຼັກ (Primary) ໃນຂະບວນການສຳເນົາຂໍ້ມູນ. ທ່ານຕ້ອງການ %sຕັ້ງຄ່າ%s ມັນບໍ່?"

msgid "No privileges"
msgstr "ບໍ່ມີສິດທິ"

msgid "Add replica replication user"
msgstr "ເພີ່ມຜູ້ໃຊ້ສຳລັບການສຳເນົາຂໍ້ມູນ (Replica)"

msgid "Use text field:"
msgstr "ໃຊ້ຊ່ອງປ້ອນຂໍ້ຄວາມ:"

msgid "Host"
msgstr "ໂຮສ (Host)"

msgid "Generate password:"
msgstr "ສ້າງລະຫັດຜ່ານ:"

msgid "Generate"
msgstr "ສ້າງ"

msgid "Primary configuration"
msgstr "ການຕັ້ງຄ່າເຊີເວີຫຼັກ (Primary)"

msgid "This server is not configured as a primary server in a replication process. You can choose from either replicating all databases and ignoring some of them (useful if you want to replicate a majority of the databases) or you can choose to ignore all databases by default and allow only certain databases to be replicated. Please select the mode:"
msgstr "ເຊີເວີນີ້ຍັງບໍ່ໄດ້ຖືກຕັ້ງຄ່າເປັນເຊີເວີຫຼັກ. ທ່ານສາມາດເລືອກທີ່ຈະສຳເນົາຖານຂໍ້ມູນທັງໝົດ ແລະ ລະເວັ້ນບາງອັນ, ຫຼື ລະເວັ້ນທັງໝົດ ແລະ ເລືອກສຳເນົາສະເພາະບາງຖານຂໍ້ມູນ. ກະລຸນາເລືອກໂໝດ:"

msgid "Replicate all databases; Ignore:"
msgstr "Replicate ທຸກຖານຂໍ້ມູນ; ຍົກເວັ້ນ:"

msgid "Ignore all databases; Replicate:"
msgstr "ຍົກເວັ້ນທຸກຖານຂໍ້ມູນ; Replicate ສະເພາະ:"

msgid "Please select databases:"
msgstr "ກະລຸນາເລືອກຖານຂໍ້ມູນ:"

msgid "Now, add the following lines at the end of [mysqld] section in your my.cnf and please restart the MySQL server afterwards."
msgstr "ຕອນນີ້, ໃຫ້ເພີ່ມແຖວຕໍ່ໄປນີ້ໃສ່ທ້າຍຂອງພາກສ່ວນ [mysqld] ໃນ my.cnf ຂອງທ່ານ ແລ້ວກະລຸນາເລີ່ມ MySQL ເຊີເວີໃໝ່ຫຼັງຈາກນັ້ນ."

msgid "Once you restarted MySQL server, please click on Go button. Afterwards, you should see a message informing you, that this server <strong>is</strong> configured as primary."
msgstr "ຫຼັງຈາກຣີສະຕາດເຊີເວີ MySQL ແລ້ວ, ໃຫ້ກົດປຸ່ມ Go. ທ່ານຄວນຈະເຫັນຂໍ້ຄວາມແຈ້ງວ່າເຊີເວີນີ້ <strong>ຖືກ</strong> ຕັ້ງຄ່າເປັນເຊີເວີຫຼັກແລ້ວ."

msgid "This server is configured as primary in a replication process."
msgstr "ເຊີເວີນີ້ຖືກຕັ້ງຄ່າເປັນເຊີເວີຫຼັກໃນຂະບວນການສຳເນົາຂໍ້ມູນ."

msgid "Show primary status"
msgstr "ສະແດງສະຖານະເຊີເວີຫຼັກ (primary)"

msgid "Show connected replicas"
msgstr "ສະແດງ Replica ທີ່ເຊື່ອມຕໍ່ຢູ່"

msgid "Only replicas started with the --report-host=host_name option are visible in this list."
msgstr "ສະເພາະ Replica ທີ່ເລີ່ມດ້ວຍຕົວເລືອກ --report-host=host_name ເທົ່ານັ້ນທີ່ຈະສະແດງໃນລາຍການນີ້."

msgid "Primary connection:"
msgstr "ການເຊື່ອມຕໍ່ກັບເຊີເວີຫຼັກ (Primary):"

msgid "Replica SQL Thread not running!"
msgstr "Replica SQL Thread ບໍ່ເຮັດວຽກ!"

msgid "Replica IO Thread not running!"
msgstr "Replica IO Thread ບໍ່ເຮັດວຽກ!"

msgid "Server is configured as replica in a replication process. Would you like to:"
msgstr "ເຊີເວີຖືກຕັ້ງຄ່າເປັນ Replica ໃນຂະບວນການສຳເນົາຂໍ້ມູນ. ທ່ານຕ້ອງການ:"

msgid "See replica status table"
msgstr "ເບິ່ງຕາຕະລາງສະຖານະ Replica"

msgid "Control replica:"
