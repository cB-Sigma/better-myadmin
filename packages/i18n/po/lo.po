msgid "PM"
msgstr "ແລງ"

msgctxt "AM/PM indication in time"
msgid "AM"
msgstr "ເຊົ້າ"

msgid "%s days, %s hours, %s minutes and %s seconds"
msgstr "%s ມື້, %s ຊົ່ວໂມງ, %s ນາທີ ແລະ %s ວິນາທີ"

msgid "Users"
msgstr "ຜູ້ໃຊ້"

