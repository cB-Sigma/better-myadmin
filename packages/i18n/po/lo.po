msgstr "ຕັ້ງຄ່າ log_output ເປັນ %s"

msgid "Enable %s"
msgstr "ເປີດໃຊ້ງານ %s"

msgid "Disable %s"
msgstr "ປິດໃຊ້ງານ %s"

msgid "Set long_query_time to %d seconds."
msgstr "ຕັ້ງຄ່າ long_query_time ເປັນ %d ວິນາທີ."

msgid "You can't change these variables. Please log in as root or contact your database administrator."
msgstr "ທ່ານບໍ່ສາມາດປ່ຽນຕົວປ່ຽນເຫຼົ່ານີ້ໄດ້. ກະລຸນາເຂົ້າລະບົບດ້ວຍ root ຫຼື ຕິດຕໍ່ຜູ້ດູແລລະບົບຖານຂໍ້ມູນ."

msgid "Change settings"
msgstr "ປ່ຽນການຕັ້ງຄ່າ"

msgid "Current settings"
msgstr "ການຕັ້ງຄ່າປັດຈຸບັນ"

msgid "Chart title"
msgstr "ຫົວຂໍ້ແຜນພູມ"

msgid "Differential"
msgstr "ສ່ວນຕ່າງ (Differential)"

msgid "Divided by %s"
msgstr "ຫານດ້ວຍ %s"

msgid "Unit"
msgstr "ຫົວໜ່ວຍ"

msgid "The database name is not known for this query in the server's logs."
msgstr "ບໍ່ຮູ້ຊື່ຖານຂໍ້ມູນສຳລັບການສອບຖາມນີ້ໃນບັນທຶກຂອງເຊີບເວີ."

msgid "This column shows the amount of identical queries that are grouped together. However only the SQL query itself has been used as a grouping criteria, so the other attributes of queries, such as start time, may differ."
msgstr "ຖັນນີ້ສະແດງຈຳນວນການສອບຖາມທີ່ຄືກັນເຊິ່ງຖືກຈັດກຸ່ມເຂົ້າກັນ. ແນວໃດກໍຕາມ, ມີພຽງແຕ່ຄຳສັ່ງ SQL ເທົ່ານັ້ນທີ່ໃຊ້ເປັນເກນໃນການຈັດກຸ່ມ, ດັ່ງນັ້ນຄຸນລັກສະນະອື່ນໆ ເຊັ່ນ ເວລາເລີ່ມຕົ້ນ ອາດຈະແຕກຕ່າງກັນ."

msgid "Since grouping of INSERTs queries has been selected, INSERT queries into the same table are also being grouped together, disregarding of the inserted data."
msgstr "ເນື່ອງຈາກເລືອກການຈັດກຸ່ມຄຳສັ່ງ INSERT, ຄຳສັ່ງ INSERT ໃນຕາຕະລາງດຽວກັນຈຶ່ງຖືກຈັດກຸ່ມເຂົ້າກັນ ໂດຍບໍ່ຄຳນຶງເຖິງຂໍ້ມູນທີ່ເພີ່ມເຂົ້າໄປ."

msgid "Analyzing…"
msgstr "ກຳລັງວິເຄາະ…"

msgid "Explain output"
msgstr "ອະທິບາຍຜົນອອກ (Explain output)"

msgid "Total time:"
msgstr "ເວລາທັງໝົດ:"

msgid "Profiling results"
msgstr "ຜົນການວິເຄາະປະສິດທິພາບ (Profiling)"

msgctxt "Display format"
msgid "Table"
msgstr "ຕາຕະລາງ"

msgid "Chart"
msgstr "ແຜນພູມ"

msgid "Log table filter options"
msgstr "ຕົວເລືອກການກັ່ນຕອງຕາຕະລາງບັນທຶກ"

msgid "Filter"
msgstr "ກັ່ນຕອງ"

msgid "Filter queries by word/regexp:"
msgstr "ກັ່ນຕອງການສອບຖາມດ້ວຍຄຳສັບ/regexp:"

msgid "Group queries, ignoring variable data in WHERE clauses"
msgstr "ຈັດກຸ່ມການສອບຖາມ ໂດຍບໍ່ສົນໃຈຂໍ້ມູນຕົວປ່ຽນໃນ WHERE clause"

msgid "Sum of grouped rows:"
msgstr "ຜົນລວມຂອງແຖວທີ່ຈັດກຸ່ມ:"

msgid "Affected rows:"
msgstr "ແຖວທີ່ມີຜົນກະທົບ:"

msgid "Failed parsing config file. It doesn't seem to be valid JSON code."
msgstr "ການວິເຄາະໄຟລ໌ການຕັ້ງຄ່າຫຼົ້ມເຫຼວ. ເບິ່ງຄືວ່າມັນບໍ່ແມ່ນລະຫັດ JSON ທີ່ຖືກຕ້ອງ."

msgid "Failed building chart grid with imported config. Resetting to default config…"
msgstr "ການສ້າງຕາຕະລາງແຜນພູມດ້ວຍການຕັ້ງຄ່າທີ່ນຳເຂົ້າຫຼົ້ມເຫຼວ. ກຳລັງຕັ້ງຄ່າໃໝ່ເປັນຄ່າເລີ່ມຕົ້ນ…"

msgid "Please enter a valid table name."
msgstr "ກະລຸນາປ້ອນຊື່ຕາຕະລາງທີ່ຖືກຕ້ອງ."

msgid "Please enter a valid database name."
msgstr "ກະລຸນາປ້ອນຊື່ຖານຂໍ້ມູນທີ່ຖືກຕ້ອງ."

msgid "No files available on server for import!"
msgstr "ບໍ່ມີໄຟລ໌ໃນເຊີບເວີໃຫ້ນຳເຂົ້າ!"

msgid "Formatting SQL…"
msgstr "ກຳລັງຈັດຮູບແບບ SQL…"

msgid "No parameters found!"
msgstr "ບໍ່ພົບພາຣາມິເຕີ!"

msgid "Request aborted!!"
msgstr "ການຮ້ອງຂໍຖືກຍົກເລີກ!!"

msgid "Processing request"
msgstr "ກຳລັງປະມວນຜົນການຮ້ອງຂໍ"

msgid "Request failed!!"
msgstr "ການຮ້ອງຂໍຫຼົ້ມເຫຼວ!!"

msgid "Error in processing request"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການປະມວນຜົນການຮ້ອງຂໍ"

msgid "Error code: %s"
msgstr "ລະຫັດຂໍ້ຜິດພາດ: %s"

msgid "Error text: %s"
msgstr "ຂໍ້ຄວາມຂໍ້ຜິດພາດ: %s"

msgid "It seems that the connection to server has been lost. Please check your network connectivity and server status."
msgstr "ເບິ່ງຄືວ່າການເຊື່ອມຕໍ່ກັບເຊີບເວີຂາດຫາຍໄປ. ກະລຸນາກວດສອບການເຊື່ອມຕໍ່ເຄືອຂ່າຍ ແລະ ສະຖານະຂອງເຊີບເວີ."

msgid "No accounts selected."
msgstr "ບໍ່ມີບັນຊີທີ່ຖືກເລືອກ."

msgid "Dropping column"
msgstr "ກຳລັງລຶບຖັນ"

msgid "Adding primary key"
msgstr "ກຳລັງເພີ່ມຄີຫຼັກ"

msgid "Click to dismiss this notification"
msgstr "ຄລິກເພື່ອປິດການແຈ້ງເຕືອນນີ້"

msgid "Renaming databases"
msgstr "ກຳລັງປ່ຽນຊື່ຖານຂໍ້ມູນ"

msgid "Copying database"
msgstr "ກຳລັງສຳເນົາຖານຂໍ້ມູນ"

msgid "Changing charset"
msgstr "ກຳລັງປ່ຽນຊຸດຕົວອັກສອນ (Charset)"

msgid "Failed to get real row count."
msgstr "ບໍ່ສາມາດນັບຈຳນວນແຖວທີ່ແທ້ຈິງໄດ້."

msgid "Searching"
msgstr "ກຳລັງຄົ້ນຫາ"

msgid "Hide search results"
msgstr "ເຊື່ອງຜົນການຄົ້ນຫາ"

msgid "Show search results"
msgstr "ສະແດງຜົນການຄົ້ນຫາ"

msgid "Browsing"
msgstr "ກຳລັງເບິ່ງຂໍ້ມູນ"

msgid "Deleting"
msgstr "ກຳລັງລຶບ"

msgid "Delete the matches for the %s table?"
msgstr "ລຶບຂໍ້ມູນທີ່ກົງກັນສຳລັບຕາຕະລາງ %s ຫຼືບໍ່?"

msgid "The definition of a stored function must contain a RETURN statement!"
msgstr "ຄຳນິຍາມຂອງຟັງຊັນ (Stored function) ຕ້ອງມີຄຳສັ່ງ RETURN!"

msgid "No routine is exportable. Required privileges may be lacking."
msgstr "ບໍ່ມີຣູທິນ (Routine) ໃດທີ່ສາມາດສົ່ງອອກໄດ້. ອາດຂາດສິດການໃຊ້ງານທີ່ຈຳເປັນ."

msgid "Trigger"
msgstr "ທຣິກເກີ"

msgid "Values for column %s"
msgstr "ຄ່າສຳລັບຖັນ %s"

msgid "Values for a new column"
msgstr "ຄ່າສຳລັບຖັນໃໝ່"

msgid "Enter each value in a separate field."
msgstr "ປ້ອນແຕ່ລະຄ່າລົງໃນແຕ່ລະຊ່ອງ."

msgid "Add %d value(s)"
msgstr "ເພີ່ມ %d ຄ່າ"

msgid "Note: If the file contains multiple tables, they will be combined into one."
msgstr "ໝາຍເຫດ: ຫາກໄຟລ໌ມີຫຼາຍຕາຕະລາງ, ພວກມັນຈະຖືກລວມເຂົ້າເປັນອັນດຽວ."

msgid "Hide query box"
msgstr "ເຊື່ອງກ່ອງຄຳສັ່ງ"

msgid "Show query box"
msgstr "ສະແດງກ່ອງຄຳສັ່ງ"

msgid "Edit query"
msgstr "ແກ້ໄຂຄຳສັ່ງ"

msgid "%d is not valid row number."
msgstr "%d ບໍ່ແມ່ນເລກແຖວທີ່ຖືກຕ້ອງ."

msgid "Variable %d:"
msgstr "ຕົວປ່ຽນ %d:"

msgid "Pick"
msgstr "ເລືອກ"

msgid "Column selector"
msgstr "ເຄື່ອງມືເລືອກຖັນ"

msgid "Search this list"
msgstr "ຄົ້ນຫາໃນລາຍການນີ້"

msgid "No columns in the central list. Make sure the Central columns list for database %s has columns that are not present in the current table."
msgstr "ບໍ່ມີຖັນໃນລາຍຊື່ຫຼັກ. ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າລາຍຊື່ຖັນຫຼັກສຳລັບຖານຂໍ້ມູນ %s ມີຖັນທີ່ບໍ່ມີຢູ່ໃນຕາຕະລາງປັດຈຸບັນ."

msgid "See more"
msgstr "ເບິ່ງເພີ່ມເຕີມ"

msgid "Add primary key"
msgstr "ເພີ່ມຄີຫຼັກ"

msgid "Primary key added."
msgstr "ເພີ່ມຄີຫຼັກແລ້ວ."

msgid "Taking you to next step…"
msgstr "ກຳລັງພາທ່ານໄປຂັ້ນຕອນຕໍ່ໄປ…"

msgid "The first step of normalization is complete for table '%s'."
msgstr "ຂັ້ນຕອນທຳອິດຂອງການເຮັດໃຫ້ເປັນບັນທັດຖານ (Normalization) ສຳລັບຕາຕະລາງ '%s' ສຳເລັດແລ້ວ."

msgid "End of step"
msgstr "ຈົບຂັ້ນຕອນ"

msgid "Second step of normalization (2NF)"
msgstr "ຂັ້ນຕອນທີສອງຂອງການເຮັດໃຫ້ເປັນບັນທັດຖານ (2NF)"

msgid "Done"
msgstr "ສຳເລັດແລ້ວ"

msgid "Confirm partial dependencies"
msgstr "ຢືນຢັນການຂຶ້ນຕໍ່ກັນບາງສ່ວນ (Partial dependencies)"

msgid "Selected partial dependencies are as follows:"
msgstr "ການຂຶ້ນຕໍ່ກັນບາງສ່ວນທີ່ເລືອກມີດັ່ງນີ້:"

msgid "Note: a, b -> d,f implies values of columns a and b combined together can determine values of column d and column f."
msgstr "ໝາຍເຫດ: a, b -> d, f ໝາຍຄວາມວ່າຄ່າຂອງຖັນ a ແລະ b ລວມກັນສາມາດກຳນົດຄ່າຂອງຖັນ d ແລະ ຖັນ f ໄດ້."

msgid "No partial dependencies selected!"
msgstr "ບໍ່ໄດ້ເລືອກການຂຶ້ນຕໍ່ກັນບາງສ່ວນ!"

msgid "Show me the possible partial dependencies based on data in the table"
msgstr "ສະແດງການຂຶ້ນຕໍ່ກັນບາງສ່ວນທີ່ເປັນໄປໄດ້ໂດຍອີງຕາມຂໍ້ມູນໃນຕາຕະລາງ"

msgid "Hide partial dependencies list"
msgstr "ເຊື່ອງລາຍຊື່ການຂຶ້ນຕໍ່ກັນບາງສ່ວນ"

msgid "Sit tight! It may take few seconds depending on data size and column count of the table."
msgstr "ກະລຸນາລໍຖ້າຄາວໜຶ່ງ! ອາດໃຊ້ເວລາສອງສາມວິນາທີ ຂຶ້ນກັບຂະໜາດຂໍ້ມູນ ແລະ ຈຳນວນຖັນຂອງຕາຕະລາງ."

msgid "Step"
msgstr "ຂັ້ນຕອນ"

msgid "The following actions will be performed:"
msgstr "ການດຳເນີນການຕໍ່ໄປນີ້ຈະຖືກປະຕິບັດ:"

msgid "DROP columns %s from the table %s"
msgstr "ລຶບ (DROP) ຖັນ %s ອອກຈາກຕາຕະລາງ %s"

msgid "Create the following table"
msgstr "ສ້າງຕາຕະລາງຕໍ່ໄປນີ້"

msgid "Third step of normalization (3NF)"
msgstr "ຂັ້ນຕອນທີສາມຂອງການເຮັດໃຫ້ເປັນບັນທັດຖານ (3NF)"

msgid "Confirm transitive dependencies"
msgstr "ຢືນຢັນການຂຶ້ນຕໍ່ກັນແບບສົ່ງທອດ (Transitive dependencies)"

msgid "Selected dependencies are as follows:"
msgstr "ການຂຶ້ນຕໍ່ກັນທີ່ເລືອກມີດັ່ງນີ້:"

msgid "No dependencies selected!"
msgstr "ບໍ່ໄດ້ເລືອກການຂຶ້ນຕໍ່ກັນ!"

msgid "Enter first value"
msgstr "ປ້ອນຄ່າທຳອິດ"

msgid "Enter second value"
msgstr "ປ້ອນຄ່າທີສອງ"

msgid "Hide search criteria"
msgstr "ເຊື່ອງເງື່ອນໄຂການຄົ້ນຫາ"

msgid "Show search criteria"
msgstr "ສະແດງເງື່ອນໄຂການຄົ້ນຫາ"

msgid "Column maximum:"
msgstr "ຄ່າສູງສຸດຂອງຖັນ:"

msgid "Column minimum:"
msgstr "ຄ່າຕ່ຳສຸດຂອງຖັນ:"

msgid "Hide find and replace criteria"
msgstr "ເຊື່ອງເງື່ອນໄຂການຊອກຫາ ແລະ ແທນທີ່"

msgid "Show find and replace criteria"
msgstr "ສະແດງເງື່ອນໄຂການຊອກຫາ ແລະ ແທນທີ່"

msgid "Each point represents a data row."
msgstr "ແຕ່ລະຈຸດແທນແຖວຂໍ້ມູນ."

msgid "Hovering over a point will show its label."
msgstr "ວາງເມົາສ໌ໄວ້ເທິງຈຸດເພື່ອສະແດງປ້າຍຊື່."

msgid "To zoom in, select a section of the plot with the mouse."
msgstr "ເພື່ອຊູມເຂົ້າ, ໃຫ້ເລືອກສ່ວນຂອງແຜນພູມດ້ວຍເມົາສ໌."

