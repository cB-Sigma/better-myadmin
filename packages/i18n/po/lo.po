msgid "Please enter a valid credit card number"
msgstr "ກະລຸນາປ້ອນໝາຍເລກບັດເຄຣດິດໃຫ້ຖືກຕ້ອງ"

msgid "Please enter only digits"
msgstr "ກະລຸນາປ້ອນສະເພາະຕົວເລກເທົ່ານັ້ນ"

msgid "Please enter the same value again"
msgstr "ກະລຸນາປ້ອນຄ່າເດີມອີກຄັ້ງ"

msgid "Please enter no more than {0} characters"
msgstr "ກະລຸນາປ້ອນຂໍ້ມູນບໍ່ເກີນ {0} ຕົວອັກສອນ"

msgid "Please enter at least {0} characters"
msgstr "ກະລຸນາປ້ອນຂໍ້ມູນຢ່າງໜ້ອຍ {0} ຕົວອັກສອນ"

msgid "Please enter a value between {0} and {1} characters long"
msgstr "ກະລຸນາປ້ອນຂໍ້ມູນທີ່ມີຄວາມຍາວລະຫວ່າງ {0} ຫາ {1} ຕົວອັກສອນ"

msgid "Please enter a value between {0} and {1}"
msgstr "ກະລຸນາປ້ອນຄ່າລະຫວ່າງ {0} ຫາ {1}"

msgid "Please enter a value less than or equal to {0}"
msgstr "ກະລຸນາປ້ອນຄ່າທີ່ນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ {0}"

msgid "Please enter a value greater than or equal to {0}"
msgstr "ກະລຸນາປ້ອນຄ່າທີ່ຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ {0}"

msgid "Please enter a valid date or time"
msgstr "ກະລຸນາປ້ອນວັນທີ ຫຼື ເວລາໃຫ້ຖືກຕ້ອງ"

msgid "Please enter a valid HEX input"
msgstr "ກະລຸນາປ້ອນຄ່າ HEX ໃຫ້ຖືກຕ້ອງ"

msgid "This column can not contain a 32 chars value"
msgstr "ຖັນນີ້ບໍ່ສາມາດມີຄ່າທີ່ມີຄວາມຍາວ 32 ຕົວອັກສອນໄດ້"

msgid "These functions are meant to return a binary result; to avoid inconsistent results you should store it in a BINARY, VARBINARY, or BLOB column."
msgstr "ຟັງຊັນເຫຼົ່ານີ້ຈະສົ່ງຄືນຜົນໄດ້ຮັບເປັນໄບນາຣີ; ເພື່ອຫຼີກລ່ຽງຄວາມຜິດພາດ, ທ່ານຄວນເກັບມັນໄວ້ໃນຖັນປະເພດ BINARY, VARBINARY, ຫຼື BLOB."

msgid "The file being uploaded is probably larger than the maximum allowed size."
msgstr "ໄຟລ໌ທີ່ກຳລັງອັບໂຫຼດອາດຈະໃຫຍ່ກວ່າຂະໜາດສູງສຸດທີ່ອະນຸຍາດ."

msgid "%s of %s"
msgstr "%s ຈາກ %s"

msgid "%s/sec."
msgstr "%s/ວິນາທີ."

msgid "About %MIN min. %SEC sec. remaining."
msgstr "ເຫຼືອເວລາປະມານ %MIN ນາທີ %SEC ວິນາທີ."

msgid "About %SEC sec. remaining."
msgstr "ເຫຼືອເວລາປະມານ %SEC ວິນາທີ."

msgid "The file is being processed, please be patient."
msgstr "ກຳລັງປະມວນຜົນໄຟລ໌, ກະລຸນາລໍຖ້າ."

msgid "Uploading your import file…"
msgstr "ກຳລັງອັບໂຫຼດໄຟລ໌ທີ່ຈະນຳເຂົ້າ…"

msgid "Please be patient, the file is being uploaded. Details about the upload are not available."
msgstr "ກະລຸນາລໍຖ້າ, ໄຟລ໌ກຳລັງຖືກອັບໂຫຼດ. ບໍ່ມີຂໍ້ມູນລະອຽດກ່ຽວກັບການອັບໂຫຼດໃນເວລານີ້."

msgid "Fatal error: The navigation can only be accessed via AJAX"
msgstr "ຂໍ້ຜິດພາດຮ້າຍແຮງ: ການນຳທາງ (navigation) ສາມາດເຂົ້າເຖິງໄດ້ຜ່ານ AJAX ເທົ່ານັ້ນ"

msgid "Select one…"
msgstr "ເລືອກອັນໃດອັນໜຶ່ງ…"

msgid "No such column"
msgstr "ບໍ່ມີຄໍລຳດັ່ງກ່າວ"

msgctxt "string types"
msgid "String"
msgstr "ຂໍ້ຄວາມ (String)"

