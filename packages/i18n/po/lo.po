msgstr "ແຜງຫຼັກ"

msgid "Configuration has been saved."
msgstr "ບັນທຶກການກຳນົດຄ່າແລ້ວ."

msgid "Your preferences will be saved for current session only. Storing them permanently requires %sphpMyAdmin configuration storage%s."
msgstr "ການຕັ້ງຄ່າຂອງທ່ານຈະຖືກບັນທຶກສະເພາະເຊດຊັນນີ້ເທົ່ານັ້ນ. ການບັນທຶກແບບຖາວອນຕ້ອງໃຊ້ %sບ່ອນຈັດເກັບຂໍ້ມູນການກຳນົດຄ່າຂອງ phpMyAdmin%s."

msgid "Configuration contains incorrect data for some fields."
msgstr "ການກຳນົດຄ່າມີຂໍ້ມູນທີ່ບໍ່ຖືກຕ້ອງໃນບາງຟິວ (Field)."

msgid "Do you want to import remaining settings?"
msgstr "ທ່ານຕ້ອງການນຳເຂົ້າການຕັ້ງຄ່າທີ່ເຫຼືອຫຼືບໍ່?"

msgid "Saved on: @DATE@"
msgstr "ບັນທຶກເມື່ອ: @DATE@"

msgid "Import from file"
msgstr "ນຳເຂົ້າຈາກໄຟລ໌"

msgid "Import from browser's storage"
msgstr "ນຳເຂົ້າຈາກບ່ອນຈັດເກັບຂໍ້ມູນຂອງບຣາວເຊີ"

msgid "Settings will be imported from your browser's local storage."
msgstr "ການຕັ້ງຄ່າຈະຖືກນຳເຂົ້າຈາກ Local Storage ຂອງບຣາວເຊີຂອງທ່ານ."

msgid "You have no saved settings!"
msgstr "ທ່ານບໍ່ມີການຕັ້ງຄ່າທີ່ບັນທຶກໄວ້!"

msgid "This feature is not supported by your web browser"
msgstr "ບຣາວເຊີຂອງທ່ານບໍ່ຮອງຮັບຟີເຈີນີ"

msgid "Merge with current configuration"
msgstr "ຮວມກັບການກຳນົດຄ່າປະຈຸບັນ"

msgid "You can set more settings by modifying config.inc.php, eg. by using %sSetup script%s."
msgstr "ທ່ານສາມາດຕັ້ງຄ່າເພີ່ມເຕີມໄດ້ໂດຍການແກ້ໄຂ config.inc.php, ຕົວຢ່າງ: ໂດຍການໃຊ້ %sສະຄຣິບການຕິດຕັ້ງ (Setup script)%s."

msgid "Save as JSON file"
msgstr "ບັນທຶກເປັນໄຟລ໌ JSON"

msgid "Save as PHP file"
msgstr "ບັນທຶກເປັນໄຟລ໌ PHP"

msgid "Save to browser's storage"
msgstr "ບັນທຶກໄວ້ໃນບ່ອນຈັດເກັບຂໍ້ມູນຂອງບຣາວເຊີ"

msgid "Settings will be saved in your browser's local storage."
msgstr "ການຕັ້ງຄ່າຈະຖືກບັນທຶກໄວ້ໃນ Local Storage ຂອງບຣາວເຊີຂອງທ່ານ."

msgid "Existing settings will be overwritten!"
msgstr "ການຕັ້ງຄ່າທີ່ມີຢູ່ຈະຖືກຂຽນທັບ!"

msgid "You can reset all your settings and restore them to default values."
msgstr "ທ່ານສາມາດຣີເຊັດການຕັ້ງຄ່າທັງໝົດໃຫ້ເປັນຄ່າເລີ່ມຕົ້ນໄດ້."

msgid "Configure two-factor authentication"
msgstr "ຕັ້ງຄ່າການຢືນຢັນຕົວຕົນສອງຊັ້ນ"

msgid "Enable two-factor authentication"
msgstr "ເປີດໃຊ້ການຢືນຢັນຕົວຕົນສອງຂັ້ນຕອນ"

msgid "Confirm disabling two-factor authentication"
msgstr "ຢືນຢັນການປິດໃຊ້ການຢືນຢັນຕົວຕົນສອງຊັ້ນ"

msgid "By disabling two factor authentication you will be again able to login using password only."
msgstr "ຫາກປິດໃຊ້ການຢືນຢັນຕົວຕົນສອງຊັ້ນ, ທ່ານຈະສາມາດເຂົ້າສູ່ລະບົບໂດຍໃຊ້ພຽງແຕ່ລະຫັດຜ່ານ."

msgid "Disable two-factor authentication"
msgstr "ປິດໃຊ້ການຢືນຢັນຕົວຕົນສອງຊັ້ນ"

msgid "Two-factor authentication status"
msgstr "ສະຖານະການຢືນຢັນຕົວຕົນສອງຊັ້ນ"

msgid "Two-factor authentication is not available, please install optional dependencies to enable authentication backends."
msgstr "ການຢືນຢັນຕົວຕົນສອງຊັ້ນບໍ່ພ້ອມໃຊ້ງານ, ກະລຸນາຕິດຕັ້ງ dependencies ເພີ່ມເຕີມເພື່ອເປີດໃຊ້ງານລະບົບຢືນຢັນຕົວຕົນ."

msgid "Following composer packages are missing:"
msgstr "ແພັກເກັດ composer ຕໍ່ໄປນີ້ຂາດຫາຍໄປ:"

msgid "Two-factor authentication is available and configured for this account."
msgstr "ການຢືນຢັນຕົວຕົນສອງຊັ້ນພ້ອມໃຊ້ງານ ແລະ ຖືກຕັ້ງຄ່າສຳລັບບັນຊີນີ້ແລ້ວ."

msgid "Two-factor authentication is available, but not configured for this account."
msgstr "ການຢືນຢັນຕົວຕົນສອງຊັ້ນພ້ອມໃຊ້ງານ, ແຕ່ຍັງບໍ່ໄດ້ຕັ້ງຄ່າສຳລັບບັນຊີນີ້."

msgid "Please install optional dependencies to enable more authentication backends."
msgstr "ກະລຸນາຕິດຕັ້ງ dependencies ເສີມເພື່ອເປີດໃຊ້ງານຮູບແບບການຢັ້ງຢືນຕົວຕົນເພີ່ມເຕີມ."

msgid "Two-factor authentication is not available, enable phpMyAdmin configuration storage to use it."
msgstr "ການຢືນຢັນຕົວຕົນສອງຊັ້ນບໍ່ພ້ອມໃຊ້ງານ, ກະລຸນາເປີດໃຊ້ບ່ອນຈັດເກັບຂໍ້ມູນການກຳນົດຄ່າຂອງ phpMyAdmin ເພື່ອໃຊ້ງານ."

msgid "You have enabled two factor authentication."
msgstr "ທ່ານໄດ້ເປີດໃຊ້ການຢືນຢັນຕົວຕົນສອງຊັ້ນແລ້ວ."

msgid "There are no favorite tables."
msgstr "ບໍ່ມີຕາຕະລາງທີ່ມັກ."

msgid "There are no recent tables."
msgstr "ບໍ່ມີຕາຕະລາງທີ່ໃຊ້ຫຼ້າສຸດ."

msgid "phpMyAdmin configuration storage"
msgstr "ບ່ອນເກັບການຕັ້ງຄ່າຂອງ phpMyAdmin"

msgid "Configuration of pmadb…"
msgstr "ການຕັ້ງຄ່າ pmadb…"

msgid "not OK"
msgstr "ບໍ່ປົກກະຕິ"

msgid "General relation features"
msgstr "ຄຸນສົມບັດຄວາມສຳພັນທົ່ວໄປ"

msgid "%sCreate%s a database named '%s' and setup the phpMyAdmin configuration storage there."
msgstr "%sສ້າງ%s ຖານຂໍ້ມູນທີ່ມີຊື່ວ່າ '%s' ແລະ ຕັ້ງຄ່າບ່ອນເກັບການຕັ້ງຄ່າ phpMyAdmin ຢູ່ທີ່ນັ້ນ."

msgid "%sCreate%s the phpMyAdmin configuration storage in the current database."
msgstr "%sສ້າງ%s ບ່ອນເກັບຂໍ້ມູນການກຳນົດຄ່າ phpMyAdmin ໃນຖານຂໍ້ມູນປັດຈຸບັນ."

msgid "%sCreate%s missing phpMyAdmin configuration storage tables."
msgstr "%sສ້າງ%s ຕາຕະລາງບ່ອນເກັບຂໍ້ມູນການກຳນົດຄ່າ phpMyAdmin ທີ່ຍັງຂາດຢູ່."

