msgstr "Tabel %s telah dipindahkan ke %s. Hak istimewa telah disesuaikan."

msgid "Table %s has been copied to %s. Privileges have been adjusted."
msgstr "Tabel %s telah disalin ke %s. Hak istimewa telah disesuaikan."

