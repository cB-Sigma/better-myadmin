msgid "Unable to use timezone \"%1$s\" for server %2$d. Please check your configuration setting for [em]$cfg['Servers'][%3$d]['SessionTimeZone'][/em]. phpMyAdmin is currently using the default time zone of the database server."
msgstr "Kan ikke benytte tidszonen \"%1$s\" for serveren %2$d. Tjek venligst din konfigurationsindstilling for [em]$cfg['Servers'][%3$d]['SessionTimeZone'][/em]. phpMyAdmin anvender i øjeblikket databaseserverens standardtidszone."

msgid "Failed to set configured collation connection!"
msgstr "Kunne ikke indstille den konfigurerede sorteringsforbindelse!"

