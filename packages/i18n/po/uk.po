msgstr "Глобальні права"

msgid "Database-specific privileges"
msgstr "Права, які стосуються бази даних"

msgid "Allows importing data from and exporting data into files."
msgstr "Дозволити імпорт даних з файлів, та експорт у файли."

msgid "Allows creating new databases and tables."
msgstr "Дозволяє створювати нові бази даних і таблиці."

msgid "Allows dropping databases and tables."
msgstr "Дозволяє видалення баз даних та таблиць."

msgid "Allows creating temporary tables."
msgstr "Дозволяє створювати тимчасові таблиці."

msgid "Allows creating stored routines."
msgstr "Дозволяє створення збережених процедур."

msgid "Allows altering and dropping stored routines."
msgstr "Дозволяє зміну та видалення збережених процедур."

msgid "Allows executing stored routines."
msgstr "Дозволяє виконання збережених процедур."

msgid "Allows to set up events for the event scheduler."
msgstr "Дозволяє налаштувати події планувальника подій."

msgid "Administration"
msgstr "Адміністрування"

msgid "Allows adding users and privileges without reloading the privilege tables."
msgstr "Дозволяє додавання користувачів та прав без перезавантаження таблиці прав."

msgid "Allows connecting, even if maximum number of connections is reached; required for most administrative operations like setting global variables or killing threads of other users."
msgstr "Дозволити під'єднання, навіть якщо досягнуто максимальної кількості під'єднань; обов'язково для більшості адміністративних операцій таких як встановлення глобальних змінних чи припинення процесів інших користувачів."

msgid "Allows viewing processes of all users."
msgstr "Дозволяє перегляд процесів усіх користувачів."

msgid "Allows reloading server settings and flushing the server's caches."
msgstr "Дозволити перезавантаження установок та очищення кешу сервера."

msgid "Allows shutting down the server."
msgstr "Дозволити вимкнення сервера."

msgid "Gives access to the complete list of databases."
msgstr "Надає доступ до повного списку баз даних."

msgid "Allows locking tables for the current thread."
msgstr "Дозволити блокування таблиць для біжучих потоків."

msgid "Allows creating foreign key relations."
msgstr "Дозволяє створювати відносини зовнішнього ключа."

msgid "Not used on MariaDB."
msgstr "Не використовується у MariaDB."

msgid "Not used for this MySQL version."
msgstr "Невикористовується для цієї версії MySQL."

msgid "Allows the user to ask where the replicas / primaries are."
msgstr "Надати користувачу право запитувати де є підпорядковані/головні сервери."

msgid "Needed for the replication replicas."
msgstr "Необхідно для реплікації підпорядкованого сереверу."

msgid "Allows creating, dropping and renaming user accounts."
msgstr "Дозволяє створення, видалення та перейменування облікових записів користувачів."

msgid "Resource limits"
msgstr "Обмеження ресурсів"

msgid "Note: Setting these options to 0 (zero) removes the limit."
msgstr "Примітка: Встановлення цієї опції у 0 (нуль) знімає обмеження."

msgid "Limits the number of queries the user may send to the server per hour."
msgstr "Обмежити кількість запитів, які користувач може надіслати серверу протягом години."

msgid "Limits the number of commands that change any table or database the user may execute per hour."
msgstr "Обмежити кількість команд, що вносять зміни до будь-якої таблиці чи бази даних, які користувач може виконати протягом години."

msgid "Limits the number of new connections the user may open per hour."
msgstr "Обмежити кількість нових під'єднань, які користувач може створювати протягом години."

msgid "Limits the number of simultaneous connections the user may have."
msgstr "Обмежити кількість одночасних підключень, які користувач може мати."

msgid "Does not require SSL-encrypted connections."
msgstr "Не вимагає SSL-шифрованих з'єднань."

msgid "Requires SSL-encrypted connections."
msgstr "Вимагає SSL-шифрованих з'єднань."

msgid "Requires a valid X509 certificate."
msgstr "Вимагає дійсного сертифіката X509."

msgid "Requires that a specific cipher method be used for a connection."
msgstr "Вимагає, що конкретний метод шифрування, використовувався для з'єднання."

msgid "Requires that a valid X509 certificate issued by this CA be presented."
msgstr "Потрібно, що дійсний сертифікат X509, виданий CA був представлений."

msgid "Requires that a valid X509 certificate with this subject be presented."
msgstr "Потрібно, що дійсний сертифікат X509 з цієї тематики був представлений."

msgid "Update user privileges"
msgstr "Оновити привілеї користувача"

msgid "User accounts overview"
msgstr "Огляд облікових записів користувача"

msgid "User groups"
msgstr "Групи користувачів"

