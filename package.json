{
  "name": "bettermyadmin-monorepo",
  "version": "1.0.19",
  "private": true,
  "license": "GPL-2.0-or-later",
  "description": "A modern phpMyAdmin alternative for MySQL and MariaDB, rebuilt in TypeScript and React",
  "keywords": [
    "phpmyadmin",
    "phpmyadmin-alternative",
    "mysql",
    "mariadb",
    "database",
    "database-admin",
    "sql",
    "admin-panel",
    "typescript",
    "react"
  ],
  "homepage": "https://github.com/cB-Sigma/better-myadmin",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "node apps/server/bin/bettermyadmin.mjs",
    "typecheck": "turbo run typecheck && pnpm run typecheck:tests",
    "typecheck:tests": "tsc -p tests/parity/tsconfig.json && tsc -p tests/e2e/tsconfig.json && tsc -p tests/ui-parity/tsconfig.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:watch": "vitest --project unit",
    "test:parity": "vitest run --project parity",
    "test:mariadb": "BMA_TEST_PORT=3307 vitest run --project int && BMA_PARITY_TARGET=mariadb vitest run --project parity",
    "test:e2e": "pnpm --filter @bettermyadmin/web build && playwright test -c tests/e2e/playwright.config.ts",
    "test:smoke": "pnpm build && playwright test -c tests/smoke/playwright.config.ts",
    "test:smoke:docker": "BMA_SMOKE=docker playwright test -c tests/smoke/playwright.config.ts",
    "test:ui-parity": "pnpm --filter @bettermyadmin/web build && playwright test -c tests/ui-parity/playwright.config.ts",
    "test:ui-parity:mariadb": "BMA_PARITY_TARGET=mariadb pnpm test:ui-parity",
    "i18n:import": "pnpm --filter @bettermyadmin/i18n run import",
    "i18n:parity": "pnpm --filter @bettermyadmin/i18n run parity",
    "upstream:check": "tsx tools/upstream/check.ts",
    "parity:inventory": "pnpm --filter @bettermyadmin/parity run inventory",
    "parity:report": "pnpm --filter @bettermyadmin/parity run report",
    "parity:check": "pnpm --filter @bettermyadmin/parity run check",
    "conventions:check": "tsx tools/conventions/src/cli.ts",
    "parity:baseline": "pnpm --filter @bettermyadmin/parity run baseline",
    "parity:next-id": "pnpm --silent --filter @bettermyadmin/parity run next-id"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.52.0",
    "@types/node": "22.15.3",
    "mysql2": "3.14.1",
    "tsx": "4.19.4",
    "turbo": "2.5.3",
    "typescript": "5.8.3",
    "vitest": "3.1.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/router-generator": "1.120.3",
      "@tanstack/router-utils": "1.115.0",
      "@tanstack/virtual-file-routes": "1.115.0",
      "rollup": "4.40.2"
    }
  }
}
